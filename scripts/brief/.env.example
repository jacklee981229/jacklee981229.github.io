# For `npm run brief` on the laptop: copy to scripts/brief/.env (git ignores it) and fill in. GitHub Actions has the
# same two as repository secrets.

# The key from the Console workspace made for the brief (its spend limit caps what a bad morning can cost).
ANTHROPIC_API_KEY=
# The read-only token that lets the brief fetch your scores from the Now editor (the same value as its Worker secret).
BRIEF_READ_TOKEN=
