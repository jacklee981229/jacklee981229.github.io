---
import Base from '../layouts/Base.astro';
import PageTop from '../components/PageTop.astro';
---
<Base title="Page not found">
  <script is:inline>
    // Some old tag links used capital letters (/tags/Hexo/); the new addresses are all lowercase.
    (function () {
      var path = location.pathname, lower = path.toLowerCase();
      if (lower !== path) location.replace(lower + location.search + location.hash);
    })();
  </script>
  <div class="wrap page">
    <PageTop title="Page not found" lead="This page doesn't exist. It may have moved or been removed when the blog was rebuilt." />
    <p class="home"><a class="button" href="/">Go to the home page</a></p>
  </div>
</Base>

<style>
  .home { margin: var(--space-6) 0 0; }
</style>
