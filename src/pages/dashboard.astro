  .cal :global(.cell.sel) { border-color: transparent; box-shadow: 0 0 0 2px var(--ink); }
  /* A day to see (D10) is lit from its top in its worst thing's colour, as the page's panes are; after .sel, so the
     chosen day keeps its coloured top line inside the ring. */
  .cal :global(.cell.lit) { border-top-color: color-mix(in srgb, var(--c) 70%, transparent); background: linear-gradient(180deg, color-mix(in srgb, var(--c) 30%, transparent), transparent 4.5rem), var(--dg-well); }
  .cal :global(.cell:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  @media (hover: hover) { .cal :global(.cell:not(.sel):hover) { border-color: color-mix(in srgb, var(--ink) 30%, transparent); } }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .cal :global(.cell:hover) { translate: 0 -2px; } }
  @media (prefers-reduced-motion: no-preference) { .cal :global(.cell:focus-visible) { translate: 0 -2px; } }
  .cal :global(.c-top) { display: flex; gap: var(--space-1); align-items: center; min-width: 0; }
  .cal :global(.num) { font-size: var(--text-ui); font-weight: 850; font-variant-numeric: tabular-nums; }
  .cal :global(.is-today .num) { padding: 0 var(--space-2); border-radius: var(--radius-pill); background: var(--ink); color: var(--paper); }
  /* The routine steps back (D10): the fine past's icons and the done count in the quietest grey, not faded, so the
     count keeps 4.5:1 (half opacity left it near 3:1); the done strip fades, as the count says the same. */
  .cal :global(.quiet-icons) { display: inline-flex; gap: 2px; min-width: 0; overflow: hidden; color: var(--dg-dim); }
  .cal :global(.quiet-icons .icon) { width: 14px; height: 14px; stroke-width: 2.2; }
  .cal :global(.tot) { margin-left: auto; color: var(--dg-dim); font-size: var(--text-xs); font-weight: 750; font-variant-numeric: tabular-nums; }
  /* A lit cell's light raises its ground, so its quiet marks take the lighter grey to keep 4.5:1. */
  .cal :global(.cell.lit :is(.tot, .quiet-icons)) { color: var(--muted); }
  .cal :global(.cell .pip) { display: none; }
  .cal :global(.chips) { display: grid; gap: 3px; min-width: 0; }
  /* A chip's ground is dark, not clear: its cell is lit in the same colour from the top, which would swallow it. */
  .cal :global(.chip) { display: flex; gap: var(--space-1); align-items: start; min-width: 0; padding: 1px 6px; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--c) 16%, var(--dg-ground)); color: var(--c); font-size: var(--text-xs); font-weight: 750; }
  .cal :global(.chip .icon) { width: 12px; height: 12px; margin-top: 2px; stroke-width: 2.4; }
  .cal :global(.chip span) { display: -webkit-box; min-width: 0; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-height: 1.3; overflow-wrap: normal; }
  .cal :global(.chips .more) { color: var(--muted); font-size: var(--text-xs); font-weight: 750; }
  /* A day's done things: a glowing strip, a piece a project in its kind's colour, as long as the day was busy. */
  .cal :global(.strip) { display: flex; gap: 2px; width: calc(var(--w) * 100%); height: 8px; margin-top: auto; opacity: 0.45; }
  .cal :global(.strip i) { min-width: 3px; border-radius: var(--radius-pill); background: var(--k); box-shadow: 0 0 10px -2px var(--k); }
  /* The chosen day in full, scrolling in its own box beside the month. */
  .cal :global(.cal-day) { min-width: 0; max-height: 44rem; padding: var(--space-4); overflow-y: auto; border: var(--hairline) solid var(--rule); border-radius: var(--radius-md); background: var(--dg-well); }
  @media (prefers-reduced-motion: no-preference) { .cal :global(.cal-day.opening) { animation: dash-lane-open var(--motion-soft) var(--ease-out); } }
  .cal :global(.day-head) { display: flex; gap: var(--space-3); align-items: baseline; justify-content: space-between; padding-bottom: 10px; border-bottom: var(--hairline) solid var(--rule); }
  .cal :global(.day-head h3) { margin: 0; font-size: var(--text-md); font-weight: 900; letter-spacing: -0.01em; }
  .cal :global(.day-head .rel), :global(.cal-pop .pop-head span) { color: var(--muted); font-size: var(--text-sm); font-weight: 700; white-space: nowrap; }
  /* A day's things: a disc with its icon in its tone's colour, its name, its time and project, its state. */
  .cal :global(.evs) { margin: 0; padding: var(--space-1) 0; list-style: none; }
  .cal :global(.ev) { display: grid; grid-template-columns: 30px minmax(0, 1fr) auto; gap: var(--space-3); align-items: center; padding: 10px 0; border-top: var(--hairline) solid var(--rule); }
  .cal :global(.ev:first-child) { border-top: 0; }
  :global(:is(.cal, .cal-pop) .disc) { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: color-mix(in srgb, var(--c) 18%, transparent); color: var(--c);
    box-shadow: 0 0 14px -4px color-mix(in srgb, var(--c) 80%, transparent); }
  :global(:is(.cal, .cal-pop) .disc .icon) { width: 15px; height: 15px; stroke-width: 2.2; }
  .cal :global(.ev-t) { margin: 0; font-weight: 750; overflow-wrap: anywhere; }
  .cal :global(.ev-s) { display: flex; flex-wrap: wrap; gap: 2px var(--space-2); align-items: center; margin: 2px 0 0; color: var(--muted); font-size: 0.8125rem; }
  .cal :global(.ev-w) { padding: 2px 10px; border: var(--hairline) solid color-mix(in srgb, var(--c) 45%, transparent); border-radius: var(--radius-pill); background: color-mix(in srgb, var(--c) 14%, transparent); color: var(--c);
    font-size: 0.8125rem; font-weight: 800; white-space: nowrap; }
  .cal :global(.tag) { padding: 1px var(--space-2); border-radius: var(--radius-pill); background: var(--wash); color: var(--muted); font-size: var(--text-xs); font-weight: 700; white-space: nowrap; }
  :global(:is(.cal, .cal-pop) .dsum) { display: flex; gap: 10px; align-items: baseline; margin: var(--space-3) 0 6px; font-weight: 900; }
  :global(:is(.cal, .cal-pop) .dsum span) { color: var(--muted); font-size: var(--text-ui); font-weight: 700; font-variant-numeric: tabular-nums; }
  :global(:is(.cal, .cal-pop) .kdot) { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--k); box-shadow: 0 0 8px color-mix(in srgb, var(--k) 70%, transparent); }
  .cal :global(.group) { margin-bottom: var(--space-3); }
  .cal :global(.group h3) { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); align-items: center; margin: 0 0 6px; font-size: var(--text-base); font-weight: 800; }
  .cal :global(.group h3 span) { color: var(--muted); font-size: var(--text-sm); font-weight: 650; }
  .cal :global(.module) { padding-bottom: var(--space-2); }
  .cal :global(.module h4) { margin: 0 0 var(--space-1); font-size: var(--text-sm); font-weight: 800; }
  .cal :global(.done-list) { margin: 0; padding: 0; list-style: none; }
  .cal :global(.done-list li) { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: var(--space-2); align-items: start; margin-bottom: var(--space-1); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .cal :global(.done-list .icon) { width: 14px; height: 14px; margin-top: 3px; color: var(--muted); stroke-width: 2; }
  .cal :global(.todo-done) { font-weight: 650; }
  /* The hover card: over every pane, a darker glass so its words read on any of them. */
  :global(.cal-pop) { position: fixed; z-index: 60; width: min(20rem, calc(100vw - 32px)); padding: var(--space-3) 14px; border: var(--hairline) solid var(--dg-glass-edge); border-radius: var(--radius-md);
    background: var(--dg-pop); box-shadow: inset 0 1px 0 var(--dg-glass-top), var(--dg-pop-shadow); color: var(--ink); pointer-events: none;
    backdrop-filter: blur(var(--dg-bar-blur)) saturate(150%); -webkit-backdrop-filter: blur(var(--dg-bar-blur)) saturate(150%); }
  :global(.cal-pop[hidden]) { display: none; }
  @media (prefers-reduced-motion: no-preference) { :global(.cal-pop.show) { animation: dash-pop-in var(--motion-soft) var(--ease-out); } }
  @keyframes dash-pop-in { from { opacity: 0; translate: 0 4px; } }
  :global(.cal-pop .pop-head) { display: flex; gap: var(--space-3); align-items: baseline; justify-content: space-between; padding-bottom: var(--space-2); border-bottom: var(--hairline) solid var(--rule); }
  :global(.cal-pop .pop-head b) { font-size: var(--text-base); font-weight: 900; }
  :global(.cal-pop ul) { margin: 0; padding: 2px 0 0; list-style: none; }
  :global(.cal-pop .pe) { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: var(--space-2); align-items: center; padding: 5px 0; font-size: var(--text-sm); font-weight: 700; }
  :global(.cal-pop .pe .disc) { width: 22px; height: 22px; }
  :global(.cal-pop .pe .disc .icon) { width: 12px; height: 12px; }
  :global(.cal-pop .pt) { min-width: 0; overflow-wrap: anywhere; }
  :global(.cal-pop .pw) { color: var(--c); font-size: var(--text-xs); font-weight: 800; white-space: nowrap; }
  :global(.cal-pop .dsum) { margin: 6px 0 2px; font-size: var(--text-sm); }
  :global(.cal-pop .pp) { display: flex; gap: var(--space-2); align-items: center; padding: 2px 0; font-size: 0.8125rem; font-weight: 700; }
  :global(.cal-pop .pp .kdot) { width: 8px; height: 8px; }
  :global(.cal-pop .pn) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.cal-pop .pc) { margin-left: auto; color: var(--muted); font-variant-numeric: tabular-nums; }
  :global(.cal-pop .more) { margin: 2px 0 0; color: var(--muted); font-size: var(--text-xs); font-weight: 750; }
  :global(.cal-pop .note) { margin: 0; padding: var(--space-2) 0 0; color: var(--muted); font-size: var(--text-sm); }
  /* Tones last, so they win over each piece's own colour. */
  :global(:is(.cal, .cal-pop) .t-bad) { --c: var(--dash-bad); }
  :global(:is(.cal, .cal-pop) .t-soon) { --c: var(--dash-soon); }
  :global(:is(.cal, .cal-pop) .t-plan) { --c: var(--dash-ok); }
  :global(:is(.cal, .cal-pop) .t-past) { --c: var(--dg-dim); }
  /* Growing and shrinking (resize in the script): the pane's box morphs from its place to its new one, over the panes
     it passes, quicker shrinking. Its two pictures keep their own size, pinned to its top left and cut to the box, so
     the month is uncovered as the box grows rather than stretched with it. */
  :global(::view-transition-group(dash-cal)) { z-index: 1; overflow: clip; border-radius: var(--radius-xl); }
  :global(::view-transition-old(dash-cal)), :global(::view-transition-new(dash-cal)) { width: auto; height: auto; object-fit: none; object-position: left top; inset: 0 auto auto 0; }
  :global(html.cal-shrinking::view-transition-group(*)) { animation-duration: var(--motion-soft); }

  /* Today: each to-do in a well of its own, its notes in full; the late ones first, their day in red. */
  .head { display: flex; gap: var(--space-3); align-items: baseline; justify-content: space-between; padding-bottom: var(--space-3); border-bottom: var(--hairline) solid var(--rule); }
  .head .sec-h { padding-bottom: 0; border-bottom: 0; }
  .head-date { color: var(--muted); font-size: var(--text-ui); font-weight: 700; white-space: nowrap; }
  .today-list { display: grid; gap: 10px; padding: 14px 0 var(--space-3); }
  .today :global(.td) { display: grid; gap: 6px; min-width: 0; padding: 14px var(--space-4); border: var(--hairline) solid var(--rule); border-radius: var(--radius-md); background: var(--dg-well); }
  .today :global(.td-top) { display: flex; gap: var(--space-3); align-items: baseline; justify-content: space-between; }
  .today :global(.td-t) { min-width: 0; margin: 0; font-size: 1.0625rem; font-weight: 800; overflow-wrap: anywhere; }
  .today :global(.td-n) { margin: 0; color: var(--muted); font-size: var(--text-ui); white-space: pre-wrap; overflow-wrap: anywhere; }
  .today :global(.td-foot) { display: flex; gap: var(--space-2); align-items: center; min-width: 0; }
  .today :global(.day) { color: var(--muted); font-size: var(--text-sm); font-weight: 750; white-space: nowrap; }
  .today :global(.day.late) { color: var(--todo-late); }
  .today :global(.tag), .todo :global(.tag) { min-width: 0; padding: 2px var(--space-3); border-radius: var(--radius-pill); background: var(--wash); color: var(--muted); font-size: var(--text-xs); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* Projects (A's shelves): a shelf a kind, its mark, name and count on the left; a card a project with something to
     say, its checks as glowing state pills, its week as seven small bars in the kind's colour and a state mark at its
     top right; a card in trouble lit from its top in that state's colour. The quiet projects are named in one line. */
  .projects :global(.shelf) { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: var(--space-4) var(--space-5); padding: 18px 0; border-top: var(--hairline) solid var(--rule); }
  .projects :global(.shelf:first-child) { border-top: 0; }
  .projects :global(.shelf-h) { display: flex; gap: var(--space-3); align-items: center; align-self: start; padding-top: 6px; }
  .projects :global(.shelf-h h3) { margin: 0; font-size: 1.0625rem; font-weight: 900; line-height: 1.25; }
  .projects :global(.shelf-h .n) { color: var(--muted); font-size: var(--text-sm); font-weight: 650; }
  .projects :global(.tiles) { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: var(--space-3); }
  /* Cards in a row as tall as each other, each one's week at its bottom. */
  .projects :global(.tile) { --lit: transparent; position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 14px var(--space-4);
    border: var(--hairline) solid var(--rule); border-radius: var(--radius-md); background: var(--dg-well); }
  .projects :global(.tile.lv-act) { --lit: var(--dash-bad); }
  .projects :global(.tile.lv-soon) { --lit: var(--dash-soon); }
  .projects :global(.tile.lit) { border-top-color: color-mix(in srgb, var(--lit) 70%, transparent); }
  .projects :global(.tile.lit::before) { content: ''; position: absolute; z-index: -1; inset: 0; pointer-events: none; background: linear-gradient(180deg, color-mix(in srgb, var(--lit) 30%, transparent), transparent 6rem); }
  .projects :global(.tile-h) { display: flex; gap: 10px; align-items: center; }
  .projects :global(.tile-h h4) { min-width: 0; margin: 0; overflow: hidden; font-size: var(--text-base); font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
  /* The card's state: a soft disc in the state's colour with its sign (a cross, a mark, a turning arc, a branch, a tick). */
  .projects :global(.glyph) { --c: var(--dash-ok); display: inline-grid; place-items: center; flex: none; width: 22px; height: 22px; margin-left: auto; border-radius: 50%;
    background: color-mix(in srgb, var(--c) 22%, transparent); color: var(--c); box-shadow: 0 0 12px -2px color-mix(in srgb, var(--c) 70%, transparent); }
  .projects :global(.glyph .icon) { width: 13px; height: 13px; stroke-width: 3; }
  .projects :global(.glyph.act), .projects :global(.pill.act) { --c: var(--dash-bad); }
  .projects :global(.glyph.soon), .projects :global(.pill.soon) { --c: var(--dash-soon); }
  .projects :global(.glyph.fyi), .projects :global(.pill.fyi) { --c: var(--dg-fyi); }
  .projects :global(.glyph.run), .projects :global(.pill.run) { --c: var(--muted); }
  /* A check: its name and when on the left, its state pill on the right. */
  .projects :global(.st) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0 10px; align-items: center; }
  .projects :global(.st-n) { min-width: 0; overflow: hidden; color: var(--ink); font-size: var(--text-sm); font-weight: 700; text-overflow: ellipsis; white-space: nowrap; transition: color var(--motion-quick) var(--ease-out); }
  @media (hover: hover) { .projects :global(a.st-n:hover) { color: var(--dash-ok); } }
  .projects :global(.st-w) { grid-column: 1; color: var(--muted); font-size: 0.8125rem; }
  .projects :global(.pill) { --c: var(--dash-ok); grid-row: 1 / span 2; grid-column: 2; display: inline-flex; gap: 6px; align-items: center; padding: 3px 10px; border: var(--hairline) solid color-mix(in srgb, var(--c) 45%, transparent);
    border-radius: var(--radius-pill); background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); font-size: 0.8125rem; font-weight: 800; white-space: nowrap; box-shadow: 0 0 14px -6px var(--c); }
  .projects :global(.pill .icon) { width: 13px; height: 13px; stroke-width: 2.6; }
  /* The repo row keeps its label whole; its pills wrap in the room left. */
  .projects :global(.st.repo) { grid-template-columns: auto minmax(0, 1fr); }
  .projects :global(.repo-pills) { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; grid-row: 1 / span 2; grid-column: 2; }
  .projects :global(.repo-pills .pill) { grid-row: auto; grid-column: auto; }
  .projects :global(.week) { display: flex; gap: 10px; align-items: end; margin-top: auto; padding-top: var(--space-1); }
  .projects :global(.week span) { color: var(--muted); font-size: 0.8125rem; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }
  /* Bars of one width on every card, so the days line up down a shelf. */
  .projects :global(.wk) { display: grid; grid-template-columns: repeat(7, 10px); gap: var(--space-1); align-items: end; flex: none; height: 24px; margin-right: auto; }
  .projects :global(.wk i) { height: 4px; border-radius: var(--radius-2xs); background: var(--dg-cell-off); }
  .projects :global(.wk i.on) { background: var(--k); box-shadow: 0 0 10px -2px var(--k); }
  /* The quiet ones under the cards across the shelf, each name kept on one line. */
  .projects :global(.quiet) { grid-column: 1 / -1; margin: 0; color: var(--muted); font-size: var(--text-sm); }
  .projects :global(.quiet:only-child) { padding-top: 6px; }
  .projects :global(.quiet b) { color: var(--ink); font-weight: 750; }
  .projects :global(.quiet span) { white-space: nowrap; }
  /* Running: the arc turns slowly, the page's one moving mark besides the clouds; with less motion asked for, it holds. */
  .board :global(.spin) { animation: dash-turn 1.6s linear infinite; transform-origin: 50% 50%; }
  @keyframes dash-turn { to { transform: rotate(1turn); } }
  @media (prefers-reduced-motion: reduce) { .board :global(.spin) { animation: none; } }

  /* Entrances: a card plays once, the first time it scrolls into view (.wait until then, .play after; the script).
     A project card rises in; its corner sign turns a moment, as if checking, then pops in with a ripple, a problem's
     then hopping twice and its card's light coming on; its pills' signs follow one by one down the card, and its
     week's bars grow. Reminders' ring lights day by day, then its number pops; a need's figure pops and hops; Today's
     cards rise one after another, a late one's day hopping. Every one ends where the card already was (fill
     backwards only), so the hovers below still move them. */
  .board :global(:is(.wait, .play)) { --d: calc(var(--n, 0) * var(--motion-wait-step)); --t: calc(var(--d) + var(--motion-hold)); }
  .board :global(:is(.tile, .td).wait) { opacity: 0; }
  .board :global(:is(.tile, .td, .need).play) { animation: dash-rise var(--motion-soft) var(--ease-out) var(--d) backwards; }
  .projects :global(.glyph) { position: relative; }
  .projects :global(.pill .sign) { position: relative; display: inline-grid; place-items: center; width: 13px; height: 13px; }
  /* The turning ring a sign waits in, and the ripple it pops with. */
  .projects :global(:is(.glyph, .sign)::before) { content: ''; position: absolute; inset: -3px; border: 2px solid transparent; border-top-color: var(--c); border-right-color: var(--c); border-radius: 50%; opacity: 0; pointer-events: none; }
  .projects :global(.sign::before) { inset: -2px; border-width: 1.5px; }
  .projects :global(.glyph::after) { content: ''; position: absolute; inset: 0; border-radius: 50%; box-shadow: 0 0 0 2px var(--c); opacity: 0; pointer-events: none; }
  .projects :global(.wait :is(.glyph:not(.run), .sign)::before) { opacity: 1; }
