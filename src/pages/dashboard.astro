  .reminders :global(.ring-mid b) { color: var(--c); font-size: 2.75rem; font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }
  .reminders :global(.ring-mid span) { color: var(--muted); font-size: var(--text-xs); font-weight: 650; }
  .reminders :global(.body) { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .reminders :global(.sub) { margin: 0; color: var(--muted); overflow-wrap: anywhere; }

  /* Calendar (A + C): small, the last pane on the right, a month of dates with a dot under each day that has
     something, in its worst thing's colour (red wrong, amber soon, green to come, grey only done or fine); stretched
     to end level with the left, the month sits in the middle of its pane. Big, a row of its own under the top panes:
     A's month grid with the chosen day in full beside it. Six weeks always, so changing month never jumps. */
  .cal { display: flex; flex-direction: column; scroll-margin-top: calc(var(--space-5) + 4rem); }
  .cal-top { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; justify-content: space-between; padding-bottom: var(--space-3); border-bottom: var(--hairline) solid var(--rule); }
  .cal-top .sec-h { padding-bottom: 0; border-bottom: 0; }
  .cal .range { color: var(--muted); font-size: var(--text-sm); font-weight: 700; font-variant-numeric: tabular-nums; }
  .cal.big .range { font-size: var(--text-ui); }
  .cal-nav { display: inline-flex; gap: 6px; align-items: center; }
  .cal-btn { display: inline-grid; place-items: center; min-width: 34px; height: 34px; padding: 0; border: var(--hairline) solid var(--dg-glass-edge); border-radius: var(--radius-pill); background: var(--dg-well); color: var(--ink);
    font: inherit; font-size: var(--text-sm); font-weight: 750; cursor: pointer; -webkit-tap-highlight-color: transparent;
    transition: border-color var(--motion-quick) var(--ease-out), background-color var(--motion-quick) var(--ease-out), scale var(--motion-soft) var(--ease-release); }
  .cal-btn.word { padding: 0 12px; }
  .cal-btn[hidden] { display: none; }
  .cal-btn .icon { width: 16px; height: 16px; stroke-width: 2.4; }
  .cal-btn .prev { rotate: 90deg; }
  .cal-btn .next { rotate: -90deg; }
  .cal-btn:active { scale: 0.95; transition-duration: var(--motion-press); }
  .cal-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  @media (hover: hover) { .cal-btn:hover { border-color: color-mix(in srgb, var(--ink) 32%, transparent); background-color: color-mix(in srgb, var(--ink) 6%, var(--dg-well)); } }
  .cal-body { flex: 1; display: grid; align-content: center; padding: var(--space-3) 0 var(--space-2); }
  .cal.big .cal-body { display: block; padding-top: var(--space-4); }
  .cal-gap { margin: 0; padding: var(--space-2) 0 var(--space-3); color: var(--muted); font-size: var(--text-sm); }
  .cal-gap[hidden] { display: none; }
  .cal :global(.wd) { padding-bottom: var(--space-1); color: var(--muted); font-size: var(--text-xs); font-weight: 750; text-align: center; }
  .cal :global(.mini) { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 2px 0; }
  .cal :global(.m-d) { display: grid; justify-items: center; gap: 2px; padding: 7px 0 5px; border: 0; border-radius: var(--radius-sm); background: none; color: var(--ink); font: inherit; font-size: var(--text-ui); font-weight: 750;
    font-variant-numeric: tabular-nums; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background-color var(--motion-quick) var(--ease-out); }
  .cal :global(.m-d.out) { color: var(--dg-dim); }
  .cal :global(.m-d.is-today .n) { padding: 0 7px; border-radius: var(--radius-pill); background: var(--ink); color: var(--paper); }
  .cal :global(.m-d:focus-visible) { outline: 2px solid var(--focus); outline-offset: -2px; }
  .cal :global(.m-d[aria-describedby]) { background: color-mix(in srgb, var(--ink) 9%, transparent); }
  @media (hover: hover) { .cal :global(.m-d:hover) { background: color-mix(in srgb, var(--ink) 7%, transparent); } }
  /* The wait before a day's card (--motion-hold) shows: its square fills and its dot swells until the card opens. */
  .cal :global(.m-d.waiting) { background: color-mix(in srgb, var(--ink) 13%, transparent); transition: background-color var(--motion-hold) linear; }
  .cal :global(.pip) { transition: scale var(--motion-quick) var(--ease-out); }
  @media (prefers-reduced-motion: no-preference) { .cal :global(.m-d.waiting .pip) { scale: 1.8; transition: scale var(--motion-hold) var(--ease-out); } }
  .cal :global(.pip) { width: 5px; height: 5px; border-radius: 50%; background: transparent; }
  .cal :global(.pip.bad) { background: var(--dash-bad); }
  .cal :global(.pip.soon) { background: var(--dash-soon); }
  .cal :global(.pip.plan) { background: var(--dash-ok); }
  .cal :global(.pip.past) { width: 4px; height: 4px; background: var(--dg-dim); opacity: 0.5; }
  /* A day to see (D10: what needs Jack before the routine) is tinted in its worst thing's colour, its number and dot
     too. The tint sits on a well, as a lone 20% red over the cyan cloud read grey; the hover, the wait and an open
     card mix their white into that well, twice the other days' amounts as the tint over it takes about half, so they
     show as plainly and still ease. The number is its colour lifted toward white, which keeps 4.5:1 on the tint (the
     plain colour fell to 3.5:1). A day of another month fades, as the big month's do. */
  .cal :global(.m-d.lit) { background-color: var(--dg-well); background-image: linear-gradient(color-mix(in srgb, var(--c) 28%, transparent), color-mix(in srgb, var(--c) 28%, transparent)); color: color-mix(in srgb, var(--c) 60%, var(--ink)); }
  .cal :global(.m-d.lit[aria-describedby]) { background-color: color-mix(in srgb, var(--ink) 18%, var(--dg-well)); }
  @media (hover: hover) { .cal :global(.m-d.lit:hover) { background-color: color-mix(in srgb, var(--ink) 14%, var(--dg-well)); } }
  .cal :global(.m-d.lit.waiting) { background-color: color-mix(in srgb, var(--ink) 26%, var(--dg-well)); }
  .cal :global(.m-d.lit.out) { opacity: 0.42; }
  .cal :global(.m-d.lit .pip) { width: 6px; height: 6px; background: var(--c); }
  /* The big month's cells: a well a day, lifted a little under the pointer; the chosen one ringed. */
  .cal :global(.big-wrap) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, 19rem); gap: var(--space-4); align-items: start; }
  .cal :global(.grid) { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
  .cal :global(.grid .wd) { font-size: var(--text-sm); }
  .cal :global(.cell) { position: relative; display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; min-height: 6.75rem; padding: var(--space-2); border: var(--hairline) solid var(--rule); border-radius: var(--radius-md);
    background: var(--dg-well); color: var(--ink); font: inherit; text-align: left; cursor: pointer; -webkit-tap-highlight-color: transparent;
    transition: border-color var(--motion-quick) var(--ease-out), box-shadow var(--motion-quick) var(--ease-out), translate var(--motion-soft) var(--ease-out); }
  .cal :global(.cell.out) { opacity: 0.42; }
