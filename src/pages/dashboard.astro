    .week-lanes.dragging :global(.lane:not(.lifted)), .week-lanes :global(.lane.settling) { transition: translate var(--motion-soft) var(--ease-out); }
  }
  .week-lanes :global(.day-h) { display: grid; justify-items: center; gap: var(--space-1); padding-bottom: var(--space-2); }
  .week-lanes :global(.day-h .d) { padding: 1px 10px; border-radius: var(--radius-pill); color: var(--muted); font-size: var(--text-sm); font-weight: 750; white-space: nowrap; }
  .week-lanes :global(.day-h.today .d) { background: var(--ink); color: var(--paper); }
  .week-lanes :global(.day-h.future) { color: var(--muted); }
  .week-lanes :global(.day-h .n) { font-size: var(--text-lg); font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }
  .week-lanes :global(.note.none) { grid-column: 1 / -1; border-top: var(--hairline) solid var(--rule); }
  .week-lanes :global(.lane-name) { display: flex; flex: 1; gap: 10px; align-items: center; min-width: 0; padding: var(--space-3) 6px var(--space-3) 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; -webkit-tap-highlight-color: transparent; }
