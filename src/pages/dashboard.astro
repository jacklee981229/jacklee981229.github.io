  .reminders :global(.ring-rem:first-child) { border-top: 0; }
  .reminders :global(.ring-rem.soon) { --c: var(--dash-soon); }
  .reminders :global(.ring-rem.act) { --c: var(--dash-bad); }
  .reminders :global(.ring-wrap) { position: relative; width: 136px; height: 136px; }
  .reminders :global(.ring-wrap svg) { display: block; width: 100%; height: 100%; overflow: visible; }
  .reminders :global(.ring-wrap path) { fill: none; stroke: var(--dg-cell-off); stroke-width: 7; stroke-linecap: round; }
  .reminders :global(.ring-wrap path.on) { stroke: var(--c); filter: drop-shadow(0 0 3px var(--c)); }
