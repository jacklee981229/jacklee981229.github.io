---
// Jack's dashboard: what needs him, his reminders, today's to-dos, a calendar of everything dated, his projects by
// kind, his other to-dos and what he did these two weeks, for his personal projects. It all comes from his Now editor Worker after the page loads, with the pass the palette's "/login" keeps
// (the snapshot his laptop pushes, workers/now/dashboard.js, and the to-dos, workers/now/todos.js), so the built page
// holds nothing private. The rules are src/lib/dashboard.js. Kept out of search engines and the sitemap.
// Its look is its own, apart from the site's (T8, Jack: "脱离jackspace的框架…直接全部做成渐变玻璃样式"): dark frosted
// glass over drifting colour clouds, the same in every theme (Base's `look`, tokens.css's --dg-*), with only the
// site's menu bar kept, in glass too; so its top is its own, not PageTop.
import Base from '../layouts/Base.astro';
import Switch from '../components/Switch.astro';
import { ICONS } from '../lib/icons.js';
import { flowStyle } from '../lib/flow.js';

const icons = ['phone', 'close', 'branch', 'bug', 'check', 'commit', 'chevron-down', 'grip', 'globe', 'monitor', 'mods', 'gear', 'folder', 'bang', 'arc', 'expand', 'shrink', 'list'] as const;
---
<Base title="Dashboard" description="Jack's dashboard." noindex look="dashboard">
  <div class="sky" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="wrap page">
    <header class="glass top" style={flowStyle(Astro.url.pathname)}>
      <h1 class="title">Dashboard</h1>
      <p class="lede" data-lede>Loading</p>
    </header>
    <p class="glass gate" data-gate>Loading<span class="waiting-dots" aria-hidden="true"><i></i><i></i><i></i></span></p>

    <div class="board" data-board hidden>
      <div class="lanes" data-top>
        <div class="side" data-side="left">
          <section class="glass frame needs" data-needs aria-labelledby="needs-h">
            <div class="needs-head">
              <h2 class="sec-h" id="needs-h"><span data-title>Needs you</span> <span class="count" data-count></span></h2>
              <p class="clear-line" data-clear hidden>Nothing is broken or running out.</p>
            </div>
            <div data-list></div>
          </section>
        </div>
        <div class="side" data-side="right">
          <section class="glass frame reminders" data-reminders aria-labelledby="rem-h">
            <h2 class="sec-h" id="rem-h">Reminders <span class="count" data-count></span></h2>
            <div class="rem-list" data-list></div>
          </section>
          <section class="glass frame today" data-today aria-labelledby="today-h">
            <div class="head">
              <h2 class="sec-h" id="today-h">Today <span class="count" data-count></span></h2>
              <span class="head-date" data-date></span>
            </div>
            <div class="today-list" data-list></div>
          </section>
          <section class="glass frame cal" data-cal aria-labelledby="cal-h">
            <div class="cal-top">
              <h2 class="sec-h" id="cal-h">Calendar <span class="range" data-range></span></h2>
              <div class="cal-nav">
                <button type="button" class="cal-btn" data-month="-1" aria-label="Earlier month"><svg class="icon prev" viewBox="0 0 24 24" aria-hidden="true"><use href="#di-chevron-down" /></svg></button>
                <button type="button" class="cal-btn word" data-month="0" hidden>Today</button>
                <button type="button" class="cal-btn" data-month="1" aria-label="Later month"><svg class="icon next" viewBox="0 0 24 24" aria-hidden="true"><use href="#di-chevron-down" /></svg></button>
                <button type="button" class="cal-btn" data-size aria-expanded="false" aria-label="Make it big"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#di-expand" /></svg></button>
              </div>
            </div>
            <div class="cal-body" data-cal-body></div>
            <p class="cal-gap" data-cal-gap hidden></p>
          </section>
        </div>
      </div>
      <section class="glass frame projects" data-projects aria-labelledby="projects-h">
        <h2 class="sec-h" id="projects-h">Projects <span class="count" data-count></span></h2>
        <div data-list></div>
      </section>
      <div class="lanes bottom">
        <section class="glass frame done" aria-labelledby="done-h">
          <div class="done-top">
            <h2 class="sec-h" id="done-h">Done</h2>
            <Switch name="week" label="Which week" choices={[{ value: 'this', label: 'This week' }, { value: 'last', label: 'Last week' }]} />
          </div>
          <div class="done-body">
            <div class="week-lanes" data-lanes></div>
            <p class="visually-hidden" id="grip-hint">Up and down arrows move it.</p>
            <p class="visually-hidden" aria-live="polite" data-said></p>
          </div>
        </section>
        <section class="glass frame todo" data-todo aria-labelledby="todo-h">
          <div class="todo-top">
            <h2 class="sec-h" id="todo-h">To-do <span class="count" data-count></span></h2>
            <span class="pick" data-pick hidden>
              <select data-filter aria-label="Project"></select>
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#di-chevron-down" /></svg>
            </span>
          </div>
          <div class="todo-scroll" data-edge-fade="y"><ul class="rows" data-list></ul></div>
        </section>
      </div>
    </div>
  </div>
  <svg class="sprite" aria-hidden="true" focusable="false">
    {icons.map((name) => <symbol id={`di-${name}`} viewBox="0 0 24 24" set:html={ICONS[name]} />)}
  </svg>
</Base>

<script>
  import { draftCall, draftPass } from '../lib/drafts-api';
  import { KINDS, SIGN_DAYS, attention, calendar, calendarGap, cardProjects, dayAway, dayName, dayOf, dayTone, doneCounts, doneLanes, doneModules, doneWeek, kindsOf, laneOrder, lede, monthGrid, monthName, pageLevel, projectShelves, reminderRings, shiftMonth, splitTodos, todoRows, weekColours, worst, type CalEvent, type Card, type DoneGroup, type Need, type Todo, type DoneItem } from '../lib/dashboard.js';
  import { sayWaiting } from '../lib/waiting.js';
  import { showLevel } from '../lib/dashboard-nav';
  import { newTab } from '../lib/links.js';
  import { motionMs } from '../lib/motion.js';
  import { edgeFade } from '../lib/edge-fade.js';

  const $ = <T extends Element>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
  const gate = $<HTMLElement>('[data-gate]');
  const board = $<HTMLElement>('[data-board]');
  const top = $<HTMLElement>('[data-lede]');
  const lanesTop = $<HTMLElement>('[data-top]');
  const needs = $<HTMLElement>('[data-needs]');
  const reminders = $<HTMLElement>('[data-reminders]');
  const today = $<HTMLElement>('[data-today]');
  const projects = $<HTMLElement>('[data-projects]');
  const todo = $<HTMLElement>('[data-todo]');
  const bottom = $<HTMLElement>('.lanes.bottom');
  const doneFrame = $<HTMLElement>('.frame.done');
  const left = $<HTMLElement>('[data-side="left"]');
  const right = $<HTMLElement>('[data-side="right"]');
  const lanesBox = $<HTMLElement>('[data-lanes]');
  const weekSwitch = $<HTMLElement>('.done-top .switch');
  const said = $<HTMLElement>('[data-said]');
  const pickBox = $<HTMLElement>('[data-pick]');
  const filter = $<HTMLSelectElement>('[data-filter]');
  const todoScroll = $<HTMLElement>('.todo-scroll');
  const cal = $<HTMLElement>('[data-cal]');
  const calBody = $<HTMLElement>('[data-cal-body]');
  const calRange = $<HTMLElement>('[data-range]', cal);
  const calGap = $<HTMLElement>('[data-cal-gap]');
  const calToday = $<HTMLButtonElement>('[data-month="0"]', cal);
  const calSize = $<HTMLButtonElement>('[data-size]', cal);

  let snapshot: any = null;
  let todos: Todo[] | null = null;
  let todoProjects: string[] = [];
  let todoError = '';
  let loadedAt = 0;
  let which: 'this' | 'last' = 'this';
  // The Done lane that's open (its key), and the day open in it, or '' for its whole week.
  let openLane = '';
  let openDay = '';
  // Whether nothing needs Jack (the All clear strip), as the top was last placed.
  let calm = false;
  // The calendar: big (A's month under the top panes) or small (in the right column), the month on show and the day
  // chosen in the big one; kept through the minute's redraw and a return to the tab, small on each visit (D8).
  let calBig = false;
  let calMonth = '';
  let calSel = '';
  let calData: ReturnType<typeof calendar> | null = null;

  // The order Jack dragged Done's lanes to, by project, for both weeks (laneOrder).
  // shortcut: kept in this browser only, as Jack reads the dashboard on this laptop (D11); keep it in the Worker if
  // another device should share it.
  const ORDER_KEY = 'dashboard-lane-order';
  let order: string[] = (() => {
    try {
      const saved = JSON.parse(localStorage.getItem(ORDER_KEY) ?? '[]');
      return Array.isArray(saved) ? saved.filter((p): p is string => typeof p === 'string') : [];
    } catch { return []; }
  })();
  // The projects with a lane of their own, as drawn: the ones a grip can move.
  let shown: string[] = [];
  // A lane being dragged by its grip, and where the lanes' middles were when it was picked up.
  let drag: { pointer: number, lane: HTMLElement, lanes: HTMLElement[], from: number, to: number, startY: number, mids: number[] } | null = null;

  /** An element with a class and its words, never HTML: every word here came from the laptop. */
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }
  function icon(name: string) {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('aria-hidden', 'true');
    svg.classList.add('icon');
    const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
    use.setAttribute('href', `#di-${name}`);
    svg.append(use);
    return svg;
  }
  const fill = (section: HTMLElement, count: number | null, ...nodes: Node[]) => {
    $<HTMLElement>('[data-count]', section).textContent = count === null ? '' : String(count);
    $<HTMLElement>('[data-list]', section).replaceChildren(...nodes);
  };
  // Entrances: a card plays its own once, the first time it scrolls into view (the CSS's .wait and .play). The minute's
  // redraw builds new nodes, so the played ones are remembered by key and drawn as they end; with less motion asked
  // for, nothing waits. Cards seen together start one after another (--n), a few at most.
  const played = new Set<string>();
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const watcher = new IntersectionObserver((entries) => {
    let n = 0;
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const node = entry.target as HTMLElement;
      watcher.unobserve(node);
      played.add(node.dataset.key ?? '');
      node.style.setProperty('--n', String(Math.min(n++, 5)));
      node.classList.replace('wait', 'play');
    }
  }, { threshold: 0.35 });
  function entrance(node: HTMLElement, key: string) {
    if (still.matches || played.has(key)) return node;
    node.dataset.key = key;
    node.classList.add('wait');
    watcher.observe(node);
    return node;
  }
  /** A link to a run on GitHub, in a new tab. */
  function runLink(node: HTMLAnchorElement, href: string) {
    Object.assign(node, { href, target: newTab().target, rel: newTab().rel });
    node.setAttribute('aria-describedby', 'new-tab');
    return node;
  }
  /** A kind's mark: its icon in its colour on a small glass square, softly lit by that colour; none for a project
   *  that isn't a repo (Jack, General). */
  function kindMark(key: string | undefined, big = false) {
    const kind = KINDS.find((k) => k.key === key);
    if (!kind) return [];
    const mark = el('span', `kind${big ? ' big' : ''}`);
    mark.style.setProperty('--k', `var(--dg-kind-${kind.key})`);
    mark.setAttribute('role', 'img');
    mark.setAttribute('aria-label', kind.name);
    mark.title = kind.name;
    mark.append(icon(kind.icon));
    return [mark];
  }

  function needRow(n: Need, kinds: Map<string, string>) {
    const row = el('article', `need ${n.level}`);
    const fig = el('div', 'fig-col');
    if (n.fig !== undefined) {
      fig.append(el('p', 'fig', String(n.fig)), el('p', 'unit', n.unit));
    } else fig.append(icon(n.icon ?? 'close'));
    const body = el('div', 'body');
    const head = el('div', 't-row');
    head.append(...kindMark(n.project ? kinds.get(n.project) : undefined), el('h3', 't', n.title));
    body.append(head, ...n.lines.map((line) => el('p', 'sub', line)));
    if (n.cells !== undefined) {
      const cells = el('span', 'cells');
      // The seven days of a signing; the ones left are lit, at the right end.
      for (let i = 0; i < SIGN_DAYS; i++) cells.append(el('i', i >= SIGN_DAYS - (n.cells ?? 0) ? 'on' : ''));
      body.append(cells);
    }
    if (n.err) body.append(el('p', 'err', `Error: ${n.err}`));
    if (n.link) body.append(runLink(el('a', 'go run-link', n.link.text), n.link.href));
    row.append(fig, body);
    return entrance(row, `need:${n.title}`);
  }

  /** Needs you on the left and Reminders over Today on the right; with nothing to say, Needs you shrinks to the All
   *  clear strip above both (C's) and Today takes the left. The small calendar is last on the right (D6), so it never
   *  pushes Today down; the big one is a row of its own under the top panes. Each side's last section stretches to
   *  end level with the other (the CSS). Moved only when the place changes. */
  function placeTop() {
    const mine = calBig ? [] : [cal];
    const want: [HTMLElement, HTMLElement[]][] = calm ? [[left, [today]], [right, [reminders, ...mine]]] : [[left, [needs]], [right, [reminders, today, ...mine]]];
    if (calm && needs.nextElementSibling !== lanesTop) board.insertBefore(needs, lanesTop);
    // Only the panes out of place move: a pane taken out and put back plays its entrance again (the calendar growing
    // would replay Reminders' ring).
    for (const [side, sections] of want) {
      sections.forEach((s, i) => { if (side.children[i] !== s) side.insertBefore(s, side.children[i] ?? null); });
    }
    if (calBig && lanesTop.nextElementSibling !== cal) lanesTop.after(cal);
  }

  function drawNeeds(now: number) {
    const list = attention(snapshot, now);
    calm = !list.length;
    needs.className = `glass frame needs lv-${worst(list)}${calm ? ' strip' : ''}`;
    // The menu's Dashboard link: this colour, or amber for a to-do past its day.
    showLevel(pageLevel(snapshot, todos, now));
    $<HTMLElement>('[data-title]', needs).textContent = calm ? 'All clear' : 'Needs you';
    $<HTMLElement>('[data-clear]', needs).hidden = !calm;
    const kinds = kindsOf(snapshot);
    fill(needs, calm ? null : list.length, ...list.map((n) => needRow(n, kinds)));
    placeTop();
  }

  /** A ring of the signing's seven days, from the top clockwise, the days left lit (B's). */
  function ring(lit: number) {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 100 100');
    svg.setAttribute('aria-hidden', 'true');
    const point = (deg: number) => [50 + 44 * Math.cos(((deg - 90) * Math.PI) / 180), 50 + 44 * Math.sin(((deg - 90) * Math.PI) / 180)].map((v) => v.toFixed(2)).join(' ');
    const step = 360 / SIGN_DAYS;
    for (let i = 0; i < SIGN_DAYS; i++) {
      const arc = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      // A small gap between the days: each arc starts and ends 4.5 degrees in from its share.
      arc.setAttribute('d', `M ${point(i * step + 4.5)} A 44 44 0 0 1 ${point((i + 1) * step - 4.5)}`);
      if (i < lit) arc.classList.add('on');
      arc.style.setProperty('--i', String(i));
      svg.append(arc);
    }
    return svg;
  }

  function drawReminders(now: number) {
    const rings = reminderRings(snapshot, now);
    const level = rings.some((r) => r.level === 'act') ? 'act' : rings.some((r) => r.level === 'soon') ? 'soon' : 'ok';
    reminders.className = `glass frame reminders${rings.length ? ` lv-${level}` : ''}`;
    if (!rings.length) return fill(reminders, null, el('p', 'note', snapshot.sideload?.error ?? 'Nothing to re-sign.'));
    const kinds = kindsOf(snapshot);
    fill(reminders, rings.length, ...rings.map((r) => {
      const row = el('article', `ring-rem ${r.level}`);
      const wrap = el('div', 'ring-wrap');
      const mid = el('div', 'ring-mid');
      mid.append(el('b', '', String(r.left)), el('span', '', r.left === 1 ? 'day left' : 'days left'));
      wrap.append(ring(r.lit), mid);
      const body = el('div', 'body');
      const head = el('div', 't-row');
      head.append(...kindMark(kinds.get(r.project)), el('h3', 't', r.title));
      body.append(head, el('p', 'sub', r.runsOut), el('p', 'sub', r.signed));
      row.append(wrap, body);
      return entrance(row, `ring:${r.app}`);
    }));
  }

  /** Today: each to-do whose day has come in a well of its own, its notes in full, its kind and project; the late
   *  ones first, their day in red. */
  function drawToday(now: number) {
    $<HTMLElement>('[data-date]', today).textContent = dayName(dayOf(now));
    if (!todos) return fill(today, null, el('p', 'note', todoError || "Couldn't get the to-dos."));
    const rows = splitTodos(todos, snapshot.reminders ?? [], dayOf(now)).today;
    if (!rows.length) return fill(today, 0, el('p', 'note', 'Nothing for today.'));
    const kinds = kindsOf(snapshot);
    fill(today, rows.length, ...rows.map((t) => {
      const card = el('article', `td${t.day.kind === 'late' ? ' late' : ''}`);
      const head = el('div', 'td-top');
      head.append(el('h3', 'td-t', t.text), el('span', `day ${t.day.kind === 'late' ? 'late' : ''}`, t.day.text));
      const foot = el('div', 'td-foot');
      foot.append(...kindMark(kinds.get(t.project)), el('span', 'tag', t.project));
      card.append(head, ...(t.notes ? [el('p', 'td-n', t.notes)] : []), foot);
      return entrance(card, `td:${t.project}:${t.text}`);
    }));
  }

  const MARKS = { act: 'close', soon: 'bang', run: 'arc', fyi: 'branch', ok: 'check' } as const;
  const SAYS = { act: 'Needs you', soon: 'Soon', run: 'Running', fyi: 'Not committed or pushed', ok: 'Fine' } as const;
  /** A card's state in its top corner: a soft disc in the state's colour with its sign. */
  function glyph(state: Card['state']) {
    const mark = el('span', `glyph ${state}`);
    mark.setAttribute('role', 'img');
    mark.setAttribute('aria-label', SAYS[state]);
    const sign = icon(MARKS[state]);
    if (state === 'run') sign.classList.add('spin');
    mark.append(sign);
    return mark;
  }
  /** A check's state as a glowing pill: Passed, Running, Failed, days left, with the card's sign for that state (a
   *  tick, a mark, a cross) in a slot that turns before the sign pops in, on the card's entrance. */
  function pill(state: Card['state'], word: string, sign = '') {
    const node = el('span', `pill ${state}`);
    if (state === 'run') {
      const turning = icon('arc');
      turning.classList.add('spin');
      node.append(turning);
    } else {
      const slot = el('span', 'sign');
      slot.append(icon(sign || MARKS[state]));
      node.append(slot);
    }
    node.append(word);
    return node;
  }
  /** This week's done things a day, Monday to Sunday, as seven small bars in the kind's colour. */
  function weekBars(week: number[]) {
    const bars = el('span', 'wk');
    bars.setAttribute('aria-hidden', 'true');
    const most = Math.max(1, ...week);
    for (const [i, n] of week.entries()) {
      const bar = el('i', n ? 'on' : '');
      // A done day grows from 6px to 24px with what was done; a day with none is a flat dash.
      if (n) bar.style.height = `${6 + 18 * (n / most)}px`;
      bar.style.setProperty('--i', String(i));
      bars.append(bar);
    }
    return bars;
  }
  function tile(card: Card) {
    const lit = card.state === 'act' || card.state === 'soon';
    const node = el('article', `tile${lit ? ` lit lv-${card.state}` : ''}`);
    node.style.setProperty('--k', `var(--dg-kind-${card.kind})`);
    const head = el('div', 'tile-h');
    head.append(el('h4', '', card.name), glyph(card.state));
    node.append(head);
    for (const check of card.checks) {
      const row = el('div', 'st');
      row.append(check.href ? runLink(el('a', 'st-n go', check.name), check.href) : el('span', 'st-n', check.name), pill(check.state, check.word));
      if (check.when) row.append(el('span', 'st-w', check.when));
      node.append(row);
    }
    if (card.repo.length) {
      const row = el('div', 'st repo');
      const facts = el('span', 'repo-pills');
      facts.append(...card.repo.map((fact) => pill('fyi', fact, 'branch')));
      row.append(el('span', 'st-n', 'Repo'), facts);
      node.append(row);
    }
    const week = el('div', 'week');
    week.append(weekBars(card.week), el('span', '', `${card.done} this week`));
    if (card.todos) week.append(el('span', '', card.todos === 1 ? '1 to-do' : `${card.todos} to-dos`));
    node.append(week);
    // The pills' signs pop one after another down the card, after the corner's.
    node.querySelectorAll<HTMLElement>('.pill').forEach((p, i) => p.style.setProperty('--at', String(i + 1)));
    return entrance(node, `tile:${card.name}`);
  }

  /** Projects (A's shelves): a shelf a kind, its mark, name and count on the left, a card for each project with
   *  something to say, the quiet ones named in one line. */
  function drawProjects(now: number) {
    const own = todos ? splitTodos(todos, snapshot.reminders ?? [], dayOf(now)).own : null;
    const shelves = projectShelves(snapshot, own, now);
    if (!shelves.length) return fill(projects, null, el('p', 'note', snapshot.repos?.error ?? 'No projects yet.'));
    fill(projects, shelves.reduce((sum, s) => sum + s.count, 0), ...shelves.map((shelf) => {
      const row = el('div', 'shelf');
      const head = el('div', 'shelf-h');
      const words = el('div');
      words.append(el('h3', '', shelf.name), el('span', 'n', shelf.count === 1 ? '1 project' : `${shelf.count} projects`));
      head.append(...kindMark(shelf.key, true), words);
      const tiles = el('div', 'tiles');
      tiles.append(...shelf.cards.map(tile));
      if (shelf.quiet.length) {
        const quiet = el('p', 'quiet');
        quiet.append(el('b', '', `${shelf.quiet.length} quiet:`), ' ', ...shelf.quiet.flatMap((name, i) => [...(i ? [', '] : []), el('span', '', name)]));
        tiles.append(quiet);
      }
      row.append(head, tiles);
      return row;
    }));
  }

  /** The project filter, as the desktop widget's: All projects, then each project with an open to-do here in the
   *  widget's order (A-Z, General last), as the laptop sent them. */
  function drawFilter(projects: string[]) {
    if (!projects.includes(filter.value)) filter.value = '';
    pickBox.hidden = !projects.length;
    // Built again only when the projects change, so the minute's redraw can't shut a list that's open.
    if (filter.dataset.projects === projects.join('\n')) return;
    const keep = filter.value;
    filter.replaceChildren(new Option('All projects', ''), ...projects.map((p) => new Option(p, p)));
    filter.value = keep;
    filter.dataset.projects = projects.join('\n');
  }

  /** To-do: the open to-dos not in Today or Reminders; the filter picks a project among these only. */
  function drawTodos(now: number) {
    if (!todos) {
      pickBox.hidden = true;
      return fill(todo, null, el('li', 'note', todoError || "Couldn't get the to-dos."));
    }
    const rest = splitTodos(todos, snapshot.reminders ?? [], dayOf(now)).rest;
    drawFilter(todoProjects.filter((p) => rest.some((t) => t.project === p)));
    const shown = filter.value ? rest.filter((t) => t.project === filter.value) : rest;
    const rows = todoRows(shown, dayOf(now));
    if (!rows.length) return fill(todo, 0, el('li', 'note', 'Nothing else to do.'));
    fill(todo, rows.length, ...rows.map((r) => {
      const li = el('li');
      li.append(el('span', 'what', r.text), el('span', `day ${r.day?.kind === 'late' ? 'late' : ''}`, r.day?.text ?? ''));
      // One project's list needs no tag on every row, as in the widget.
      if (!filter.value) li.append(el('span', 'tag', r.project));
      return li;
    }));
  }

  /** Some done things under a heading with what they hold, by module (doneModules): each module's name over its
   *  ticked to-dos, then commits; each with its project where they come from several. */
  function doneGroup(title: string, items: DoneItem[], withProject: boolean) {
    const section = el('section', 'group');
    const h = el('h3', '', title);
    h.append(...doneCounts(items).map((c) => el('span', '', c)));
    const modules = el('div', 'modules');
    const groups = doneModules(items);
    for (const module of groups) {
      const box = el('div', 'module');
      const list = el('ul', 'done-list');
      for (const item of module.items) {
        const li = el('li');
        const words = el('span', item.kind === 'todo' ? 'todo-done' : '', item.text);
        if (withProject) words.append(' ', el('span', 'from', item.project));
        li.append(icon(item.kind === 'todo' ? 'check' : 'commit'), words);
        list.append(li);
      }
      // The things without a module are "Other" after the modules; on their own they need no heading.
      if (groups.length > 1 || module.name) box.append(el('h4', '', module.name || 'Other'));
      box.append(list);
      modules.append(box);
    }
    section.append(h, modules);
    return section;
  }

  /** Done: the week across, a lane a project down, a glowing pill a day that grows with what was done. A pill opens
   *  that day's things under its lane, a lane's name its whole week; the same again closes it. */
  function drawDone(now: number) {
    const items: DoneItem[] = snapshot.done?.items ?? [];
    weekSwitch.hidden = !!snapshot.done?.error;
    if (snapshot.done?.error) return lanesBox.replaceChildren(el('p', 'note', snapshot.done.error));
    const days = doneWeek(items, which, now);
    const lanes = doneLanes(days, order);
    shown = lanes.filter((l) => l.key !== 'more').map((l) => l.projects[0]);
    // Colours go to the lanes on show, so no two share one, and a project has the same one in both weeks.
    const own = (week: 'this' | 'last') => doneLanes(doneWeek(items, week, now)).filter((l) => l.key !== 'more').map((l) => l.projects[0]);
    const colours = weekColours(own('this'), own('last'));
    const opened = lanes.find((l) => l.key === openLane);
    const at = days.findIndex((d) => d.day === openDay);
    // A newer snapshot can take away what was open.
    if (!opened || (openDay && !opened.days[at]?.length)) openLane = openDay = '';
    // A lane's colour is its project's; the lane the smaller projects share is a quiet grey, the least of the lanes.
    const tint = (node: HTMLElement, projects: string[]) => {
      if (projects.length === 1) node.style.setProperty('--c', `var(--dash-project-${colours.get(projects[0])})`);
      else node.classList.add('shared');
    };
    // One thing is a round pill; the week's fullest day in any lane fills its day.
    const most = Math.max(1, ...lanes.flatMap((l) => l.days.map((list) => list.length)));

    const nodes: Node[] = [el('span', 'corner')];
    for (const d of days) {
      const head = el('div', `day-h${d.today ? ' today' : ''}${d.future ? ' future' : ''}`);
      head.append(el('span', 'd', d.label), el('span', 'n', d.future ? '' : String(d.items.length)));
      nodes.push(head);
    }
    if (!lanes.length) nodes.push(el('p', 'note none', 'Nothing that week.'));
    for (const lane of lanes) {
      const row = el('div', 'lane');
      row.dataset.key = lane.key;
      const head = el('div', 'lane-head');
      // A grip on each project's lane; the shared lane has none and stays last.
      if (lane.key === 'more') head.append(el('span', 'grip'));
      else {
        const grip = el('button', 'grip');
        grip.type = 'button';
        grip.dataset.grip = lane.projects[0];
        grip.setAttribute('aria-label', `Move ${lane.name}`);
        grip.setAttribute('aria-describedby', 'grip-hint');
        grip.append(icon('grip'));
        head.append(grip);
      }
      const name = el('button', 'lane-name');
      name.type = 'button';
      name.dataset.lane = lane.key;
      name.setAttribute('aria-expanded', String(openLane === lane.key && !openDay));
      tint(name, lane.projects);
      name.append(el('i', 'dot'), el('span', 'label', lane.name), el('span', 'n', String(lane.total)));
      head.append(name);
      row.append(head);
      lane.days.forEach((list, i) => {
        const cell = el('div', `cell${days[i].today ? ' today' : ''}`);
        if (list.length) {
          const pill = el('button', 'pill', String(list.length));
          pill.type = 'button';
          pill.dataset.lane = lane.key;
          pill.dataset.day = days[i].day;
          pill.setAttribute('aria-expanded', String(openLane === lane.key && openDay === days[i].day));
          pill.setAttribute('aria-label', `${lane.name}, ${days[i].label}: ${doneCounts(list).join(', ')}`);
          pill.style.setProperty('--f', String((list.length - 1) / Math.max(1, most - 1)));
          tint(pill, lane.projects);
          cell.append(pill);
        }
        row.append(cell);
      });
      if (openLane === lane.key) {
        const open = el('div', 'lane-open');
        const several = lane.projects.length > 1;
        open.append(...(openDay
          ? [doneGroup(days[at].label, lane.days[at], several)]
          : days.flatMap((d, i) => (lane.days[i].length ? [doneGroup(d.label, lane.days[i], several)] : []))));
        row.append(open);
      }
      nodes.push(row);
    }
    lanesBox.replaceChildren(...nodes);
  }

  // The calendar (A + C, D5): a small month whose days' dots say what's on them, a hover card a day, and A's big
  // month with the chosen day in full beside it.
  const TONE_SAYS = { bad: 'something wrong', soon: 'something soon', plan: 'something to come', past: 'things done' } as const;
  const hm = (ms: number) => new Date(ms + 8 * 3600_000).toISOString().slice(11, 16);
  const eventsOn = (day: string): CalEvent[] => calData?.events.get(day) ?? [];
  const doneOn = (day: string): DoneGroup[] => calData?.done.get(day) ?? [];
  const doneTotal = (day: string) => doneOn(day).reduce((sum, g) => sum + g.items.length, 0);
  /** A kind's dot, in Projects' colour for it (not Done's project colours: a month holds more projects than a week). */
  function kindDot(kind: string) {
    const dot = el('i', 'kdot');
    dot.style.setProperty('--k', `var(--dg-kind-${kind})`);
    return dot;
  }
  function disc(e: CalEvent) {
    const node = el('span', 'disc');
    node.append(icon(e.icon));
    return node;
  }
  const unkept = (day: string) => !!calData?.since && day < calData.since;
  /** A day with nothing: before Done's first day nothing was kept, ahead nothing is planned. */
  function nothing(day: string, today: string) {
    return el('p', 'note', unkept(day) ? 'Nothing kept this far back.' : day > today ? 'Nothing planned.' : 'Nothing on this day.');
  }
  /** A day before Done's first one that has other things still says its done things weren't kept, so it doesn't
   *  read as a day with nothing done. */
  const doneUnkept = (day: string) => (unkept(day) && !doneOn(day).length ? [el('p', 'note', 'Done: nothing kept this far back.')] : []);

  /** A day with something Jack should see (to come, soon or wrong) is lit in its worst one's colour (D10); a day of
   *  only the fine past or done things stays quiet. */
  const lit = (tone: string) => (tone && tone !== 'past' ? ` lit t-${tone}` : '');

  /** The small month (C's): a button a day, its dot in the colour of its worst thing, a day to see lit in it. */
  function smallMonth(today: string) {
    const grid = el('div', 'mini');
    for (const w of ['M', 'T', 'W', 'T', 'F', 'S', 'S']) grid.append(el('span', 'wd', w));
    for (const day of monthGrid(calMonth)) {
      const tone = dayTone(eventsOn(day), doneOn(day));
      const button = el('button', `m-d${day.slice(0, 7) !== calMonth ? ' out' : ''}${day === today ? ' is-today' : ''}${lit(tone)}`);
      button.type = 'button';
      button.dataset.mini = day;
      button.setAttribute('aria-label', `${dayName(day)}${tone ? `: ${TONE_SAYS[tone]}` : ''}`);
      if (day === today) button.setAttribute('aria-current', 'date');
      button.append(el('span', 'n', String(Number(day.slice(8)))), el('i', `pip ${tone}`));
      grid.append(button);
    }
    return grid;
  }

  /** The big month (A's): a cell a day, the things to come and the problems as chips in their colours, the cell lit
   *  from its top in the worst one's; the fine past ones as grey icons by the date, the done things as a glowing strip
   *  in their kinds' colours, longer the more was done, with the count at the top right, all stepping back; the
   *  chosen day in full beside it (under it on a phone). */
  function bigMonth(today: string) {
    const wrap = el('div', 'big-wrap');
    const grid = el('div', 'grid');
    for (const w of ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']) grid.append(el('span', 'wd', w));
    const days = monthGrid(calMonth);
    const most = Math.max(1, ...days.map(doneTotal));
    for (const day of days) {
      const events = eventsOn(day);
      const loud = events.filter((e) => e.tone !== 'past');
      const total = doneTotal(day);
      const tone = dayTone(events, doneOn(day));
      const cell = el('button', `cell${day.slice(0, 7) !== calMonth ? ' out' : ''}${day === today ? ' is-today' : ''}${day === calSel ? ' sel' : ''}${lit(tone)}`);
      cell.type = 'button';
      cell.dataset.cell = day;
      cell.setAttribute('aria-pressed', String(day === calSel));
      cell.setAttribute('aria-label', dayName(day));
      if (day === today) cell.setAttribute('aria-current', 'date');
      const top = el('span', 'c-top');
      const quiet = el('span', 'quiet-icons');
      quiet.append(...events.filter((e) => e.tone === 'past').map((e) => icon(e.icon)));
      top.append(el('span', 'num', String(Number(day.slice(8)))), quiet, ...(total ? [el('span', 'tot', String(total))] : []));
      // On a phone the cell keeps only its date and the small month's dot.
      top.append(el('i', `pip ${tone}`));
      const chips = el('span', 'chips');
      for (const e of loud.slice(0, 2)) {
        const chip = el('span', `chip t-${e.tone}`);
        chip.append(icon(e.icon), el('span', '', e.title));
        chips.append(chip);
      }
      if (loud.length > 2) chips.append(el('span', 'more', `+${loud.length - 2} more`));
      cell.append(top, chips);
      if (total) {
        const strip = el('span', 'strip');
        strip.style.setProperty('--w', Math.max(0.16, total / most).toFixed(3));
        for (const g of doneOn(day)) {
          const bit = el('i');
          bit.style.setProperty('--k', `var(--dg-kind-${g.kind})`);
          bit.style.flexGrow = String(g.items.length);
          strip.append(bit);
        }
        cell.append(strip);
      }
      grid.append(cell);
    }
    const panel = el('aside', 'cal-day');
    panel.dataset.edgeFade = 'y';
    panel.dataset.day = calSel;
    panel.setAttribute('aria-live', 'polite');
    panel.append(...dayInFull(calSel, today));
    wrap.append(grid, panel);
    return wrap;
  }

  /** A day in full: its things, then what was done, a group a project, the busiest first, each by module as Done's
   *  open lanes are (doneGroup). */
  function dayInFull(day: string, today: string): Node[] {
    const head = el('div', 'day-head');
    head.append(el('h3', '', dayName(day)), el('span', 'rel', dayAway(day, today)));
    const events = eventsOn(day);
    const groups = doneOn(day);
    if (!events.length && !groups.length) return [head, nothing(day, today)];
    const out: Node[] = [head];
    if (events.length) {
      const list = el('ul', 'evs');
      for (const e of events) {
        const row = el('li', `ev t-${e.tone}`);
        const words = el('div');
        const sub = el('p', 'ev-s');
        sub.append(el('span', '', e.at === null ? 'Any time' : hm(e.at)), ...(e.project ? [el('span', 'tag', e.project)] : []));
        words.append(el('p', 'ev-t', e.title), sub);
        row.append(disc(e), words, el('span', 'ev-w', e.word));
        list.append(row);
      }
      out.push(list, ...doneUnkept(day));
    }
    if (groups.length) {
      const sum = el('p', 'dsum', 'Done');
      sum.append(el('span', '', String(doneTotal(day))));
      out.push(sum);
      for (const g of groups) {
        const group = doneGroup(g.project, g.items, false);
        group.querySelector('h3')?.prepend(kindDot(g.kind));
        out.push(group);
      }
    }
    return out;
  }

  function drawCalendar(now: number) {
    const today = dayOf(now);
    if (!calMonth) {
      calMonth = today.slice(0, 7);
      calSel = today;
    }
    calData = calendar(snapshot, todos ? splitTodos(todos, snapshot.reminders ?? [], today).own : null, now);
    const focused = document.activeElement instanceof HTMLElement && calBody.contains(document.activeElement) ? document.activeElement.dataset.mini ?? document.activeElement.dataset.cell : undefined;
    cal.classList.toggle('big', calBig);
    calRange.textContent = monthName(calMonth);
    calToday.hidden = !calBig;
    calSize.setAttribute('aria-expanded', String(calBig));
    calSize.setAttribute('aria-label', calBig ? 'Make it small' : 'Make it big');
    calSize.replaceChildren(icon(calBig ? 'shrink' : 'expand'));
    // The minute's redraw keeps the chosen day's list where it was scrolled to; another day starts at its top.
    const old = calBody.querySelector<HTMLElement>('.cal-day');
    const scrolled = old?.dataset.day === calSel ? old.scrollTop : 0;
    calBody.replaceChildren(calBig ? bigMonth(today) : smallMonth(today));
    const panel = calBody.querySelector<HTMLElement>('.cal-day');
    if (panel) {
      panel.scrollTop = scrolled;
      edgeFade(panel, 'y');
    }
    const gap = calendarGap(calData.unread);
    calGap.hidden = !gap;
    calGap.textContent = gap;
    if (focused) calBody.querySelector<HTMLElement>(`[data-mini="${focused}"], [data-cell="${focused}"]`)?.focus({ preventScroll: true });
    // A card that was open stays open on its day, with what it holds now.
    if (card.day && !calBig) placeCard(card.day, false);
    else if (calBig) hideCard();
  }

  // The hover card, as a wiki link's: it opens once the pointer has rested on a day for --motion-hold (D9), then
  // follows the pointer from day to day at once, and goes when it leaves the days. A keyboard focus opens it at
  // once; a touch, with no hover, opens it with a tap, and a second tap on that day makes the month big (D7). It sits
  // outside every pane, which would cut it off.
  const pop = el('div', 'cal-pop');
  pop.id = 'cal-pop';
  pop.setAttribute('role', 'tooltip');
  pop.hidden = true;
  document.body.append(pop);
  const HOLD = motionMs(document.documentElement, '--motion-hold', 800);
  // A short grace on leaving a day, so crossing the gap to the next one doesn't close the card.
  const LEAVE = motionMs(document.documentElement, '--motion-quick', 160);
  const card = { day: '', waiting: '', openTimer: 0, closeTimer: 0 };
  let lastPointer = 'mouse';
  const phone = matchMedia('(max-width: 719px)');
  /** The day being rested on shows its wait (the CSS's .waiting), until its card opens or the pointer leaves. */
  function markWaiting(day: string) {
    for (const b of calBody.querySelectorAll('.m-d.waiting')) b.classList.remove('waiting');
    if (day) calBody.querySelector(`[data-mini="${day}"]`)?.classList.add('waiting');
  }

  function cardContent(day: string, today: string): Node[] {
    const head = el('div', 'pop-head');
    head.append(el('b', '', dayName(day)), el('span', '', dayAway(day, today)));
    const events = eventsOn(day);
    const groups = doneOn(day);
    if (!events.length && !groups.length) return [head, nothing(day, today)];
    const out: Node[] = [head];
    if (events.length) {
      const list = el('ul');
      for (const e of events) {
        const row = el('li', `pe t-${e.tone}`);
        row.append(disc(e), el('span', 'pt', e.title), el('span', 'pw', e.at === null ? e.word : hm(e.at)));
        list.append(row);
      }
      out.push(list, ...doneUnkept(day));
    }
    if (groups.length) {
      const sum = el('p', 'dsum', 'Done');
      sum.append(el('span', '', String(doneTotal(day))));
      out.push(sum);
      const { shown, more } = cardProjects(groups);
      for (const g of shown) {
        const row = el('div', 'pp');
        row.append(kindDot(g.kind), el('span', 'pn', g.project), el('span', 'pc', String(g.items.length)));
        out.push(row);
      }
      if (more) out.push(el('p', 'more', `${more} more projects`));
    }
    return out;
  }

  /** The card for a day, under its date, or above it near the window's bottom; kept inside the window's sides. */
  function placeCard(day: string, fresh: boolean) {
    const button = calBody.querySelector<HTMLElement>(`[data-mini="${day}"]`);
    if (!button) return hideCard();
    clearTimeout(card.openTimer);
    clearTimeout(card.closeTimer);
    card.waiting = '';
    markWaiting('');
    for (const b of calBody.querySelectorAll('[aria-describedby="cal-pop"]')) b.removeAttribute('aria-describedby');
    button.setAttribute('aria-describedby', 'cal-pop');
    card.day = day;
    pop.replaceChildren(...cardContent(day, dayOf(Date.now())));
    pop.hidden = false;
    const gutter = 16;
    // Kept within the board's sides, so it never hangs out over the bare sky; the window's on a narrow one.
    const box = board.getBoundingClientRect();
    const [from, to] = box.width >= pop.offsetWidth + 2 * gutter ? [box.left, box.right] : [gutter, innerWidth - gutter];
    // On a phone the card would cover the month it was tapped on: it goes under the whole month instead.
    const r = phone.matches ? calBody.querySelector('.mini')?.getBoundingClientRect() ?? button.getBoundingClientRect() : button.getBoundingClientRect();
    const mid = phone.matches ? box.left + box.width / 2 : button.getBoundingClientRect().left + button.offsetWidth / 2;
    const x = Math.max(from, Math.min(mid - pop.offsetWidth / 2, to - pop.offsetWidth));
    let y = r.bottom + 8;
    if (y + pop.offsetHeight > innerHeight - gutter) y = r.top - 8 - pop.offsetHeight;
    pop.style.left = `${x}px`;
    pop.style.top = `${Math.max(gutter, y)}px`;
    if (fresh) {
      pop.classList.remove('show');
      void pop.offsetWidth;
      pop.classList.add('show');
    }
  }
  function showCard(day: string) {
    placeCard(day, pop.hidden);
  }
  function hideCard() {
    clearTimeout(card.openTimer);
    clearTimeout(card.closeTimer);
    card.day = card.waiting = '';
    markWaiting('');
    pop.hidden = true;
    for (const b of calBody.querySelectorAll('[aria-describedby="cal-pop"]')) b.removeAttribute('aria-describedby');
  }

  /** Big or small: the calendar grows in place into its row under the top panes, the panes below moving down with
   *  it (a view transition; at once with less motion asked for or none to be had), then the page glides to it.
   *  Shrinking runs the other way, quicker (surfaces close quicker than they open). */
  function resize(big: boolean, day = '') {
    hideCard();
    if (day) {
      calSel = day;
      calMonth = day.slice(0, 7);
    }
    const go = () => {
      calBig = big;
      placeTop();
      drawCalendar(Date.now());
      // A day picked with the keys keeps the keys there: on its cell in the big month.
      if (day && lastPointer === 'key') calBody.querySelector<HTMLElement>(`[data-cell="${day}"]`)?.focus({ preventScroll: true });
    };
    const glide = () => cal.scrollIntoView({ behavior: still.matches ? 'instant' : 'smooth', block: big ? 'start' : 'nearest' });
    if (!document.startViewTransition || still.matches) {
      go();
      glide();
      return;
    }
    // The panes that move get a name for the transition only, so they slide to their place instead of fading. The top
    // panes only change height, and stay with the page: a named pane leaves bare sky where it was while it moves.
    const moving: [HTMLElement, string][] = [[cal, 'dash-cal'], [projects, 'dash-projects'], [bottom, 'dash-bottom']];
    for (const [node, name] of moving) node.style.viewTransitionName = name;
    document.documentElement.classList.toggle('cal-shrinking', !big);
    document.startViewTransition(go).finished.finally(() => {
      for (const [node] of moving) node.style.viewTransitionName = '';
      document.documentElement.classList.remove('cal-shrinking');
      glide();
    });
  }

  /** To-do ends level with Done: its list takes Done's height with no lane open, kept while one is open, so opening a
   *  lane doesn't stretch To-do into an empty pane (the CSS reads --done-h). */
  function levelTodo() {
    if (!openLane) bottom.style.setProperty('--done-h', `${doneFrame.offsetHeight}px`);
  }

  /** Done drawn again after a lane moved, each lane gliding from where it was on screen to its new place, so the one
   *  let go settles into its slot and the others close up. `lifted` keeps that one raised until it lands. */
  function redrawMoving(lifted = '') {
    const before = new Map([...lanesBox.querySelectorAll<HTMLElement>('.lane')].map((l) => [l.dataset.key, l.getBoundingClientRect().top]));
    drawDone(Date.now());
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const lane of lanesBox.querySelectorAll<HTMLElement>('.lane')) {
      const was = before.get(lane.dataset.key);
      const by = was === undefined ? 0 : was - lane.getBoundingClientRect().top;
      if (!by) continue;
      lane.style.translate = `0 ${by}px`;
      lane.classList.toggle('lifted', lane.dataset.key === `p:${lifted}`);
      void lane.offsetHeight;
      lane.classList.add('settling');
      lane.style.translate = '';
      // Only its own glide: a grip's or a pill's hover ending inside it would drop the lane early.
      const landed = (event: TransitionEvent) => {
        if (event.target !== lane || event.propertyName !== 'translate') return;
        lane.classList.remove('settling', 'lifted');
        lane.removeEventListener('transitionend', landed);
      };
      lane.addEventListener('transitionend', landed);
    }
  }

  /** Moves a project's lane to a place among the lanes with a grip, and keeps that order in this browser. */
  function moveLane(project: string, to: number) {
    order = laneOrder(order, shown, project, to);
    try { localStorage.setItem(ORDER_KEY, JSON.stringify(order)); } catch {}
  }

  /** Back to the lane's grip, name or pill after Done is drawn again, so a keyboard keeps its place. */
  function refocus(lane: string, day: string, grip = '') {
    const match = [...lanesBox.querySelectorAll<HTMLButtonElement>('button[data-lane], button[data-grip]')]
      .find((b) => (grip ? b.dataset.grip === grip : b.dataset.lane === lane && (b.dataset.day ?? '') === day));
    match?.focus();
  }

  function draw() {
    // The minute's redraw waits while a lane is held: Done redrawn would drop it from the hand, and the sections
    // above changing height would move Done under it.
    if (!snapshot || drag) return;
    // The nodes about to be replaced stop being watched; the new ones that haven't played yet are watched instead.
    watcher.disconnect();
    const now = Date.now();
    const active = document.activeElement instanceof HTMLButtonElement && lanesBox.contains(document.activeElement) ? document.activeElement : null;
    const focused = active ? [active.dataset.lane ?? '', active.dataset.day ?? '', active.dataset.grip ?? ''] as const : null;
    const line = lede(Date.parse(snapshot.made_at), now);
    top.hidden = false;
    top.replaceChildren(...(line.offline ? [el('span', 'offline', 'Laptop offline')] : []), line.text);
    drawNeeds(now);
    drawReminders(now);
    drawToday(now);
    drawCalendar(now);
    drawProjects(now);
    drawTodos(now);
    drawDone(now);
    if (focused) refocus(...focused);
  }

  /** Words in place of the board, and no line under the title. */
  function showGate(words: string) {
    snapshot = null;
    top.hidden = true;
    board.hidden = true;
    gate.hidden = false;
    gate.textContent = words;
  }

  async function load() {
    if (!draftPass()) return showGate('Log in first: open the palette and type /login.');
    // Asked again on coming back to the tab, the line keeps what it says until the answer comes.
    if (!snapshot) sayWaiting(top, 'Loading');
    const [dash, list] = await Promise.allSettled([draftCall<{ snapshot: any }>('/api/dashboard'), draftCall<{ items: Todo[], projects: string[] }>('/api/todos')]);
    loadedAt = Date.now();
    if (dash.status === 'rejected') return showGate((dash.reason as { status?: number }).status === 401 ? 'The login ran out: open the palette and type /login again.' : (dash.reason as Error).message);
    if (!dash.value.snapshot) return showGate('Nothing has come from the laptop yet.');
    snapshot = dash.value.snapshot;
    todos = list.status === 'fulfilled' ? list.value.items : null;
    todoProjects = list.status === 'fulfilled' ? list.value.projects ?? [] : [];
    todoError = list.status === 'rejected' ? (list.reason as Error).message : '';
    gate.hidden = true;
    board.hidden = false;
    draw();
  }

  lanesBox.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('button[data-lane]');
    if (!button) return;
    const lane = button.dataset.lane ?? '';
    const day = button.dataset.day ?? '';
    const open = openLane === lane && openDay === day;
    openLane = open ? '' : lane;
    openDay = open ? '' : day;
    drawDone(Date.now());
    // Only a click opens it gently; the minute's redraw leaves an open one still.
    lanesBox.querySelector('.lane-open')?.classList.add('opening');
    refocus(lane, day);
  });
  // Dragging a lane by its grip: it follows the pointer (or finger: the grip takes no scrolling), the lanes it passes
  // step aside, and letting go settles it into the gap. Escape puts it back.
  lanesBox.addEventListener('pointerdown', (event) => {
    let grip = (event.target as Element).closest<HTMLButtonElement>('button[data-grip]');
    if (!grip || drag || event.button !== 0) return;
    event.preventDefault();
    // An open list closes first, so every lane passed is one row high (Jack, testing T6c). The page scrolls by what
    // closing moved the grip, keeping it under the pointer; what scrolling can't take back, the lane starts lowered by.
    let shift = 0;
    if (openLane) {
      const project = grip.dataset.grip ?? '';
      const before = grip.getBoundingClientRect().top;
      openLane = openDay = '';
      drawDone(Date.now());
      grip = [...lanesBox.querySelectorAll<HTMLButtonElement>('button[data-grip]')].find((b) => b.dataset.grip === project)!;
      scrollBy({ top: grip.getBoundingClientRect().top - before, behavior: 'instant' });
      shift = before - grip.getBoundingClientRect().top;
    }
    const lanes = [...lanesBox.querySelectorAll<HTMLElement>('.lane:not([data-key="more"])')];
    const lane = grip.closest<HTMLElement>('.lane')!;
    grip.setPointerCapture(event.pointerId);
    const from = lanes.indexOf(lane);
    const mids = lanes.map((l) => { const r = l.getBoundingClientRect(); return r.top + r.height / 2; });
    // Kept within the lanes, so the lane answers the first move even where the page, now shorter, couldn't scroll back.
    shift = Math.max(mids[0] - mids[from], Math.min(mids[mids.length - 1] - mids[from], shift));
    drag = { pointer: event.pointerId, lane, lanes, from, to: from, startY: event.clientY - shift, mids };
    lane.classList.add('lifted');
    lanesBox.classList.add('dragging');
    if (shift) follow(event.clientY);
  });
  lanesBox.addEventListener('pointermove', (event) => {
    if (drag && event.pointerId === drag.pointer) follow(event.clientY);
  });
  /** The lane in hand follows the pointer, and the lanes it passes step aside. */
  function follow(y: number) {
    if (!drag) return;
    const { lane, lanes, from, mids } = drag;
    // Held between the first lane and the last that has a grip.
    const by = Math.max(mids[0] - mids[from], Math.min(mids[mids.length - 1] - mids[from], y - drag.startY));
    lane.style.translate = `0 ${by}px`;
    let to = from;
    // Reaching a lane's middle takes its place: held at the ends, the lane sits exactly on the end lane's middle.
    while (to < mids.length - 1 && mids[from] + by >= mids[to + 1]) to++;
    while (to > 0 && mids[from] + by <= mids[to - 1]) to--;
    drag.to = to;
    const height = lane.offsetHeight;
    lanes.forEach((other, i) => {
      if (other === lane) return;
      const step = i > from && i <= to ? -height : i < from && i >= to ? height : 0;
      other.style.translate = step ? `0 ${step}px` : '';
    });
  }
  function letGo(keep: boolean) {
    if (!drag) return;
    const { from, to } = drag;
    const project = shown[from];
    drag = null;
    lanesBox.classList.remove('dragging');
    if (keep && to !== from) moveLane(project, to);
    redrawMoving(project);
  }
  lanesBox.addEventListener('pointerup', (event) => { if (drag?.pointer === event.pointerId) letGo(true); });
  lanesBox.addEventListener('pointercancel', (event) => { if (drag?.pointer === event.pointerId) letGo(false); });
  // Any other way the grip loses the pointer puts the lane back, so a drag can't stay stuck.
  lanesBox.addEventListener('lostpointercapture', (event) => { if (drag?.pointer === event.pointerId) letGo(false); });
  document.addEventListener('keydown', (event) => { if (drag && event.key === 'Escape') letGo(false); });
  // A grip with the keyboard: the arrows move its lane a place at a time, and the grip keeps the focus.
  lanesBox.addEventListener('keydown', (event) => {
    const grip = (event.target as Element).closest<HTMLButtonElement>('button[data-grip]');
    if (!grip || drag || (event.key !== 'ArrowUp' && event.key !== 'ArrowDown')) return;
    event.preventDefault();
    const project = grip.dataset.grip ?? '';
    const from = shown.indexOf(project);
    const to = from + (event.key === 'ArrowUp' ? -1 : 1);
    if (from < 0 || to < 0 || to >= shown.length) return;
    moveLane(project, to);
    redrawMoving();
    refocus('', '', project);
    said.textContent = `${project}: ${to + 1} of ${shown.length}`;
  });
  document.querySelectorAll<HTMLInputElement>('input[name="week"]').forEach((radio) => radio.addEventListener('change', () => {
    which = radio.value === 'last' ? 'last' : 'this';
    openLane = openDay = '';
    drawDone(Date.now());
  }));
  filter.addEventListener('change', () => {
    drawTodos(Date.now());
    todoScroll.scrollTop = 0;
  });
  cal.querySelector('.cal-nav')?.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('button');
    if (!button) return;
    if (button.dataset.size !== undefined) return resize(!calBig);
    const n = Number(button.dataset.month);
    if (n === 0) {
      calSel = dayOf(Date.now());
      calMonth = calSel.slice(0, 7);
    } else calMonth = shiftMonth(calMonth, n);
    hideCard();
    drawCalendar(Date.now());
  });
  calBody.addEventListener('click', (event) => {
    const day = (event.target as Element).closest<HTMLElement>('[data-mini]')?.dataset.mini;
    if (day) {
      // A touch has no hover: its first tap shows the day's card, a second on that day makes the month big there.
      if (lastPointer === 'touch' && card.day !== day) return showCard(day);
      return resize(true, day);
    }
    const cell = (event.target as Element).closest<HTMLElement>('[data-cell]')?.dataset.cell;
    if (!cell) return;
    calSel = cell;
    // A day of the month before or after turns the month to it.
    calMonth = cell.slice(0, 7);
    drawCalendar(Date.now());
    calBody.querySelector('.cal-day')?.classList.add('opening');
  });
  document.addEventListener('pointerdown', (event) => {
    lastPointer = event.pointerType;
    if (!(event.target as Element).closest?.('[data-mini]')) hideCard();
  }, true);
  document.addEventListener('keydown', () => { lastPointer = 'key'; }, true);
  calBody.addEventListener('pointerover', (event) => {
    if (event.pointerType !== 'mouse') return;
    const day = (event.target as Element).closest<HTMLElement>('[data-mini]')?.dataset.mini;
    if (!day) return;
    clearTimeout(card.closeTimer);
    if (!pop.hidden) return showCard(day);
    if (card.waiting === day) return;
    clearTimeout(card.openTimer);
    card.waiting = day;
    markWaiting(day);
    card.openTimer = window.setTimeout(() => showCard(day), HOLD);
  });
  calBody.addEventListener('pointerout', (event) => {
    if (event.pointerType !== 'mouse' || !(event.target as Element).closest('[data-mini]')) return;
    if ((event.relatedTarget as Element | null)?.closest?.('[data-mini]')) return;
    clearTimeout(card.openTimer);
    card.waiting = '';
    markWaiting('');
    card.closeTimer = window.setTimeout(hideCard, LEAVE);
  });
  calBody.addEventListener('focusin', (event) => {
    const button = (event.target as Element).closest<HTMLElement>('[data-mini]');
    if (button?.matches(':focus-visible')) showCard(button.dataset.mini ?? '');
  });
  calBody.addEventListener('focusout', (event) => {
    if ((event.target as Element).closest('[data-mini]') && !(event.relatedTarget as Element | null)?.closest?.('[data-mini]') && lastPointer === 'key') hideCard();
  });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') hideCard(); });
  // A scroll takes the day from under the pointer, so its card goes; one opened by a keyboard focus stays with its day,
  // as focusing a day can scroll it into view.
  addEventListener('scroll', () => {
    if (pop.hidden) return;
    const focused = document.activeElement;
    if (focused instanceof HTMLElement && focused.dataset.mini === card.day && focused.matches(':focus-visible')) placeCard(card.day, false);
    else hideCard();
  }, { passive: true });
  // "x minutes ago" and the days left move with the clock; coming back to the tab asks for the latest.
  setInterval(draw, 60_000);
  // A login in the palette (SearchDialog) draws the board at once.
  document.addEventListener('now-login', () => load());
  // Done's height changes with its lanes, the window and late fonts alike.
  new ResizeObserver(levelTodo).observe(doneFrame);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && snapshot && Date.now() - loadedAt > 60_000) load();
  });

  load();
</script>

<style>
  /* Look A of T8's prototypes ("Aurora", Jack's pick): four colour clouds drifting slowly behind (only decoration; the
     states are in the sections), every section a pane of frosted glass, the ones with a state lit from their top. The
     drift is this page's own slow movement, like the night sky's; with less motion asked for, it holds still. */
  .sky { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .sky i { position: absolute; border-radius: 50%; background: radial-gradient(closest-side, var(--cloud) 30%, transparent); animation: dash-drift 26s ease-in-out infinite alternate; }
  .sky i:nth-child(1) { --cloud: var(--dg-cloud-1); left: -26vw; top: -40vw; width: 84vw; height: 84vw; opacity: 0.6; }
  .sky i:nth-child(2) { --cloud: var(--dg-cloud-2); right: -22vw; top: -6vh; width: 66vw; height: 66vw; opacity: 0.48; animation-duration: 31s; animation-direction: alternate-reverse; }
  .sky i:nth-child(3) { --cloud: var(--dg-cloud-3); left: -16vw; top: 50vh; width: 64vw; height: 64vw; opacity: 0.4; animation-duration: 37s; }
  .sky i:nth-child(4) { --cloud: var(--dg-cloud-4); right: -18vw; top: 58vh; width: 70vw; height: 70vw; opacity: 0.44; animation-duration: 29s; animation-direction: alternate-reverse; }
  @keyframes dash-drift { to { transform: translate(6vw, 4vh) scale(1.12); } }
  @media (prefers-reduced-motion: reduce) { .sky i { animation: none; } }

  /* The site's menu bar, the one part of the site kept (D12), as a darker glass bar. Its theme button goes: the page
     looks the same in every theme. */
  :global(html[data-look='dashboard'] .site-header) { background: var(--dg-bar); backdrop-filter: blur(var(--dg-bar-blur)) saturate(150%); -webkit-backdrop-filter: blur(var(--dg-bar-blur)) saturate(150%); }
  :global(html[data-look='dashboard'] .site-header .theme-btn) { display: none; }

  /* A pane of glass: a faint white over the clouds, frosted, a fine edge and a bright top line. */
  .glass { border: var(--hairline) solid var(--dg-glass-edge); border-radius: var(--radius-xl); background: linear-gradient(var(--dg-glass), var(--dg-glass)) var(--dg-veil);
    box-shadow: inset 0 1px 0 var(--dg-glass-top), var(--dg-glass-shadow);
    backdrop-filter: blur(var(--dg-glass-blur)) saturate(160%); -webkit-backdrop-filter: blur(var(--dg-glass-blur)) saturate(160%); }

  .top { margin-bottom: var(--space-5); padding: var(--space-6) var(--space-7); }
  .title { margin: 0; font-size: var(--dg-title); font-weight: 900; line-height: 1; letter-spacing: -0.03em; }
  .lede { margin: var(--space-3) 0 0; color: var(--muted); font-size: var(--text-md); }
  .lede[hidden] { display: none; }
  /* Global: the script writes it. */
  .lede :global(.offline) { margin-right: var(--space-3); padding: 0.125rem var(--space-3); border-radius: var(--radius-pill); background: var(--dg-well); color: var(--ink); font-size: var(--text-sm); font-weight: 750; white-space: nowrap; }
  .gate { margin: 0; padding: var(--space-6); font-weight: 650; }
  .gate[hidden], .board[hidden] { display: none; }
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* The board's rows (A's layout): Needs you, wider, beside Reminders over Today, or the All clear strip over Today
     beside Reminders; Projects across; Done, wider, beside the other to-dos. Two sides end level: each side's last
     section stretches to the row's end, and To-do's list takes Done's height. */
  .board { display: grid; gap: var(--space-5); }
  .lanes { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--space-5); }
  .side { display: flex; flex-direction: column; gap: var(--space-5); min-width: 0; }
  .side > :global(.frame:last-child) { flex: 1 0 auto; }

  /* Each section a pane; one with a state is lit from its top in that state's colour: Needs you in its most urgent
     one (green as the All clear strip), Reminders in its most urgent signing's. The light fades out by the first
     rows, so their words keep 4.5:1. Today, Projects, To-do and Done stay unlit. */
  .frame { --lit: transparent; position: relative; isolation: isolate; overflow: hidden; min-width: 0; padding: var(--space-5) var(--space-5) var(--space-2); }
  .frame.needs, .frame.reminders { border-top-color: color-mix(in srgb, var(--lit) 70%, transparent); }
  .needs::before, .reminders::before { content: ''; position: absolute; z-index: -1; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, color-mix(in srgb, var(--lit) 36%, transparent), color-mix(in srgb, var(--lit) 8%, transparent) 7rem, transparent 12rem); }
  .needs.lv-act { --lit: var(--dash-bad); }
  .needs.lv-soon { --lit: var(--dash-soon); }
  .needs.lv-calm, .reminders.lv-ok { --lit: var(--dash-ok); }
  .reminders.lv-soon { --lit: var(--dash-soon); }
  .reminders.lv-act { --lit: var(--dash-bad); }
  .sec-h { display: flex; gap: var(--space-3); align-items: baseline; margin: 0; padding-bottom: var(--space-3); border-bottom: var(--hairline) solid var(--rule); font-size: var(--text-lg); font-weight: 900; letter-spacing: -0.01em; }
  .needs .sec-h, .reminders:is(.lv-ok, .lv-soon, .lv-act) > .sec-h { color: color-mix(in srgb, var(--lit) 55%, var(--ink)); }
  .count { color: var(--muted); font-size: var(--text-ui); font-weight: 700; font-variant-numeric: tabular-nums; }
  /* Global: the notes are written by the script, which scoped styles don't reach. */
  .board :global(.note) { margin: 0; padding: var(--space-4) 0; color: var(--muted); }

  /* Rows: hairlines between, each figure in a place of its own. */
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows :global(li) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px var(--space-4); align-items: baseline; padding: 14px 0; border-top: var(--hairline) solid var(--rule); }
  .rows :global(li:first-child) { border-top: 0; }
  .rows :global(.what) { min-width: 0; font-weight: 700; overflow-wrap: anywhere; }
  /* To-do rows as /todo's: the day at the right, red once passed, the project's tag under the words. */
  .todo :global(.day) { color: var(--muted); font-size: var(--text-sm); font-weight: 700; white-space: nowrap; }
  .todo :global(.day.late) { color: var(--todo-late); }
  .todo :global(.tag) { justify-self: start; }
  .todo :global(li.note) { display: block; }
  /* The project filter at the header's right, as in the desktop widget; set into the glass like a well. */
  .todo-top, .done-top { display: flex; gap: var(--space-3); align-items: center; justify-content: space-between; padding-bottom: var(--space-3); border-bottom: var(--hairline) solid var(--rule); }
  .todo-top .sec-h, .done-top .sec-h { padding-bottom: 0; border-bottom: 0; }
  .pick { position: relative; display: inline-flex; min-width: 0; }
  .pick[hidden] { display: none; }
  .pick select { appearance: none; min-width: 0; max-width: 14rem; padding: 0.3125rem 2.25rem 0.3125rem var(--space-4); border: var(--hairline) solid var(--dg-glass-edge); border-radius: var(--radius-pill); background: var(--dg-well); color: var(--ink); font: inherit; font-size: var(--text-sm); font-weight: 700; text-overflow: ellipsis; cursor: pointer; }
  .pick select:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .pick .icon { position: absolute; top: 50%; right: var(--space-3); width: 14px; height: 14px; translate: 0 -50%; color: var(--muted); stroke-width: 2.5; pointer-events: none; }
  /* A long list scrolls in its own box, its edges fading (data-edge-fade). The pane is as tall as Done with no lane
     open (levelTodo), and at least about four rows; its list takes what the header leaves. */
  .lanes.bottom { align-items: start; }
  .todo { display: flex; flex-direction: column; height: var(--done-h); min-height: 21rem; }
  .todo-scroll { flex: 1 1 0; min-height: 0; overflow-y: auto; }
  /* The panes' own scrolling lists (To-do, the calendar's chosen day): a slim pill of the glass's white, no arrows or
     track. The site's scrollbar-color, inherited from <html>, would make Chrome ignore the -webkit- parts, so it's
     set back to auto here; Firefox, which has no -webkit- parts, gets a thin bar in the same white. Scrollbars can't
     ease, so the thumb doesn't change under the pointer. */
  .todo-scroll, .cal :global(.cal-day) { scrollbar-color: auto; scrollbar-width: auto; }
  .todo-scroll::-webkit-scrollbar, .cal :global(.cal-day::-webkit-scrollbar) { width: 12px; background: transparent; }
  .todo-scroll::-webkit-scrollbar-thumb, .cal :global(.cal-day::-webkit-scrollbar-thumb) { min-height: 40px; border: 3px solid transparent; border-radius: var(--radius-pill); background: var(--dg-scroll) padding-box; }
  .todo-scroll::-webkit-scrollbar-corner, .cal :global(.cal-day::-webkit-scrollbar-corner) { background: transparent; }
  @supports not selector(::-webkit-scrollbar) { .todo-scroll, .cal :global(.cal-day) { scrollbar-width: thin; scrollbar-color: var(--dg-scroll) transparent; } }

  /* Needs you: a big number (or an icon) in the state's colour with a soft light behind it, then the words. */
  .needs :global(.need) { --c: var(--dash-bad); display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: var(--space-1) var(--space-5); align-items: center; min-width: 0; padding: 18px 0; border-top: var(--hairline) solid var(--rule); isolation: isolate; }
  .needs :global(.need:first-child) { border-top: 0; }
  .needs :global(.need.soon) { --c: var(--dash-soon); }
  .needs :global(.fig-col) { position: relative; display: flex; flex-direction: column; align-items: center; min-width: 0; color: var(--c); text-align: center; }
  .needs :global(.fig-col::before) { content: ''; position: absolute; z-index: -1; left: 50%; top: 50%; width: 6rem; height: 6rem; translate: -50% -50%; border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 34%, transparent), transparent); }
  .needs :global(.fig) { margin: 0; font-size: 3.25rem; font-weight: 900; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .needs :global(.unit) { margin: 4px 0 0; font-size: var(--text-xs); font-weight: 650; }
  .needs :global(.fig-col .icon) { display: block; width: 34px; height: 34px; stroke-width: 2; }
  .needs :global(.cells) { display: flex; gap: 6px; margin: var(--space-2) 0 0; }
  .needs :global(.cells i) { width: 26px; height: 10px; border-radius: var(--radius-2xs); background: var(--dg-cell-off); }
  .needs :global(.cells i.on) { background: var(--c); box-shadow: 0 0 12px -2px var(--c); }
  .needs :global(.body) { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .needs :global(.need .sub) { margin: 0; color: var(--muted); overflow-wrap: anywhere; }
  .needs :global(.err) { margin: var(--space-2) 0 0; padding: var(--space-2) var(--space-3); border: var(--hairline) solid color-mix(in srgb, var(--c) 26%, transparent); border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--c) 12%, var(--dg-well)); color: var(--ink); font-size: var(--text-sm); overflow-wrap: anywhere; }
  /* A link in its row's colour, as Now's cards colour theirs, so it reads apart from the words. */
  .needs :global(.run-link) { align-self: flex-start; margin-top: var(--space-1); color: var(--c); font-weight: 750; }

  /* The All clear strip (C's): when nothing needs Jack, Needs you shrinks to one thin line lit green from its top,
     All clear on the left and a short line on the right. */
  .needs.strip { padding-bottom: var(--space-2); }
  .needs-head { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); align-items: baseline; justify-content: space-between; }
  .needs:not(.strip) .needs-head { display: block; }
  .needs.strip .sec-h { padding-bottom: 14px; border-bottom: 0; }
  .clear-line { margin: 0; padding-bottom: 14px; color: var(--muted); font-size: var(--text-ui); font-weight: 700; }
  .clear-line[hidden], .needs.strip [data-list] { display: none; }

  /* A title with its kind's mark before it (Needs you, Reminders). */
  .board :global(.t-row) { display: flex; gap: 10px; align-items: flex-start; }
  .board :global(.t-row .kind) { margin-top: 1px; }
  .board :global(.t) { min-width: 0; margin: 0; font-size: var(--text-md); font-weight: 800; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  /* A kind's mark: its icon in its colour on a small glass square, softly lit by that colour. */
  .board :global(.kind) { --k: var(--dg-kind-other); display: inline-grid; place-items: center; flex: none; width: 26px; height: 26px; border: var(--hairline) solid color-mix(in srgb, var(--k) 40%, transparent); border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--k) 16%, var(--dg-well)); color: var(--k); box-shadow: 0 0 14px -4px var(--k); }
  .board :global(.kind .icon) { width: 15px; height: 15px; stroke-width: 2; }
  .board :global(.kind.big) { width: 40px; height: 40px; border-radius: var(--radius-art); }
  .board :global(.kind.big .icon) { width: 22px; height: 22px; }

  /* Reminders (B's ring): the signing's seven days round a big number of days left, lit in the state's colour; the
     title, when it runs out and when it was signed beside it. Stretched to end level with Today, it sits in the
     middle of its pane. */
