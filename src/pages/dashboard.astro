  .projects :global(.play .glyph:not(.run)::before) { animation: dash-check var(--motion-hold) linear var(--d) backwards; }
  .projects :global(.play .sign::before) { animation: dash-check calc(var(--motion-hold) + var(--at) * var(--motion-wait-step)) linear var(--d) backwards; }
  .projects :global(.play .glyph:not(.run)::after) { animation: dash-ripple var(--motion-hold) var(--ease-out) var(--t) backwards; }
  .projects :global(.play .glyph:not(.run) > .icon) { animation: dash-pop var(--motion-settle) var(--ease-out) var(--t) backwards; }
  .projects :global(.play .glyph:is(.act, .soon) > .icon) { animation: dash-pop var(--motion-settle) var(--ease-out) var(--t) backwards, dash-hop var(--motion-hold) var(--ease-out) calc(var(--t) + var(--motion-settle)); }
  .projects :global(.play .sign > .icon) { --at-t: calc(var(--t) + var(--at) * var(--motion-wait-step)); animation: dash-pop var(--motion-settle) var(--ease-out) var(--at-t) backwards; }
  .projects :global(.play .pill:is(.act, .soon) .sign > .icon) { animation: dash-pop var(--motion-settle) var(--ease-out) var(--at-t) backwards, dash-hop var(--motion-hold) var(--ease-out) calc(var(--at-t) + var(--motion-settle)); }
  .projects :global(.tile.wait.lit::before) { opacity: 0; }
  .projects :global(.tile.play.lit::before) { animation: dash-light var(--motion-soft) var(--ease-out) var(--t) backwards; }
  .projects :global(.wk i) { transform-origin: bottom; }
  .projects :global(.wait .wk i) { scale: 1 0; }
  .projects :global(.play .wk i) { animation: dash-grow var(--motion-settle) var(--ease-spring) calc(var(--d) + var(--motion-soft) + var(--i) * var(--motion-wait-step) / 3) backwards; }
  .reminders :global(.wait path.on) { stroke: var(--dg-cell-off); filter: none; }
  .reminders :global(.play path.on) { animation: dash-arc var(--motion-soft) var(--ease-out) calc(var(--d) + var(--motion-soft) + var(--i) * var(--motion-wait-step)) backwards; }
  .reminders :global(.wait .ring-mid b) { scale: 0; }
  .reminders :global(.play .ring-mid b) { --at-t: calc(var(--d) + var(--motion-soft) + 7 * var(--motion-wait-step)); animation: dash-pop var(--motion-settle) var(--ease-out) var(--at-t) backwards; }
  .reminders :global(.play:is(.act, .soon) .ring-mid b) { animation: dash-pop var(--motion-settle) var(--ease-out) var(--at-t) backwards, dash-hop var(--motion-hold) var(--ease-out) calc(var(--at-t) + var(--motion-settle)); }
  .needs :global(.wait .fig-col) { scale: 0; }
  .needs :global(.play .fig-col) { animation: dash-pop var(--motion-settle) var(--ease-out) calc(var(--d) + var(--motion-soft)) backwards, dash-hop var(--motion-hold) var(--ease-out) calc(var(--d) + var(--motion-soft) + var(--motion-settle)); }
  .today :global(.td.late.play .day) { animation: dash-hop var(--motion-hold) var(--ease-out) calc(var(--d) + var(--motion-soft)); }
  @keyframes dash-rise { from { opacity: 0; translate: 0 14px; } }
  @keyframes dash-check { from { opacity: 1; rotate: 0turn; } 85% { opacity: 1; } to { opacity: 0; rotate: 1.5turn; } }
  @keyframes dash-pop { from { scale: 0; } 60% { scale: 1.3; } to { scale: 1; } }
  @keyframes dash-ripple { from { opacity: 0; } 1% { opacity: 0.9; scale: 1; } to { opacity: 0; scale: 2.4; } }
  @keyframes dash-hop { 20% { translate: 0 -0.32em; } 40% { translate: 0 0; } 60% { translate: 0 -0.16em; } 80% { translate: 0 0; } }
  @keyframes dash-light { from { opacity: 0; } }
  @keyframes dash-grow { from { scale: 1 0; } }
  @keyframes dash-arc { from { stroke: var(--dg-cell-off); filter: none; } }

  /* Hovers: a card lifts with its kind's light (a card in trouble, its state's), its corner sign answering (a nod
     when fine, a shake in trouble) and its week's bars rising in a wave; a pill glows up and its sign nods; a kind's
     mark hops; Reminders' lit days thicken one after another and its number swells; a need's figure swells. A
     keyboard focus inside a card does the same as a hover. */
  .projects :global(.tile) { --glow: var(--k); transition: translate var(--motion-soft) var(--ease-out), border-color var(--motion-quick) var(--ease-out), box-shadow var(--motion-quick) var(--ease-out); }
  .projects :global(.tile.lit) { --glow: var(--lit); }
  .projects :global(.wk i) { transition: translate var(--motion-soft) var(--ease-spring) calc(var(--i) * var(--motion-wait-step) / 3); }
  .projects :global(.pill) { transition: scale var(--motion-soft) var(--ease-spring), box-shadow var(--motion-quick) var(--ease-out), background-color var(--motion-quick) var(--ease-out); }
  .projects :global(.quiet span) { transition: color var(--motion-quick) var(--ease-out); }
  .today :global(.td) { transition: translate var(--motion-soft) var(--ease-out), border-color var(--motion-quick) var(--ease-out); }
  .reminders :global(.ring-wrap path) { transition: stroke-width var(--motion-soft) var(--ease-out) calc(var(--i) * var(--motion-wait-step) / 2), filter var(--motion-soft) var(--ease-out) calc(var(--i) * var(--motion-wait-step) / 2); }
  .board :global(:is(.ring-mid b, .fig-col)) { transition: scale var(--motion-soft) var(--ease-spring); }
  .projects :global(.tile:has(:focus-visible)) { border-color: color-mix(in srgb, var(--glow) 55%, transparent); box-shadow: 0 12px 30px -16px var(--glow); }
  @media (hover: hover) {
    .projects :global(.tile:hover) { border-color: color-mix(in srgb, var(--glow) 55%, transparent); box-shadow: 0 12px 30px -16px var(--glow); }
    .projects :global(.pill:hover) { background-color: color-mix(in srgb, var(--c) 26%, transparent); box-shadow: 0 0 18px -4px var(--c); }
    .projects :global(.quiet span:hover) { color: var(--ink); }
