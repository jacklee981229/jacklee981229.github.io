  .week-lanes :global(.lane-name .dot) { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--c); box-shadow: 0 0 8px color-mix(in srgb, var(--c) 70%, transparent); }
  .week-lanes :global(.lane-name .label) { min-width: 0; overflow: hidden; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; transition: color var(--motion-quick) var(--ease-out); }
  .week-lanes :global(.lane-name .n) { margin-left: auto; color: var(--muted); font-size: var(--text-sm); font-weight: 700; font-variant-numeric: tabular-nums; }
  .week-lanes :global(.lane-name[aria-expanded='true'] .label) { color: var(--label, var(--c)); }
  @media (hover: hover) { .week-lanes :global(.lane-name:hover .label) { color: var(--label, var(--c)); } }
  .week-lanes :global(.cell) { display: flex; align-items: center; padding: var(--space-2) 2px; border-top: var(--hairline) solid var(--rule); }
  .week-lanes :global(.cell.today) { background: var(--dg-today); }
  .week-lanes :global(.pill) { --f: 0; width: calc(30px + (100% - 30px) * var(--f)); min-width: 30px; height: 30px; padding: 0 9px; border: 0; border-radius: var(--radius-pill); cursor: pointer; -webkit-tap-highlight-color: transparent;
    background: var(--c); color: var(--dash-pill-ink); font: inherit; font-size: var(--text-sm); font-weight: 900; text-align: left; font-variant-numeric: tabular-nums;
    box-shadow: 0 0 14px color-mix(in srgb, var(--c) 45%, transparent);
    transition: box-shadow var(--motion-quick) var(--ease-out), transform var(--motion-soft) var(--ease-release); }
  .week-lanes :global(.pill[aria-expanded='true']) { box-shadow: 0 0 22px color-mix(in srgb, var(--c) 70%, transparent), 0 0 0 2px var(--ink); }
  .week-lanes :global(.pill:active) { transform: scale(0.96); transition-duration: var(--motion-press); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .week-lanes :global(.pill:hover) { transform: translateY(-1px); box-shadow: 0 0 20px color-mix(in srgb, var(--c) 60%, transparent); }
    .week-lanes :global(.pill[aria-expanded='true']:hover) { box-shadow: 0 0 22px color-mix(in srgb, var(--c) 70%, transparent), 0 0 0 2px var(--ink); }
  }
  /* What a lane did, opened under it: a day, or each day of its week. */
  /* A lone day takes the whole width and its list runs on in columns, so a busy day stays short. */
  .week-lanes :global(.lane-open) { display: grid; grid-column: 1 / -1; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 18px var(--space-6); padding: var(--space-3) 0 var(--space-5) var(--space-5); border-radius: var(--radius-md); background: var(--dg-well); }
  /* Opened by a click, it fades in and settles from just above; it closes at once. */
  @media (prefers-reduced-motion: no-preference) {
    .week-lanes :global(.lane-open.opening) { animation: dash-lane-open var(--motion-soft) var(--ease-out); }
  }
  @keyframes dash-lane-open { from { opacity: 0; translate: 0 -4px; } }
  .week-lanes :global(.group h3) { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); align-items: baseline; margin: 0 0 6px; font-size: var(--text-base); font-weight: 800; }
  .week-lanes :global(.group h3 span) { color: var(--muted); font-size: var(--text-sm); font-weight: 650; }
  /* A day's modules run on in columns, each kept whole: its name over its lines. */
  .week-lanes :global(.modules) { columns: 22rem; column-gap: var(--space-6); }
  .week-lanes :global(.module) { padding-bottom: var(--space-3); break-inside: avoid; }
