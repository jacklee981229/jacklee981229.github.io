    .projects :global(.tile:hover .wk i) { translate: 0 -3px; }
    .projects :global(.tile:hover .glyph:not(.run)) { animation: dash-nod var(--motion-settle) var(--ease-out); }
    .projects :global(.tile:hover .glyph:is(.act, .soon)) { animation: dash-shake var(--motion-hold) var(--ease-out); }
    .projects :global(.pill:hover) { scale: 1.06; }
    .projects :global(.pill:hover .sign) { animation: dash-nod var(--motion-settle) var(--ease-out); }
    .today :global(.td:hover) { translate: 0 -2px; }
    .board :global(:is(.shelf, .td, .need, .ring-rem):hover .kind) { animation: dash-jump var(--motion-settle) var(--ease-out); }
    .reminders :global(.ring-rem:hover path.on) { stroke-width: 9.5; filter: drop-shadow(0 0 6px var(--c)); }
    .reminders :global(.ring-rem:hover .ring-mid b) { scale: 1.12; }
    .needs :global(.need:hover .fig-col) { scale: 1.08; }
  }
  @keyframes dash-nod { 40% { scale: 1.25; } }
  @keyframes dash-shake { 15% { rotate: -14deg; } 30% { rotate: 14deg; } 45% { rotate: -9deg; } 60% { rotate: 9deg; } 75% { rotate: -4deg; } }
  @keyframes dash-jump { 35% { translate: 0 -4px; } 70% { translate: 0 1px; } }

  /* Done (D10, the "project lanes"): This week | Last week at the header's right, as To-do's filter, then the week
     across and a lane a project down, in the order Jack dragged them to. A day's things in a lane are one pill in the
     project's colour, glowing as Needs you's cells do, longer the more it holds; today's column is faintly lit. No
     key: each lane is named. */
  .done-body { padding: var(--space-4) 0 var(--space-4); }
  .done-top :global(.switch) { border-color: var(--dg-glass-edge); background: var(--dg-well); }
  .done-top :global(.switch[hidden]) { display: none; }
  /* The names' column fits the grip, "claude-usage-widget" and its count; longer names end in "…". Each lane is a row
     of its own on the same columns, so it can be lifted and moved whole, what's open under it included. */
  .week-lanes { display: grid; grid-template-columns: minmax(8.5rem, 15.5rem) repeat(7, minmax(0, 1fr)); column-gap: 6px; }
  .week-lanes > :global(*), .week-lanes :global(.lane > *) { min-width: 0; }
  .week-lanes :global(.lane) { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; }
  .week-lanes :global(.lane-head) { display: flex; align-items: center; border-top: var(--hairline) solid var(--rule); }
  /* The grip: six dots in two columns, quiet until pointed at; the shared lane keeps its room empty. */
  .week-lanes :global(.grip) { flex: none; display: grid; place-items: center; width: 22px; height: 32px; margin-right: 6px; padding: 0; border: 0; border-radius: var(--radius-xs); background: none;
    color: var(--muted); cursor: grab; touch-action: none; -webkit-tap-highlight-color: transparent; transition: color var(--motion-quick) var(--ease-out); }
  .week-lanes :global(.grip .icon) { width: 16px; height: 16px; }
  .week-lanes :global(button.grip:focus-visible) { color: var(--ink); outline: 2px solid var(--focus); outline-offset: -2px; }
  @media (hover: hover) { .week-lanes :global(button.grip:hover) { color: var(--ink); } }
  .week-lanes.dragging { cursor: grabbing; user-select: none; }
  .week-lanes.dragging :global(button.grip) { cursor: grabbing; }
  /* The lane in hand floats over the others, opaque, with the float shadow. */
  .week-lanes :global(.lane.lifted) { position: relative; z-index: 1; border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--shadow-float); }
  .week-lanes :global(.lane.lifted button.grip) { color: var(--ink); }
  /* One clean rounded slab: its rows' top lines would run square past the round corners. */
  .week-lanes :global(.lane.lifted > *) { border-top-color: transparent; }
