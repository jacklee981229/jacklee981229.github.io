---
// About: who Jack is, in a few sections. The words (the intro, the work timeline, the tools) are in
// src/content/pages/about.md; the things he likes come from the Collection and the Travel Map's own lists, and the
// links from src/site.ts. The site's activity (Now, Most Popular, the changelog list) belongs to the home page.
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import PageTop from '../components/PageTop.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { SITE } from '../site';
import { formatDate } from '../lib/dates.js';
import { pictureOf } from '../lib/shelves.js';
import { pictures } from '../lib/shelf-pictures';
import '../styles/prose.css';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('The About page text is missing: add src/content/pages/about.md.');
const { Content } = await render(about);
const { work, tools } = about.data;

/** How many of the Collection's best-rated items About shows. */
const FAVOURITES = 5;
const shelves = (await getCollection('shelves')).sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity));
const favourites = shelves
  .flatMap((shelf) => shelf.data.items.map((item) => ({ item, shelf: shelf.id, picture: pictureOf(pictures, shelf.id, item)?.default })))
  .filter((f) => f.picture)
  // Best rated first; equal ratings keep the Collection's own order.
  .sort((a, b) => b.item.stars - a.item.stars)
  .slice(0, FAVOURITES);
const places = (await getEntry('travel', 'visited'))?.data.visited ?? [];
const started = new Date(`${SITE.started}T00:00:00+08:00`);
---
<Base title={about.data.title} description="About Jack Lee and this site.">
  <div class="wrap page">
    <PageTop tone="about" icon="user" title={about.data.title} />
    <div class="about">
      <div class="card intro"><div class="prose"><Content /></div></div>

      {work.length > 0 && (
        <section class="card work" aria-labelledby="work">
          <h2 id="work"><Icon name="code" />Work</h2>
          <ol class="jobs">
            {work.map((job) => (
              <li><span class="job"><span class="role">{job.role}</span><span class="place">{job.place}</span></span><span class="years">{job.years}</span></li>
            ))}
          </ol>
        </section>
      )}

      {tools.length > 0 && (
        <section class="card work" aria-labelledby="tools">
          <h2 id="tools"><Icon name="wrench" />What I work with</h2>
          {tools.map((group) => (
            <div class="group">
              <h3>{group.group}</h3>
              <ul class="chips">{group.items.map((item) => <li>{item}</li>)}</ul>
            </div>
          ))}
        </section>
      )}

      <section class="card likes" aria-labelledby="likes">
        <h2 id="likes"><Icon name="star" />Things I like</h2>
        {favourites.length > 0 && (
          <a class="covers" href="/collections/" aria-label="My Collection: films and games I rate highly">
            {favourites.map(({ item, picture }) => picture && <Image src={picture} alt={item.name} title={item.name} width={160} />)}
          </a>
        )}
        <p class="more"><a href="/collections/">My Collection</a>: films and games, with my stars.</p>
        {places.length > 0 && (
          <p class="more"><a href="/travel/">My Travel Map</a>: {places.length === 1 ? '1 place' : `${places.length} places`} so far, {places.join(', ')}.</p>
        )}
      </section>

      <section class="card find" aria-labelledby="find-me">
        <h2 id="find-me"><Icon name="link" />Find me</h2>
        <ProfileLinks labels />
      </section>

      <section class="card site" aria-labelledby="this-site">
        <h2 id="this-site"><Icon name="home" />This site</h2>
        <p class="more">Running since {formatDate(started)}, first on Hexo, rebuilt with Astro in 2026.</p>
        <p class="more">What's changed lately is in the <a href="/changelog/">Changelog</a>.</p>
      </section>
    </div>
  </div>
</Base>

<style>
  /* Every part a card, as on the home page: the intro across the top, the rest two by two, each in the colour of
     what it's about (tokens.css), with white words. */
  .about { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .card { padding: var(--space-6); border-radius: var(--radius-2xl); background: var(--surface); box-shadow: var(--shadow-card); }
  .work, .likes, .find, .site { --focus: var(--on-colour); background: linear-gradient(150deg, var(--from), var(--to)); box-shadow: none; color: var(--on-colour); }
  .work { --from: var(--about-work-from); --to: var(--about-work-to); }
  .likes { --from: var(--about-likes-from); --to: var(--about-likes-to); }
  .find { --from: var(--about-links-from); --to: var(--about-links-to); }
  .site { --from: var(--about-site-from); --to: var(--about-site-to); }
  .intro { grid-column: 1 / -1; }
  .intro .prose { max-width: 44rem; }
  .intro :global(.prose > :first-child) { margin-top: 0; }
  .intro :global(.prose > :last-child) { margin-bottom: 0; }
  h2 { display: flex; align-items: center; gap: var(--space-3); margin: 0 0 var(--space-4); font-size: var(--text-lg); font-weight: 900; letter-spacing: -0.02em; }
  h2 :global(.icon) { width: 22px; height: 22px; stroke-width: 2.2; }
  h3 { margin: 0 0 var(--space-2); color: var(--on-colour-soft); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  .jobs { display: grid; gap: var(--space-3); margin: 0; padding: 0; list-style: none; }
  /* The years beside the job, or under it where the card is too narrow for both on one line. */
  .jobs li { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 var(--space-3); }
  .job { display: grid; }
  .role { font-weight: 800; }
  .place, .years { color: var(--on-colour-soft); }
  .years { font-size: var(--text-sm); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .group + .group { margin-top: var(--space-4); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .chips li { padding: 0.25rem 0.75rem; border-radius: var(--radius-pill); background: var(--on-colour-chip); font-size: var(--text-sm); font-weight: 700; }
  .covers { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-3); margin-bottom: var(--space-4); }
  .covers :global(img) { width: 100%; height: auto; border-radius: var(--radius-art); box-shadow: var(--shadow-cover); transition: transform 0.2s ease; }
  .covers:hover :global(img) { transform: translateY(-3px); }
  .more { margin: 0; line-height: 1.6; }
  .more + .more { margin-top: var(--space-2); }
  /* Your links on the colour: the names on dark-tinted pills, each tile in its own colour. */
  .find :global(.links.labels a) { background: var(--on-colour-chip); color: var(--on-colour); }

  @media (max-width: 719px) {
    .about { grid-template-columns: minmax(0, 1fr); }
    .card { padding: var(--space-5); }
  }
</style>
