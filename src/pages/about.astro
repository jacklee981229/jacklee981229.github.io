---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import { SITE } from '../site';
import '../styles/prose.css';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('The About page text is missing: add src/content/pages/about.md.');
const { Content } = await render(about);
---
<Base title={about.data.title} description="About Jack Lee and this site.">
  <div class="wrap page">
    <h1 class="page-title">{about.data.title}</h1>
    <!-- "About Me" comes from src/site.ts (the same role and links as the home page's profile card); the rest is about.md. -->
    <div class="prose text">
      <h2 id="about-me">About Me</h2>
      <p class="role">{SITE.role}</p>
      <ProfileLinks labels />
      <Content />
    </div>
  </div>
</Base>

<style>
  .text { max-width: 40rem; margin-top: var(--space-6); }
  .role { margin: 0 0 var(--space-4); font-size: var(--text-lg); font-weight: 700; letter-spacing: -0.01em; }
</style>
