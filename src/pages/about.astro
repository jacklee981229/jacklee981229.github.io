---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import '../styles/prose.css';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('The About page text is missing: add src/content/pages/about.md.');
const { Content } = await render(about);
---
<Base title={about.data.title} description="About Jack Lee and this site.">
  <div class="wrap page">
    <h1 class="page-title">{about.data.title}</h1>
    <div class="prose text"><Content /></div>
  </div>
</Base>

<style>
  .text { max-width: 40rem; margin-top: var(--space-6); }
</style>
