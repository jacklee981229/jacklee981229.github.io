---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Go from '../components/Go.astro';
import Icon from '../components/Icon.astro';
import MiniCard from '../components/MiniCard.astro';
import MoreBand from '../components/MoreBand.astro';
import PostScripts from '../components/PostScripts.astro';
import ProfileCard from '../components/ProfileCard.astro';
import SiteInfo from '../components/SiteInfo.astro';
import Toc from '../components/Toc.astro';
import '../styles/prose.css';
import { SITE } from '../site';
import { formatDate, isoDay } from '../lib/dates.js';
import { NEW_TAB } from '../lib/links.js';
import { checkThese, lastUpdated, neighbours, RESERVED_SLUGS, tagCounts, topicCounts } from '../lib/posts.js';
import { TOPICS, topicOf } from '../lib/topics.js';
import { coverOf, listedPosts, pagePosts, postUrl, summaryOf, tagUrl, type Post } from '../lib/collections';
import { EXPERIMENTS } from '../lib/lab/tools.js';

export async function getStaticPaths() {
  const posts = await pagePosts();
  for (const post of posts) {
    if (RESERVED_SLUGS.includes(post.id)) throw new Error(`Post folder "${post.id}" clashes with the site's /${post.id}/ page. Rename the folder in src/content/posts.`);
    if (!/^[a-z0-9_-]+$/.test(post.id)) throw new Error(`Post folder "${post.id}" can only use lowercase letters, numbers, - and _, because it becomes the address /${post.id}/.`);
  }
  // The Lab's games have their pages under /lab/game/ (src/pages/lab/game/[slug].astro).
  return posts.filter((post) => !EXPERIMENTS.includes(post.id)).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const listed = await listedPosts();
const { Content, headings } = await render(post);
const { newer, older } = neighbours(listed, post);
const more = checkThese(listed, post);
const topic = topicOf(data.topic);
const showUpdated = data.updated && isoDay(data.updated) !== isoDay(data.date);
---
<Base title={data.title} description={summaryOf(post)} image={coverOf(post)} topic={{ id: topic.id, name: topic.name }} article={{ published: data.date, updated: data.updated, tags: data.tags }}>
  <article class="wrap post" style={`--c: var(--lane-${data.topic})`} data-pagefind-body={data.hidden ? undefined : ''}>
    <header>
      <p class="topic" data-pagefind-ignore><Go href={`/writing/#${data.topic}`}>{topic.name}</Go></p>
      <h1 class="title">{data.title}</h1>
      <div class="meta" data-pagefind-ignore>
        <span>Published <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></span>
        {showUpdated && data.updated && <span>Updated <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time></span>}
        <!-- The post's visits from GoatCounter (src/lib/visits.js), shown once the number has come, on the live site. -->
        <span class="views" data-visits={Astro.url.pathname} hidden><span data-visits-number></span> views</span>
      </div>
      <div class="actions" data-pagefind-ignore>
        {data.tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {data.tags.map((tag) => <li><a href={tagUrl(tag)}>{tag}</a></li>)}
          </ul>
        )}
        <button type="button" class="copy-link" data-copy-link><Icon name="link" /><span data-label>Copy link</span></button>
      </div>
    </header>

    <Cover post={post} variant="banner" />

    <div class="grid">
      <Toc headings={headings} />
      <div class="prose">
        {topic.legacy && <p class="legacy" data-pagefind-ignore>{topic.legacy}</p>}
        <Content />
      </div>
    </div>

    <footer class="foot" data-pagefind-ignore>
      {data.license && (
        <p class="license">Written by {SITE.author}. Licensed under <a href={SITE.license.url} {...NEW_TAB}>{SITE.license.name}</a> unless the post says otherwise.</p>
      )}
      {!data.hidden && (
        <nav class="older-newer" aria-label="Newer and older posts">
          <div>
            <span class="label">Newer post</span>
            {newer ? <Go href={postUrl(newer)}>{newer.data.title}</Go> : <span class="none">None yet</span>}
          </div>
          <div>
            <span class="label">Older post</span>
            {older ? <Go href={postUrl(older)}>{older.data.title}</Go> : <span class="none">None</span>}
          </div>
        </nav>
      )}
    </footer>
  </article>

  <MoreBand title="Check these too!" note="More posts from Jack's Space.">
    {more.length > 0 ? (
      <ul class="related">{more.map((p) => <MiniCard post={p} />)}</ul>
    ) : (
      <p class="empty">No other posts yet.</p>
    )}
    <section class="author" aria-label="About the author">
      <ProfileCard posts={listed.length} topics={topicCounts(listed, TOPICS).filter((t) => t.count > 0).length} tags={tagCounts(listed).length} />
      <SiteInfo newestPost={lastUpdated(listed)} />
    </section>
  </MoreBand>

  <PostScripts />
</Base>

<style>
  /* The topic's lane runs down the left of the whole post, from the dot beside the topic name. */
  .post { --node: 12px; --stroke: 2.5px; --post-pad: clamp(2rem, 5vw, 3.5rem); position: relative; margin-bottom: var(--space-8); padding-top: var(--post-pad); padding-left: calc(var(--gutter) + 2.25rem); }
  .post::before { content: ''; position: absolute; top: calc(var(--post-pad) + 0.75rem); bottom: 0; left: calc(var(--gutter) + var(--node) / 2 - var(--stroke) / 2); width: var(--stroke); background: var(--c); }
  .topic { position: relative; margin: 0 0 var(--space-3); color: var(--c); font-size: var(--text-ui); font-weight: 700; }
  .topic::before { content: ''; position: absolute; top: 0.75rem; left: -2.25rem; width: var(--node); height: var(--node); margin-top: calc(var(--node) / -2); border-radius: 50%; background: var(--c); }
  .title { max-width: 22ch; margin: 0; font-size: var(--text-2xl); font-weight: var(--display-weight); line-height: 1.04; letter-spacing: calc(var(--display-tracking) * 0.8); text-wrap: balance; }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); margin-top: 1.25rem; color: var(--muted); font-size: var(--text-ui); }
  .meta time, .views span { color: var(--ink); font-weight: 650; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); margin-top: var(--space-4); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .tags a { display: inline-block; padding: var(--space-1) var(--space-3); border: 1px solid var(--rule); border-radius: var(--radius-pill); font-size: 0.8125rem; font-weight: 650; text-decoration: none; }
  .tags a:hover { border-color: var(--c); }
  /* A button, not a link: under the mouse it takes the tinted pill of the site's standalone links, without the arrow. */
  .copy-link { display: inline-flex; align-items: center; gap: 0.375rem; margin: 0 -0.625rem; padding: 0.375rem 0.625rem; border: 0; border-radius: var(--radius-pill); background: none; color: var(--ink); font-size: var(--text-sm); font-weight: 650; cursor: pointer; transition: background-color 0.2s ease; }
  .copy-link:hover { background: var(--wash); }
  .copy-link :global(.icon) { width: 18px; height: 18px; }

  .grid { display: grid; grid-template-columns: minmax(0, 40rem) minmax(11rem, 15rem); justify-content: space-between; gap: var(--space-8); margin-top: 2.5rem; }
  .grid .prose { grid-row: 1; grid-column: 1; }

  /* The note on posts about something the site no longer runs on (a topic's `legacy` in src/lib/topics.js). */
  .legacy { margin: 0 0 var(--space-5); padding: var(--space-3) var(--space-4); border: 1px solid var(--rule); border-radius: var(--radius-md); background: var(--wash); color: var(--muted); font-size: var(--text-sm); line-height: 1.55; }
  .foot { max-width: 40rem; margin-top: var(--space-7); padding-top: var(--space-5); border-top: 1px solid var(--rule); }
  .license { margin: 0 0 var(--space-5); color: var(--muted); font-size: var(--text-sm); }
  .older-newer { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  /* Room at the sides for a link's arrow (.go in global.css) to slide out inside the box. */
  .older-newer > div { display: flex; flex-direction: column; gap: var(--space-1); padding: 0.875rem var(--space-5); border: 1px solid var(--rule); border-radius: var(--radius-md); background: var(--surface); }
  .older-newer > div:last-child { align-items: flex-end; text-align: right; }
  .label { color: var(--muted); font-size: 0.8125rem; }
  .older-newer .go { font-size: 1.0625rem; font-weight: 650; }
  .none { color: var(--muted); }

  .related { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .empty { margin: 0; color: var(--muted); }
  .author { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: var(--space-7); margin-top: var(--space-6); padding: 1.25rem; border: 1px solid var(--rule); border-radius: var(--radius-lg); background: var(--surface); font-size: var(--text-ui); }

  @media (max-width: 1099px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
    .grid .prose { grid-row: auto; }
  }
  @media (max-width: 719px) {
    .post { padding-left: calc(var(--gutter) + 1.5rem); }
    .topic::before { left: -1.5rem; }
    .older-newer { grid-template-columns: minmax(0, 1fr); }
    .older-newer > div:last-child { align-items: flex-start; text-align: left; }
    .author { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  }
</style>
