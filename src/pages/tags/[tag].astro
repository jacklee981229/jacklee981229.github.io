---
import Base from '../../layouts/Base.astro';
import PageTop from '../../components/PageTop.astro';
import PostList from '../../components/PostList.astro';
import { tagCounts } from '../../lib/posts.js';
import { slugify } from '../../lib/text.js';
import { listedPosts, type Post } from '../../lib/collections';

export async function getStaticPaths() {
  const posts = await listedPosts();
  return tagCounts(posts).map(({ tag }) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---
<Base title={`Tag: ${tag}`} description={`Posts tagged “${tag}”.`}>
  <div class="wrap page">
    <PageTop tone="writing" icon="hash" title={tag} lead={`${posts.length === 1 ? '1 post' : `${posts.length} posts`} tagged “${tag}”.`} />
    <div class="list"><PostList posts={posts} /></div>
  </div>
</Base>

<style>
  /* The posts on a card, like a topic's on Writing. */
  .list { max-width: 44rem; padding: var(--space-2) var(--space-5) var(--space-3); border-radius: var(--radius-2xl); background: var(--surface); box-shadow: var(--shadow-card); }
  .list :global(li:last-child a) { border-bottom: 0; }
</style>
