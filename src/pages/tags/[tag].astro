---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { tagCounts } from '../../lib/posts.js';
import { slugify } from '../../lib/text.js';
import { listedPosts, type Post } from '../../lib/collections';

export async function getStaticPaths() {
  const posts = await listedPosts();
  return tagCounts(posts).map(({ tag }) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---
<Base title={`Tag: ${tag}`} description={`Posts tagged “${tag}”.`}>
  <div class="wrap page">
    <p class="up"><a href="/tags/">All tags</a></p>
    <h1 class="page-title">{tag}</h1>
    <p class="lede">{posts.length === 1 ? '1 post' : `${posts.length} posts`} tagged “{tag}”.</p>
    <div class="list"><PostList posts={posts} /></div>
  </div>
</Base>

<style>
  .up { margin: 0 0 var(--space-3); font-size: var(--text-ui); }
  .up a { color: var(--muted); }
  .list { max-width: 44rem; margin-top: var(--space-6); }
</style>
