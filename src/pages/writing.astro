---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { topicCounts } from '../lib/posts.js';
import { TOPICS } from '../lib/topics.js';
import { listedPosts } from '../lib/collections';

const posts = await listedPosts();
const topics = topicCounts(posts, TOPICS).filter((t) => t.count > 0);
---
<Base title="Writing" description="Posts grouped by topic.">
  <div class="wrap page">
    <h1 class="page-title">Writing</h1>
    <p class="lede">Posts grouped by topic.</p>
    {topics.length === 0 && <p class="empty">No posts yet.</p>}
    {topics.map((t) => (
      <section class="topic" id={t.id} style={`--c: var(--lane-${t.id})`} aria-labelledby={`topic-${t.id}`}>
        <h2 id={`topic-${t.id}`}><span class="dot" aria-hidden="true" />{t.name} <span class="count">{t.count}</span></h2>
        <PostList posts={posts.filter((p) => p.data.topic === t.id)} showTopic={false} />
      </section>
    ))}
  </div>
</Base>

<style>
  .topic { max-width: 44rem; margin-top: var(--space-7); scroll-margin-top: var(--space-5); }
  h2 { display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-2); font-size: var(--text-lg); font-weight: 750; }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--c); }
  .count { color: var(--muted); font-size: var(--text-ui); font-weight: 600; font-variant-numeric: tabular-nums; }
</style>
