---
// Jack's projects, with the showcase video on top in a player of the site's own: its progress bar is cut into the
// projects' chapters, each named above its stretch, and a name jumps there. The video is made in its own project,
// showcase-video (Remotion), and copied into public/videos; the cover and the cards' pictures are frames of it.
import { Image } from 'astro:assets';
import PageTop from '../components/PageTop.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Go from '../components/Go.astro';
import { newTab } from '../lib/links.js';
import cover from '../assets/projects/cover.webp';
import jacksSpace from '../assets/projects/jacks-space.webp';
import usage from '../assets/projects/usage.webp';
import jarvis from '../assets/projects/jarvis.webp';
import studio from '../assets/projects/studio.webp';
import todo from '../assets/projects/todo.webp';

const LEAD = 'Things I built with Claude Code, from this site to the little tools on my desktop.';
const GITHUB = 'https://github.com/jacklee981229';
/** The video's length in seconds, for the cover and the controls before it has loaded. */
const LENGTH = 38.98;

/** Where the video's closing starts, so the last chapter ends there. */
const CLOSING = 35.97;

// `at` is where the project's chapter starts in the video, in seconds, and `tone` its colour there.
// shortcut: `at` and CLOSING are copied from SCENES in showcase-video's src/Showcase.tsx (a scene's first frame / 30);
// change both together, and generate them from the video if it changes often.
const PROJECTS = [
  { name: "Jack's Space", line: 'This site: writing, a Lab of tools, games and little worlds, my collections and travels.', tags: ['Astro', 'Cloudflare Workers'], kind: 'world', picture: jacksSpace, code: `${GITHUB}/jacklee981229.github.io`, wide: true, at: 2.6, tone: '--projects-top-from' },
  { name: 'Claude usage widget', line: 'A desktop widget for my Claude plan: the 5-hour window and the weekly limit.', tags: ['Python', 'Claude Code mod'], kind: 'preview', picture: usage, code: `${GITHUB}/claude-usage-widget`, wide: true, at: 18.33, tone: '--about-top-from' },
  { name: "Jack's Jarvis", line: 'A small, safe Windows agent: ask, it picks a tool, you see what happened.', tags: ['TypeScript', 'Voice'], kind: 'misc', picture: jarvis, at: 22.37, tone: '--lab-from' },
  { name: 'Media Studio', line: 'Pick the keepers from a trip, give them one look, export for the site.', tags: ['Python', 'FFmpeg'], kind: 'text', picture: studio, at: 26.4, tone: '--travel-top-from' },
  { name: 'To-do widget', line: 'My to-do list on the desktop. Claude adds to it and ticks it off.', tags: ['Python'], kind: 'effect', picture: todo, at: 30.43, tone: '--writing-top-from' },
] as const;
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
/** The length as people read it: 38.98 s is 0:39. */
const total = clock(Math.round(LENGTH));
/** A stretch of the progress bar, as left and width in % of the video. */
const span = (from: number, to: number) => `left: ${(from / LENGTH) * 100}%; width: calc(${((to - from) / LENGTH) * 100}% - 3px)`;
// The chapters, and the opening and closing either side of them.
const chapters = PROJECTS.map((p, i) => ({ ...p, n: String(i + 1).padStart(2, '0'), to: PROJECTS[i + 1]?.at ?? CLOSING }));
const stretches = [{ from: 0, to: PROJECTS[0].at, tone: '' }, ...chapters.map((c) => ({ from: c.at, to: c.to, tone: c.tone })), { from: CLOSING, to: LENGTH, tone: '' }];
const stretchStyle = (s: (typeof stretches)[number]) => `${span(s.from, s.to)}${s.tone ? `; --c: var(${s.tone})` : ''}`;
---
<Base title="Jack's Projects" description={LEAD}>
  <div class="wrap page">
    <PageTop tone="projects" icon="code" title="Jack's Projects" lead={LEAD} />

    <section class="reel" aria-label="Showcase video" data-reel data-length={LENGTH}>
      <video playsinline preload="metadata" width="1920" height="1080" src="/videos/showcase.mp4"></video>
      <button type="button" class="cover" aria-label={`Play the video, ${total}`}>
        <Image src={cover} alt="" widths={[960, 1600]} sizes="(min-width: 1200px) 71rem, 100vw" />
        <span class="go"><span class="big"><Icon name="play" /></span><span class="label">Watch my projects · {total}</span></span>
      </button>
      <div class="controls">
        <ol class="chapters" aria-label="Jump to a project in the video">
          {chapters.map((c) => (
            <li style={span(c.at, c.to)}><button type="button" class="chapter" data-at={c.at} aria-label={`Jump to ${c.name}`}><span class="n">{c.n}</span> {c.name}</button></li>
          ))}
        </ol>
        <div class="track" role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax={Math.round(LENGTH)} aria-valuenow="0" aria-valuetext="0:00">
          {[false, true].map((lit) => (
            <span class:list={['segs', { played: lit }]}>{stretches.map((s, i) => <span class:list={['seg', { lit, tone: s.tone }]} data-seg={i - 1} style={stretchStyle(s)}></span>)}</span>
          ))}
          <span class="knob"></span>
        </div>
        <div class="row">
          <button type="button" class="btn play" aria-label="Play"><Icon name="play" class="when-paused" /><Icon name="pause" class="when-playing" /></button>
          <button type="button" class="btn mute" aria-label="Mute"><Icon name="sound" class="when-sound" /><Icon name="sound-off" class="when-muted" /></button>
          <span class="time">0:00 / {total}</span>
          <button type="button" class="btn full" aria-label="Full screen"><Icon name="expand" /></button>
        </div>
      </div>
    </section>

    <ul class="projects">
      {PROJECTS.map((p) => (
        <li class:list={['project', p.kind, { wide: 'wide' in p && p.wide }]}>
          <span class="picture"><Image src={p.picture} alt="" widths={[640, 1280]} sizes="(min-width: 720px) 40rem, 100vw" /></span>
          <span class="body">
            <span class="name">{p.name}</span>
            <span class="line">{p.line}</span>
            <span class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</span>
            <span class="links">
              {'code' in p ? <Go href={p.code} {...newTab()}><Icon name="github" />Code</Go> : <span class="private">Not on GitHub yet</span>}
            </span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</Base>

<script>
  const reel = document.querySelector<HTMLElement>('[data-reel]')!;
  const video = reel.querySelector('video')!;
  const track = reel.querySelector<HTMLElement>('.track')!;
  const controls = reel.querySelector<HTMLElement>('.controls')!;
  const knob = reel.querySelector<HTMLElement>('.knob')!;
  const time = reel.querySelector<HTMLElement>('.time')!;
  const play = reel.querySelector<HTMLButtonElement>('.play')!;
  const mute = reel.querySelector<HTMLButtonElement>('.mute')!;
  const chapters = [...reel.querySelectorAll<HTMLButtonElement>('.chapter')];
  const segs = [...reel.querySelectorAll<HTMLElement>('.seg')];
  const starts = chapters.map((c) => Number(c.dataset.at));
  const length = () => (Number.isFinite(video.duration) ? video.duration : Number(reel.dataset.length));
  const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

  const start = () => { reel.classList.add('started'); video.play().catch(() => {}); };
  const toggle = () => (video.paused ? start() : video.pause());
  const seek = (t: number) => { video.currentTime = Math.max(0, Math.min(length(), t)); reel.classList.add('started'); draw(); };

  function draw() {
    const t = video.currentTime, d = length(), share = `${(t / d) * 100}%`;
    // The played part of the bar shows the lit copy of the stretches, cut off at the playhead.
    track.style.setProperty('--played', share); knob.style.left = share;
    time.textContent = `${clock(t)} / ${clock(Math.round(d))}`;
    track.setAttribute('aria-valuenow', String(Math.round(t))); track.setAttribute('aria-valuetext', clock(t));
    // The chapter playing: the last one started, once the video has.
    const k = reel.classList.contains('started') ? starts.reduce((last, at, i) => (t >= at - 0.05 ? i : last), -1) : -1;
    chapters.forEach((c, i) => c.classList.toggle('on', i === k));
    segs.forEach((g) => g.classList.toggle('on', Number(g.dataset.seg) === k));
  }

  video.addEventListener('timeupdate', draw);
  video.addEventListener('play', () => { reel.classList.add('playing'); play.setAttribute('aria-label', 'Pause'); });
  video.addEventListener('pause', () => { reel.classList.remove('playing'); play.setAttribute('aria-label', 'Play'); });
  // At the end it goes back to its cover.
  video.addEventListener('ended', () => { video.currentTime = 0; reel.classList.remove('started'); draw(); });
  video.addEventListener('volumechange', () => { reel.classList.toggle('muted', video.muted); mute.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute'); });
  video.addEventListener('click', toggle);
  reel.querySelector('.cover')!.addEventListener('click', start);
  play.addEventListener('click', toggle);
  mute.addEventListener('click', () => { video.muted = !video.muted; });
  reel.querySelector('.full')!.addEventListener('click', () => {
    (document.fullscreenElement ? document.exitFullscreen() : reel.requestFullscreen?.())?.catch(() => {});
  });
  chapters.forEach((c, i) => c.addEventListener('click', () => { seek(starts[i]); start(); }));

  // The track: a press jumps there and a drag follows; the arrows step 5 seconds.
  const at = (e: PointerEvent) => { const r = track.getBoundingClientRect(); return ((e.clientX - r.left) / r.width) * length(); };
  track.addEventListener('pointerdown', (e) => { track.setPointerCapture(e.pointerId); track.classList.add('dragging'); seek(at(e)); });
  track.addEventListener('pointermove', (e) => { if (track.classList.contains('dragging')) seek(at(e)); });
  track.addEventListener('pointerup', () => track.classList.remove('dragging'));

  // While it plays, the controls and the pointer rest out of sight once the pointer is still, as in full screen,
  // unless the pointer is on the controls or the keyboard is in them. A clicked button keeps focus without
  // :focus-visible, so a click doesn't hold them up.
  let rest = 0;
  const wake = () => {
    reel.classList.remove('resting'); clearTimeout(rest);
    rest = window.setTimeout(() => (controls.matches(':hover') || controls.querySelector(':focus-visible') ? wake() : reel.classList.add('resting')), 2200);
  };
  reel.addEventListener('pointermove', wake);
  reel.addEventListener('focusin', wake);
  reel.addEventListener('keydown', (e) => {
    const key = e.key.toLowerCase();
    if (key === ' ' || key === 'k') { if (e.target instanceof HTMLButtonElement && !e.target.matches('.play')) return; e.preventDefault(); toggle(); }
    else if (key === 'arrowright') { e.preventDefault(); seek(video.currentTime + 5); }
    else if (key === 'arrowleft') { e.preventDefault(); seek(video.currentTime - 5); }
    else if (key === 'm') video.muted = !video.muted;
    else if (key === 'f') reel.querySelector<HTMLButtonElement>('.full')!.click();
    else return;
    wake();
  });
  draw();
</script>

<style>
  /* The player: the video on its card, a cover with a big play button until it starts, then the site's own controls. */
  .reel { position: relative; overflow: hidden; margin-bottom: var(--space-7); border-radius: var(--radius-2xl); background: var(--surface); box-shadow: var(--shadow-card); color: var(--on-colour); }
  .reel video { display: block; width: 100%; height: auto; background: var(--surface); }
  .reel:fullscreen { border-radius: 0; display: grid; place-items: center; background: var(--surface); }
  .reel:fullscreen video { height: 100%; object-fit: contain; }

  .cover { position: absolute; inset: 0; display: grid; place-items: center; padding: 0; border: 0; background: none; color: var(--on-colour); cursor: pointer; transition: opacity var(--motion-soft) ease; -webkit-tap-highlight-color: transparent; }
  .cover :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cover::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at center, transparent, var(--on-colour-glass)); }
  .go { position: relative; z-index: 1; display: grid; justify-items: center; gap: var(--space-3); }
  .big { display: grid; place-items: center; width: clamp(4.5rem, 10vw, 7rem); aspect-ratio: 1; border-radius: 50%; background: var(--on-colour); color: var(--projects-top-from); box-shadow: var(--shadow-card); transition: transform var(--motion-soft) var(--ease-release); }
  .big :global(.icon) { width: 76%; height: 76%; stroke-width: 2; }
  .label { font-size: var(--text-lg); font-weight: 800; text-shadow: 0 2px 8px var(--on-colour-glass); }
  .cover:active .big { transform: scale(0.96); transition-duration: var(--motion-press); transition-timing-function: ease; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .cover:hover .big, .cover:focus-visible .big { transform: scale(1.06); }
  }
  .cover:focus-visible { outline: none; }
  .cover:focus-visible .big { outline: 3px solid var(--on-colour); outline-offset: 4px; }
  .started .cover { opacity: 0; pointer-events: none; }

  .controls { position: absolute; left: 0; right: 0; bottom: 0; display: grid; gap: var(--space-1); padding: var(--space-7) var(--space-4) var(--space-2); background: linear-gradient(transparent, var(--backdrop-dark) 55%); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity var(--motion-quick) ease, visibility var(--motion-quick); }
  /* Out of the tab order too until it starts: hidden controls would take an invisible focus. */
  .started .controls { opacity: 1; visibility: visible; pointer-events: auto; }
  .started.playing.resting .controls { opacity: 0; pointer-events: none; }
  .started.playing.resting { cursor: none; }
  .row { display: flex; align-items: center; gap: var(--space-1); }
  .btn { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--on-colour); cursor: pointer; transition: background-color var(--motion-quick) ease; }
  .btn:hover { background: var(--on-colour-faint); }
  .btn :global(.icon) { width: 1.35rem; height: 1.35rem; }
  .reel :global(.when-playing), .reel :global(.when-muted) { display: none; }
  .playing :global(.when-playing), .muted :global(.when-muted) { display: block; }
  .playing :global(.when-paused), .muted :global(.when-sound) { display: none; }
  .time { margin: 0 auto 0 var(--space-1); font-family: var(--font-code); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .reel :focus-visible { outline: 2px solid var(--on-colour); outline-offset: 2px; }

  /* The chapters, over the bar: each project's name sits on its stretch and jumps to its start; the one playing is
     bright, and its stretch thicker. */
  .chapters { position: relative; height: 2.75rem; margin: 0; padding: 0; list-style: none; }
  .chapters li { position: absolute; bottom: 0; display: flex; }
  .chapter { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; max-width: 100%; padding: 0.125rem var(--space-2); border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--on-colour); opacity: 0.72; font-family: inherit; font-size: var(--text-sm); font-weight: 800; line-height: 1.2; text-align: left; cursor: pointer; transition: opacity var(--motion-quick) ease, background-color var(--motion-quick) ease; -webkit-tap-highlight-color: transparent; }
  .chapter .n { font-family: var(--font-code); font-weight: 500; }
  .chapter:hover, .chapter:focus-visible { opacity: 1; background: var(--on-colour-faint); }
  .chapter.on { opacity: 1; }

  /* The bar: the opening, each chapter in its colour and the closing, faint ahead of the playhead and full behind it
     (a lit copy of the stretches, cut off at --played). */
  .track { position: relative; height: 1.125rem; cursor: pointer; touch-action: none; }
  .segs { position: absolute; inset: 0; }
  .played { clip-path: inset(0 calc(100% - var(--played, 0%)) 0 0); }
  .seg { position: absolute; top: 0.4375rem; height: 0.25rem; border-radius: var(--radius-pill); background: var(--on-colour-faint); transition: top var(--motion-quick) ease, height var(--motion-quick) ease; }
  .seg.tone { background: color-mix(in srgb, var(--c) 50%, transparent); }
  .seg.lit { background: var(--on-colour); }
  .seg.lit.tone { background: var(--c); }
  .seg.on { top: 0.375rem; height: 0.375rem; }
  .knob { position: absolute; top: 0.1875rem; width: 0.75rem; height: 0.75rem; margin-left: -0.375rem; border-radius: 50%; background: var(--on-colour); transform: scale(0); transition: transform var(--motion-quick) ease; }
  .track:hover .knob, .track.dragging .knob, .track:focus-visible .knob { transform: scale(1); }

  .projects { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .project { display: flex; flex-direction: column; overflow: hidden; border-radius: var(--radius-xl); background: var(--base); color: var(--on-colour); }
  .wide { grid-column: 1 / -1; flex-direction: row; }
  .text { --from: var(--kind-text-from); --to: var(--kind-text-to); --base: var(--kind-text-base); }
  .preview { --from: var(--kind-preview-from); --to: var(--kind-preview-to); --base: var(--kind-preview-base); }
  .misc { --from: var(--kind-misc-from); --to: var(--kind-misc-to); --base: var(--kind-misc-base); }
  .effect { --from: var(--kind-effect-from); --to: var(--kind-effect-to); --base: var(--kind-effect-base); }
  .world { --from: var(--kind-world-from); --to: var(--kind-world-to); --base: var(--kind-world-base); }

  /* A project's picture is its window from the video on a clear background (900 × 760, 16:9 on a wide card), so the
     card's own colours show behind it. */
  .picture { display: block; aspect-ratio: 900 / 760; background: linear-gradient(150deg, var(--from), var(--to)); }
  .wide .picture { flex: 0 0 58%; aspect-ratio: 16 / 9; }
  .picture :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  .body { display: grid; align-content: start; gap: var(--space-2); padding: var(--space-4); }
  .wide .body { align-content: center; padding: var(--space-6); }
  .name { font-size: var(--text-lg); font-weight: 900; letter-spacing: -0.02em; }
  .wide .name { font-size: var(--text-xl); }
  .line { color: var(--on-colour-soft); font-size: var(--text-sm); line-height: 1.45; }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-1); }
  .tag { padding: 0.125rem 0.625rem; border-radius: var(--radius-pill); background: var(--on-colour-chip); font-family: var(--font-code); font-size: var(--text-xs); }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-top: var(--space-2); }
  .links :global(.go) { display: inline-flex; align-items: center; gap: var(--space-1); min-height: 2.25rem; padding: 0 var(--space-3); border-radius: var(--radius-pill); background: var(--on-colour); color: var(--base); font-size: var(--text-sm); font-weight: 800; }
  .links :global(.icon) { width: 16px; height: 16px; }
  .private { color: var(--on-colour-soft); font-size: var(--text-sm); }

  @media (max-width: 719px) {
    /* Too narrow for the names: the coloured stretches stay. */
    .chapters { display: none; }
    .projects { grid-template-columns: 1fr; }
    .wide { flex-direction: column; }
    .wide .body { padding: var(--space-4); }
  }
</style>
