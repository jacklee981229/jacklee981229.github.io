---
// Jack's Train World, the second Little World (docs/plan/todo/little-worlds-trains.md), laid out like the Town's
// page. Hidden until it goes live (TR3): out of search engines, the sitemap and the Lab home, and not in WORLDS.
import Base from '../../../layouts/Base.astro';
import EffectStage from '../../../components/EffectStage.astro';
import LabHeader from '../../../components/LabHeader.astro';
import LabMore from '../../../components/LabMore.astro';

const title = "Jack's Train World";
const description = 'A train network that runs by itself: when a drop-off runs low, a train brings it a load from the pickup of its colour.';
---
<Base title={title} description={description} area="lab" noindex>
  <div class="wrap top">
    <LabHeader compact title={title} description={description} back="/lab/#little-worlds" />
  </div>
  <EffectStage slug="trains" world label="A train network seen from above: a double-track main line round the edge, with branches to stations and a depot." />
  <LabMore current="trains" />
</Base>

<style>
  /* Less room above than other pages: the network below wants the height. */
  .top { padding-top: var(--space-5); }
</style>
