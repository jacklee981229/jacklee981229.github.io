---
// One Little World (WORLDS in lab/tools.js), laid out like an effect's page: a small top, so the world gets the
// window, then the world on the effects' stage, then other Lab items. Its picture is its link preview.
import Base from '../../../layouts/Base.astro';
import EffectStage from '../../../components/EffectStage.astro';
import LabHeader from '../../../components/LabHeader.astro';
import LabMore from '../../../components/LabMore.astro';
import { WORLDS } from '../../../lib/lab/tools.js';

export function getStaticPaths() {
  return WORLDS.map((world) => ({ params: { slug: world.slug }, props: { world } }));
}

interface Props {
  world: (typeof WORLDS)[number];
}

const { world } = Astro.props;
const pictures = import.meta.glob<{ default: ImageMetadata }>('/src/assets/worlds/*.png', { eager: true });
const picture = pictures[`/src/assets/worlds/${world.slug}.png`]?.default;
// What the moving picture shows, for someone who can't see it.
const LABELS: Record<string, string> = {
  town: 'A small town seen from above: roads with traffic lights, coloured houses and shops, and cars driving between them, backing out of drives, parking, and coming and going along the roads out of town.',
  trains: 'A train network seen from above: a double-track main line round the edge, with branches to stations and a depot, and trains carrying coloured cargo between the stations.',
  pond: 'A clear pond seen from above: koi swimming over sand and gravel, mossy boulders along one bank, and maple leaves floating on the water in the sun.',
  fireflies: 'A mangrove river at night, seen from a boat: trees full of fireflies that blink at random, then fall into step and flash together, every flash mirrored in the water, with a paper lantern on the bank for each note in the guestbook.',
};
---
<Base title={world.name} description={world.description} image={picture} noindex={world.hidden}>
  <div class="wrap top">
    <LabHeader compact title={world.name} description={`${world.description} ${world.hint}`} back="/lab/#little-worlds" />
  </div>
  <div class="wrap world">
    <EffectStage slug={world.slug} world pan={'pan' in world && world.pan} label={LABELS[world.slug] ?? world.description}>
      {'controls' in world && world.controls?.map((c) => <button slot="controls" type="button" class="button" data-control={c.id}>{c.label}</button>)}
    </EffectStage>
  </div>
  <LabMore current={world.slug} />
</Base>

<style>
  /* Less room above than other pages: the world below wants the height. */
  .top { padding-top: var(--space-5); }
  /* The world lies on a card (EffectStage.astro), with room under it before the band. */
  .world { padding-bottom: var(--space-6); }
</style>
