---
import TextConverter from '../../components/TextConverter.astro';
import ToolShell from '../../components/ToolShell.astro';
import { CASES } from '../../lib/lab/case.js';
---
<ToolShell slug="change-case" stays="Your text stays in your browser.">
  <TextConverter>
    <fieldset class="choices">
      <legend>Change to</legend>
      <div class="rows">
        <span class="row-label">Text</span>
        <div class="pills">
          {CASES.filter((c) => !c.code).map((c, i) => (
            <label class="pill"><input class="visually-hidden" type="radio" name="case" value={c.id} checked={i === 0} />{c.name}</label>
          ))}
        </div>
        <span class="row-label">Code</span>
        <div class="pills code">
          {CASES.filter((c) => c.code).map((c) => (
            <label class="pill"><input class="visually-hidden" type="radio" name="case" value={c.id} />{c.name}</label>
          ))}
        </div>
      </div>
    </fieldset>
  </TextConverter>
</ToolShell>

<script>
  import { changeCase } from '../../lib/lab/case.js';
  import { setupConverter } from '../../lib/lab/page';

  setupConverter((text) => ({ text: changeCase(text, document.querySelector<HTMLInputElement>('input[name="case"]:checked')!.value) }));
</script>

<style>
  /* Two labelled rows, the labels in their own column so both rows of pills line up. */
  .rows { display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: center; gap: var(--space-2) var(--space-3); }
  .row-label { color: var(--muted); font-size: var(--text-sm); font-weight: 650; }
  .code .pill { font-family: var(--font-code); font-weight: 400; }
</style>
