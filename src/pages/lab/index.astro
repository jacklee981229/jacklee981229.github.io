---
import Base from '../../layouts/Base.astro';
import PageTop from '../../components/PageTop.astro';
import LabItemCard from '../../components/LabItemCard.astro';
import { EFFECTS, GROUPS, TOOLS, WORLDS } from '../../lib/lab/tools.js';
import { experimentPosts, popularLabItems } from '../../lib/collections';
import { SITE } from '../../site';

const INTRO = 'Tiny useful things, random things, and things I built because I felt like it.';
const experiments = await experimentPosts();
const popular = await popularLabItems();
---
<Base title="Jack's Lab" description={INTRO}>
  <div class="wrap page">
    <PageTop tone="lab" icon="flask" title="Jack's Lab" lead={INTRO}>
      <nav class="jump" aria-label="Lab sections">
        <a href="#tools">Tools</a>
        <a href="#mini-games">Mini Games</a>
        <a href="#effects">Effects</a>
        <a href="#little-worlds">Little Worlds</a>
        {SITE.surprise && <a href="#random">Random</a>}
      </nav>
    </PageTop>

    {popular.length > 0 && (
      <section id="popular" aria-labelledby="popular-title">
        <h2 id="popular-title">Most Popular</h2>
        <ul class="cards">
          {popular.map((item) => <LabItemCard {...item} />)}
        </ul>
      </section>
    )}

    <section id="tools" aria-labelledby="tools-title">
      <h2 id="tools-title">Tools</h2>
      {GROUPS.map((group) => (
        <>
          <h3>{group.name}</h3>
          <ul class="cards">
            {TOOLS.filter((t) => t.group === group.id).map((t) => <LabItemCard tool={t} />)}
          </ul>
        </>
      ))}
    </section>

    <section id="mini-games" aria-labelledby="mini-games-title">
      <h2 id="mini-games-title">Mini Games!</h2>
      <ul class="cards">
        {experiments.map((post) => <LabItemCard post={post} />)}
      </ul>
      <p class="note">More games will appear here.</p>
    </section>

    <section id="effects" aria-labelledby="effects-title">
      <h2 id="effects-title">Effects</h2>
      <ul class="cards">
        {EFFECTS.map((effect) => <LabItemCard effect={effect} />)}
      </ul>
      <p class="note">No use at all. Just move your mouse.</p>
    </section>

    <section id="little-worlds" aria-labelledby="little-worlds-title">
      <h2 id="little-worlds-title">Little Worlds</h2>
      <ul class="cards">
        {WORLDS.map((world) => <LabItemCard world={world} />)}
      </ul>
      <p class="note">They run by themselves. Nothing to do but watch.</p>
    </section>

    {SITE.surprise && (
      <section id="random" aria-labelledby="random-title">
        <h2 id="random-title">Random</h2>
        <div class="random">
          <p><strong>Feeling lucky?</strong> One click opens something at random: a post, a tool, a game, an effect or a little world.</p>
          <a class="surprise" href="/random/">Surprise me</a>
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  /* The sections' links, as chips on the Lab's green card. */
  .jump { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .jump a { display: inline-flex; align-items: center; min-height: 2.25rem; padding: 0 var(--space-3); border-radius: var(--radius-pill); background: var(--on-colour-chip); color: var(--on-colour); font-size: var(--text-sm); font-weight: 800; text-decoration: none; }
  .jump a:hover { background: var(--on-colour-chip-hover); }
  section { scroll-margin-top: var(--space-5); }
  section + section { margin-top: var(--space-7); }
  /* As the home page's section titles. */
  h2 { margin: 0 0 var(--space-4); font-size: var(--text-xl); font-weight: 900; letter-spacing: -0.02em; }
  h3 { margin: var(--space-5) 0 var(--space-3); color: var(--muted); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  h2 + h3 { margin-top: 0; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .note { margin: var(--space-3) 0 0; color: var(--muted); }
  /* Random: a green card, like the Lab's on the home page, with its way in as a white pill. */
  .random { --focus: var(--on-colour); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4) var(--space-5); max-width: 44rem; padding: var(--space-5) var(--space-6); border-radius: var(--radius-2xl); background: linear-gradient(120deg, var(--lab-from), var(--lab-to)); color: var(--on-colour); }
  .random p { max-width: 30rem; margin: 0; color: var(--on-colour-soft); }
  .random strong { color: var(--on-colour); font-weight: 900; }
  .surprise { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 var(--space-5); border-radius: var(--radius-pill); background: var(--on-colour); color: var(--lab-to); font-weight: 900; text-decoration: none; transition: transform 0.15s ease; }
  .surprise:hover { transform: translateY(-2px); }
</style>
