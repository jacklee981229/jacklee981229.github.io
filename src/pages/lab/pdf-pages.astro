---
import Icon from '../../components/Icon.astro';
import Switch from '../../components/Switch.astro';
import ToolShell from '../../components/ToolShell.astro';
import { TASKS } from '../../lib/lab/pdf-pages.js';
---
<ToolShell slug="pdf-pages" stays="Your files stay in your browser.">
  <div class="pdf-pages">
    <label class="drop" data-drop>
      <input class="visually-hidden" type="file" accept="application/pdf,.pdf" multiple data-input />
      <Icon name="file" />
      <span class="drop-big">Drop PDFs here, or <span class="pick">choose them</span></span>
      <span class="drop-small">Add more and their pages join the board.</span>
    </label>
    <p class="note" aria-live="polite" data-note></p>
    <div class="work" data-work hidden>
      <ul class="files" data-files></ul>
      <fieldset class="choices tasks" data-tasks>
        <legend class="visually-hidden">What to do</legend>
        <div class="pills">
          {TASKS.map((t, i) => <label class="pill"><input class="visually-hidden" type="radio" name="task" value={t.id} checked={i === 0} />{t.label}</label>)}
        </div>
      </fieldset>
      <section class="board" aria-label="The pages">
        <div class="bar">
          <div class="bar-task" data-bar></div>
          <Switch name="pdf-view" label="How the pages are shown" choices={[{ value: 'preview', label: 'Preview' }, { value: 'list', label: 'List' }]} />
        </div>
        <div class="pages grid" data-board></div>
        <p class="hint" data-hint></p>
        <p class="undo" aria-live="polite" data-undo hidden></p>
      </section>
      <div class="text-out" data-text-out hidden>
        <textarea id="pdf-text" rows="12" readonly spellcheck="false" aria-label="The text of the pages"></textarea>
        <p class="hint" data-scan-note hidden>A page with no text may be a scan: save it with To pictures, and <a href="/lab/image-to-text/">Image to Text</a> can read it.</p>
      </div>
      <div class="save" data-save></div>
    </div>
  </div>
</ToolShell>

<script>
  import { ICONS } from '../../lib/icons.js';
  import { sizeOf } from '../../lib/lab/convert-image.js';
  import { announce, wireCopyButtons } from '../../lib/lab/page';
  import { baseName, byFileOrder, cutsAfter, joinPages, move, pageNumber, parseRange, parts, previewSpot, quarter, saveFiles, toRange, turnsToList } from '../../lib/lab/pdf-pages.js';
  import type { Opened } from '../../lib/lab/pdf-files';
  import { sayWaiting } from '../../lib/waiting.js';

  // Reading and writing PDFs (and the two packages behind it) loads only once a PDF is dropped.
  const engine = () => import('../../lib/lab/pdf-files');

  type Source = { id: string; name: string; colour: number; opened: Opened };
  type Page = { key: string; file: string; n: number; turn: number; on: boolean; cut: boolean; thumb?: string; drawing?: boolean };
  type Task = 'all' | 'merge' | 'split' | 'turn' | 'out' | 'numbers' | 'text' | 'pics';

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const input = $<HTMLInputElement>('[data-input]');
  const drop = $('[data-drop]');
  const note = $('[data-note]');
  const work = $('[data-work]');
  const filesBox = $('[data-files]');
  const bar = $('[data-bar]');
  const board = $('[data-board]');
  const hint = $('[data-hint]');
  const undoBox = $('[data-undo]');
  const saveBox = $('[data-save]');
  const textOut = $('[data-text-out]');
  const textBox = $<HTMLTextAreaElement>('#pdf-text');
  const scanNote = $('[data-scan-note]');

  let sources: Source[] = [];
  let pages: Page[] = [];
  let task: Task = 'all';
  let layout: 'preview' | 'list' = 'preview';
  let splitBy: 'cuts' | 'each' | 'every' = 'cuts';
  let every = 2;
  let picture: 'jpg' | 'png' = 'jpg';
  let numbers: { where: 'centre' | 'right'; style: 'n' | 'of' } = { where: 'centre', style: 'n' };
  /** Each page's text once read (by its key), and whether reading is under way. */
  const texts = new Map<string, string>();
  let reading = false;
  let undo: { text: string; label: string; run: () => void } | null = null;
  let made = 0;
  let saving = false;

  const icon = (name: keyof typeof ICONS) => `<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">${ICONS[name]}</svg>`;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
  const sourceOf = (p: Page) => sources.find((s) => s.id === p.file)!;
  const chosen = () => pages.filter((p) => p.on);
  /** Whether clicking a page chooses it: not in the tasks that use every page as it stands. */
  const choosing = () => !['split', 'numbers', 'text'].includes(task);
  const cuts = () => cutsAfter(pages.length, splitBy, { every, cuts: pages.flatMap((p, i) => (p.cut ? [i] : [])) });

  // ---------- Adding and removing files ----------

  async function add(files: FileList | File[]) {
    const before = pages.length;
    const problems: string[] = [];
    for (const file of files) {
      if (!/pdf$/i.test(file.type) && !/\.pdf$/i.test(file.name)) {
        problems.push(`${file.name} isn't a PDF.`);
        continue;
      }
      sayWaiting(note, `Reading ${file.name}`);
      const opened = await (await engine()).openPdf(file);
      if ('error' in opened) {
        problems.push(opened.error === 'password' ? `${file.name} needs a password to open, so it can't open here.` : `${file.name} couldn't be read: it may be damaged.`);
        continue;
      }
      const source: Source = { id: `f${++made}`, name: file.name, colour: ((made - 1) % 6) + 1, opened };
      sources.push(source);
      pages.push(...opened.shapes.map((_, i) => ({ key: `${source.id}-${i + 1}`, file: source.id, n: i + 1, turn: 0, on: false, cut: false })));
    }
    note.textContent = problems.join(' ');
    if (layout === 'preview' && turnsToList(before, pages.length)) {
      setLayout('list');
      undo = { text: `${pages.length} pages, so they're shown as a list`, label: 'Show previews', run: () => setLayout('preview') };
      announce(undo.text);
    }
    renderAll();
  }

  function removeFile(id: string) {
    for (const p of pages) if (p.file === id && p.thumb) URL.revokeObjectURL(p.thumb);
    sources.find((s) => s.id === id)?.opened.view.destroy();
    sources = sources.filter((s) => s.id !== id);
    pages = pages.filter((p) => p.file !== id);
    undo = null;
    renderAll();
  }

  function setLayout(to: 'preview' | 'list') {
    layout = to;
    document.querySelector<HTMLInputElement>(`input[name="pdf-view"][value="${to}"]`)!.checked = true;
  }

  // ---------- Drawing ----------

  function renderAll() {
    work.hidden = !pages.length;
    filesBox.innerHTML = sources.map((s) => `<li class="file" style="--c: var(--pdf-file-${s.colour})"><i></i><span class="file-name">${esc(s.name)}</span> <span class="file-count">${plural(pages.filter((p) => p.file === s.id).length, 'page')}</span><button type="button" data-remove="${s.id}" aria-label="Remove ${esc(s.name)}">${icon('close')}</button></li>`).join('');
    renderBar();
    drawBoard();
  }

  /** The chosen task's own controls, above the board. Drawn when the task changes, so typing in its field isn't interrupted. */
  function renderBar() {
    const field = (say: string, placeholder: string) => `<label class="range"><span class="say">${say}</span><input type="text" autocomplete="off" spellcheck="false" placeholder="${placeholder}" value="${toRange(pages.flatMap((p, i) => (p.on ? [i] : [])))}" data-range /></label>`;
    const pill = (attrs: string, label: string, on?: boolean) => `<button type="button" class="pill small" ${attrs}${on === undefined ? '' : ` aria-pressed="${on}"`}>${label}</button>`;
    const bits: Record<Task, () => string> = {
      all: () => field('Choose pages', 'e.g. 1-3, 5') + pill('data-pick="all"', 'All') + pill('data-pick="none"', 'None'),
      merge: () => sources.length > 1
        ? `<span class="say" id="order-say">Files in this order</span><ul class="order" aria-labelledby="order-say">${sources.map((s) => `<li class="file" tabindex="0" data-file="${s.id}" style="--c: var(--pdf-file-${s.colour})" aria-label="${esc(s.name)}: drag, or Shift and an arrow key, to move it"><span class="grip" aria-hidden="true">⠿</span><i></i>${esc(s.name)}</li>`).join('')}</ul>`
        : '<span class="say">Drop another PDF to merge it with this one.</span>',
      split: () => `<span class="say">Split</span>` + pill('data-split="cuts"', `${icon('scissors')} Where I cut`, splitBy === 'cuts') + pill('data-split="each"', 'Every page', splitBy === 'each') + pill('data-split="every"', `Every ${every} pages`, splitBy === 'every') +
        (splitBy === 'every' ? pill('data-every="-1" aria-label="Fewer pages a part"', '−') + pill('data-every="1" aria-label="More pages a part"', '+') : ''),
      turn: () => field('Turn', 'all pages') + pill('data-rot="-90"', `${icon('turn-left')} Left`) + pill('data-rot="90"', `${icon('turn-right')} Right`) + pill('data-rot="180"', '180°'),
      out: () => field('Take out', 'e.g. 2, 4'),
      numbers: () => `<span class="say">Where</span>` + pill('data-where="centre"', 'Bottom centre', numbers.where === 'centre') + pill('data-where="right"', 'Bottom right', numbers.where === 'right') +
        `<span class="say">Style</span>` + pill('data-style="n"', '1', numbers.style === 'n') + pill('data-style="of"', `1 / ${pages.length}`, numbers.style === 'of'),
      text: () => '<span class="say">Every page, in this order</span>',
      pics: () => field('Pages', 'all pages') + pill('data-picture="jpg"', 'JPG', picture === 'jpg') + pill('data-picture="png"', 'PNG', picture === 'png'),
    };
    bar.innerHTML = bits[task]();
    const range = bar.querySelector<HTMLInputElement>('[data-range]');
    if (range) range.addEventListener('input', () => {
      const picked = new Set(parseRange(range.value, pages.length));
      pages.forEach((p, i) => (p.on = picked.has(i)));
      drawBoard();
    });
    sortable(bar.querySelector<HTMLElement>('.order'), '[data-file]', (from, to) => {
      sources = move(sources, from, to);
      pages = byFileOrder(pages, sources.map((s) => s.id));
    }, () => { renderAll(); });
  }

  const HINTS: Record<Task, string> = {
    all: 'Click a page to choose it, drag it to move it. Shift and the arrow keys move it too.',
    merge: 'Drag a file to move all its pages, or drag one page.',
    split: 'Click the scissors between two pages to cut there.',
    turn: 'Choose pages or type them, then turn. With none chosen, all of them turn.',
    out: 'Click the pages to take out, or type them.',
    numbers: 'The pages are numbered in this order. Drag a page to move it.',
    text: 'The text comes out in this order. Drag a page to move it.',
    pics: 'With no pages chosen, every page becomes a picture.',
  };

  /** The pages on the board, as previews or rows, showing what the task will do; then the Save under it. */
  function drawBoard(focusKey?: string) {
    const cut = task === 'split' ? cuts() : [];
    const anyChosen = pages.some((p) => p.on);
    let part = 1;
    board.className = `pages ${layout === 'list' ? 'list' : 'grid'}`;
    board.innerHTML = pages.map((p, i) => {
      const source = sourceOf(p);
      const shape = source.opened.shapes[p.n - 1];
      const cutHere = cut[i];
      const choosable = choosing();
      const cls = [choosable && p.on && 'on', task === 'out' && p.on && 'gone', task === 'pics' && anyChosen && !p.on && 'dim', cutHere && 'cut-after'].filter(Boolean).join(' ');
      const label = task === 'split' ? `<span class="part">Part ${part}</span>` : '';
      if (cutHere) part++;
      const name = `Page ${i + 1}: ${esc(source.name)}, page ${p.n}`;
      const tools = task === 'all' ? `<span class="tools"><button type="button" data-turn aria-label="Turn page ${i + 1}">${icon('turn-right')}</button><button type="button" data-out aria-label="Take page ${i + 1} out">${icon('close')}</button></span>` : '';
      const canCut = task === 'split' && splitBy === 'cuts' && i < pages.length - 1;
      // Page numbers: the number shows where it will print, upright once the page's turn is counted.
      const spot = task === 'numbers' ? previewSpot(p.turn, numbers.where) : null;
      const number = spot ? `<span class="pno" style="left: ${spot.x}%; top: ${spot.y}%; --undo-turn: ${-quarter(p.turn)}deg">${pageNumber(i, pages.length, numbers.style)}</span>` : '';
      const sheet = `<span class="fit"><span class="sheet ${shape < 1 ? 'tall' : 'wide'}" style="--ar: ${shape}; transform: rotate(${p.turn}deg);${p.thumb ? ` background-image: url(${p.thumb})` : ''}" data-sheet>${number}</span></span>`;
      const attrs = `class="${layout === 'list' ? 'row' : 'pg'} ${cls}" data-key="${p.key}" tabindex="0" role="button" aria-label="${name}"${choosable ? ` aria-pressed="${p.on}"` : ''} style="--c: var(--pdf-file-${source.colour})"`;
      const mark = `<span class="tick" aria-hidden="true">${task === 'out' ? icon('close') : icon('check')}</span>`;
      if (layout === 'list') {
        const snip = canCut ? `<button type="button" class="snip" data-cut aria-pressed="${p.cut}" aria-label="Cut after page ${i + 1}">${icon('scissors')}<span class="snip-words">Cut after</span></button>` : '';
        return `<div ${attrs}>${mark}<span class="grip" aria-hidden="true">⠿</span>${sheet}<b class="num">${i + 1}</b><span class="from"><i></i><span class="from-name">${esc(source.name)} · </span>page ${p.n}</span>${label}<span class="gap"></span>${tools}${snip}</div>` +
          (cutHere ? `<p class="cut-line">Part ${part} starts here</p>` : '');
      }
      const snip = canCut ? `<button type="button" class="cut" data-cut aria-pressed="${p.cut}" aria-label="Cut after page ${i + 1}">${icon('scissors')}</button>` : '';
      return `<div ${attrs}>${mark}${tools}${snip}${sheet}<span class="num">${i + 1}</span>${label}</div>`;
    }).join('');
    hint.textContent = layout === 'list' && task === 'split' ? 'Click Cut after on a page to cut there.' : HINTS[task];
    undoBox.hidden = !undo;
    if (undo) {
      undoBox.innerHTML = `<span>${esc(undo.text)}</span><button type="button" data-undo-run>${esc(undo.label)}</button>`;
      undoBox.querySelector<HTMLButtonElement>('[data-undo-run]')!.onclick = () => {
        undo!.run();
        undo = null;
        renderAll();
      };
    }
    for (const sheet of board.querySelectorAll('[data-sheet]')) thumbs.observe(sheet);
    sortable(board, '[data-key]', (from, to) => { pages = move(pages, from, to); }, () => drawBoard());
    drawSave();
    if (focusKey) board.querySelector<HTMLElement>(`[data-key="${focusKey}"]`)?.focus({ preventScroll: false });
  }

  /** What Save will make, in words and figures, and its buttons. */
  function drawSave() {
    const n = pages.length;
    const c = chosen().length;
    const button = (label: string, attrs = '', quiet = false) => `<button type="button" class="button${quiet ? ' quiet' : ''}" ${attrs}${saving ? ' disabled' : ''}>${label}</button>`;
    let sum = '';
    let buttons = '';
    if (task === 'all') {
      sum = `<b>${plural(n, 'page')}</b> in one PDF, in this order`;
      buttons = (c ? button(`Save the ${c} chosen`, 'data-go="chosen"', true) : '') + button('Save PDF', 'data-go');
    } else if (task === 'merge') {
      sum = `<b>${plural(n, 'page')}</b> from ${plural(sources.length, 'file')} in one PDF`;
      buttons = button('Merge', 'data-go');
    } else if (task === 'split') {
      const made = parts(cuts()).length;
      sum = made > 1 ? `<b>${made} PDFs</b> in a ZIP` : 'No cuts yet: choose where to cut';
      buttons = made > 1 ? button('Split', 'data-go') : '';
    } else if (task === 'turn') {
      sum = `<b>${plural(n, 'page')}</b> in one PDF, ${pages.filter((p) => quarter(p.turn)).length} turned`;
      buttons = button('Save PDF', 'data-go');
    } else if (task === 'out') {
      sum = !c ? 'Choose the pages to take out' : c === n ? 'Every page is chosen: nothing would be left' : `<b>${plural(n - c, 'page')}</b> left in one PDF`;
      buttons = c && c < n ? button('Take out and save', 'data-go') : '';
    } else if (task === 'numbers') {
      sum = `<b>${plural(n, 'page')}</b> numbered in one PDF`;
      buttons = button('Save PDF', 'data-go');
    } else if (task === 'text') {
      const missing = pages.filter((p) => !texts.has(p.key)).length;
      const empty = pages.filter((p) => texts.get(p.key) === '').length;
      sum = missing ? '' : `<b>Text from ${plural(n, 'page')}</b>${empty ? `, ${empty} with none` : ''}`;
      buttons = missing ? '' : `<button type="button" class="button quiet" data-copy="pdf-text">${icon('copy')}<span data-label>Copy</span></button>` + button('Save as .txt', 'data-go="txt"');
    } else {
      const k = c || n;
      sum = `<b>${plural(k, `${picture.toUpperCase()} picture`)}</b>${k > 1 ? ' in a ZIP' : ''}`;
      buttons = button('Make pictures', 'data-go');
    }
    saveBox.innerHTML = `<p class="sum" data-sum>${sum}</p><p class="go">${buttons}</p>`;
    textOut.hidden = task !== 'text';
    if (task === 'text') showText();
  }

  /** Get text: reads the pages not read yet, one at a time, then shows all the text in the board's order. */
  async function showText() {
    const missing = pages.filter((p) => !texts.has(p.key));
    if (!missing.length) {
      textBox.value = joinPages(pages.map((p) => texts.get(p.key) ?? ''));
      scanNote.hidden = !pages.some((p) => texts.get(p.key) === '');
      wireCopyButtons();
      return;
    }
    sayWaiting(saveBox.querySelector<HTMLElement>('[data-sum]')!, `Reading the text of ${plural(missing.length, 'page')}`);
    if (reading) return;
    reading = true;
    const { readText } = await engine();
    // Pages added while reading are read too, before the text shows.
    for (let next: Page | undefined = missing[0]; next; next = pages.find((p) => !texts.has(p.key))) {
      const source = sources.find((s) => s.id === next.file);
      let text = '';
      try {
        if (source) text = await readText(source.opened, next.n);
      } catch {
        // A page whose text can't be read counts as one without text.
      }
      texts.set(next.key, text);
    }
    reading = false;
    if (task === 'text') {
      drawSave();
      announce(`Read the text of ${plural(pages.length, 'page')}`);
    }
  }

  // Pages are drawn only as they come near the screen, a few at a time, so a long PDF stays quick.
  const thumbs = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      thumbs.unobserve(entry.target);
      const key = (entry.target as HTMLElement).closest<HTMLElement>('[data-key]')?.dataset.key;
      const page = pages.find((p) => p.key === key);
      if (page) drawThumb(page);
    }
  }, { rootMargin: '400px 0px' });

  async function drawThumb(page: Page) {
    if (page.thumb || page.drawing) return;
    page.drawing = true;
    const source = sources.find((s) => s.id === page.file);
    if (!source) return;
    try {
      page.thumb = await (await engine()).thumbnail(source.opened, page.n);
    } catch {
      page.drawing = false;
      return;
    }
    const sheet = board.querySelector<HTMLElement>(`[data-key="${page.key}"] [data-sheet]`);
    if (sheet) sheet.style.backgroundImage = `url(${page.thumb})`;
  }

  // ---------- Using the board ----------

  function choose(page: Page) {
    page.on = !page.on;
    const range = bar.querySelector<HTMLInputElement>('[data-range]');
    if (range) range.value = toRange(pages.flatMap((p, i) => (p.on ? [i] : [])));
    drawBoard(page.key);
  }

  function turn(which: Page[], deg: number) {
    for (const p of which) {
      p.turn += deg;
      // Turned in place, so the page swings round instead of jumping.
      const sheet = board.querySelector<HTMLElement>(`[data-key="${p.key}"] [data-sheet]`);
      if (sheet) sheet.style.transform = `rotate(${p.turn}deg)`;
    }
    drawSave();
  }

  board.addEventListener('click', (e) => {
    if (dragged) return;
    const target = e.target as HTMLElement;
    const el = target.closest<HTMLElement>('[data-key]');
    const page = pages.find((p) => p.key === el?.dataset.key);
    if (!page) return;
    if (target.closest('[data-turn]')) return turn([page], 90);
    if (target.closest('[data-out]')) {
      const at = pages.indexOf(page);
      pages.splice(at, 1);
      undo = { text: `Page ${at + 1} taken out`, label: 'Undo', run: () => pages.splice(at, 0, page) };
      announce(undo.text);
      return renderAll();
    }
    if (target.closest('[data-cut]')) {
      page.cut = !page.cut;
      return drawBoard();
    }
    if (choosing()) choose(page);
  });

  // Keys: Space or Enter chooses, the arrows go to the next page, Shift and an arrow moves the page (or a file, in Merge).
  document.querySelector('.pdf-pages')!.addEventListener('keydown', (e) => {
    const ev = e as KeyboardEvent;
    const el = ev.target as HTMLElement;
    const isPage = el.matches('[data-key]');
    const isFile = el.matches('[data-file]');
    if (!isPage && !isFile) return;
    const step = { ArrowLeft: -1, ArrowUp: -1, ArrowRight: 1, ArrowDown: 1 }[ev.key];
    if (isPage && (ev.key === ' ' || ev.key === 'Enter')) {
      ev.preventDefault();
      const page = pages.find((p) => p.key === el.dataset.key)!;
      if (choosing()) choose(page);
      return;
    }
    if (!step) return;
    ev.preventDefault();
    if (isFile) {
      const at = sources.findIndex((s) => s.id === el.dataset.file);
      if (!ev.shiftKey || at + step < 0 || at + step >= sources.length) return;
      sources = move(sources, at, at + step);
      pages = byFileOrder(pages, sources.map((s) => s.id));
      renderAll();
      bar.querySelector<HTMLElement>(`[data-file="${el.dataset.file}"]`)?.focus();
      return;
    }
    const at = pages.findIndex((p) => p.key === el.dataset.key);
    if (at + step < 0 || at + step >= pages.length) return;
    if (ev.shiftKey) {
      pages = move(pages, at, at + step);
      drawBoard(el.dataset.key);
      announce(`Page moved to ${at + step + 1}`);
    } else board.querySelector<HTMLElement>(`[data-key="${pages[at + step].key}"]`)?.focus();
  });

  /**
   * Drag to reorder: a mouse drags at once, a finger after holding still a moment (so a swipe still scrolls). The
   * item follows the pointer's place in the list; `moved` changes the list behind it, `done` redraws at the end.
   */
  let dragged = false;
  function sortable(box: HTMLElement | null, selector: string, moved: (from: number, to: number) => void, done: () => void) {
    if (!box) return;
    box.onpointerdown = (down) => {
      const item = (down.target as HTMLElement).closest<HTMLElement>(selector);
      if (!item || (down.target as HTMLElement).closest('button, input') || down.button !== 0) return;
      const touch = down.pointerType === 'touch';
      let started = false;
      let holdTimer = 0;
      const start = () => {
        started = dragged = true;
        item.classList.add('lifted');
        box.classList.add('dragging');
      };
      if (touch) holdTimer = window.setTimeout(start, 350);
      const stopScroll = (e: TouchEvent) => { if (started) e.preventDefault(); };
      document.addEventListener('touchmove', stopScroll, { passive: false });
      const onMove = (e: PointerEvent) => {
        if (!started) {
          const far = Math.hypot(e.clientX - down.clientX, e.clientY - down.clientY) > (touch ? 8 : 5);
          if (touch && far) return end();
          if (!touch && far) start();
          if (!started) return;
        }
        if (e.clientY < 60) scrollBy(0, -14);
        else if (e.clientY > innerHeight - 60) scrollBy(0, 14);
        const over = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLElement>(selector);
        if (!over || over === item || !box.contains(over)) return;
        const items = [...box.querySelectorAll<HTMLElement>(selector)];
        const from = items.indexOf(item);
        const to = items.indexOf(over);
        moved(from, to);
        if (from < to) over.after(item);
        else over.before(item);
        box.querySelectorAll('.num').forEach((n, i) => (n.textContent = String(i + 1)));
      };
      const end = () => {
        clearTimeout(holdTimer);
        removeEventListener('pointermove', onMove);
        removeEventListener('pointerup', end);
        removeEventListener('pointercancel', end);
        document.removeEventListener('touchmove', stopScroll);
        if (!started) return;
        item.classList.remove('lifted');
        box.classList.remove('dragging');
        done();
        // The click that ends a drag isn't a choice.
        setTimeout(() => (dragged = false));
      };
      addEventListener('pointermove', onMove);
      addEventListener('pointerup', end);
      addEventListener('pointercancel', end);
    };
  }

  // The bar's buttons: choosing all or none, how Split cuts, turning, the picture type.
  bar.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    const d = b.dataset;
    if (d.pick) pages.forEach((p) => (p.on = d.pick === 'all'));
    if (d.split) splitBy = d.split as typeof splitBy;
    if (d.every) every = Math.max(1, Math.min(Math.max(1, pages.length - 1), every + Number(d.every)));
    if (d.picture) picture = d.picture as typeof picture;
    if (d.where) numbers = { ...numbers, where: d.where as typeof numbers.where };
    if (d.style) numbers = { ...numbers, style: d.style as typeof numbers.style };
    if (d.rot) return turn(chosen().length ? chosen() : pages, Number(d.rot));
    renderBar();
    drawBoard();
    bar.querySelector<HTMLElement>(Object.keys(d).map((k) => `[data-${k}="${d[k]}"]`).join(''))?.focus();
  });

  filesBox.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-remove]');
    if (b) removeFile(b.dataset.remove!);
  });

  document.querySelector('[data-tasks]')!.addEventListener('change', (e) => {
    task = (e.target as HTMLInputElement).value as Task;
    undo = null;
    renderBar();
    drawBoard();
  });

  for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="pdf-view"]')) radio.addEventListener('change', () => {
    layout = radio.value as typeof layout;
    undo = null;
    drawBoard();
  });

  saveBox.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-go]');
    if (!b || saving) return;
    const base = sources.find((s) => s.id === pages[0]?.file)?.name ?? 'document.pdf';
    if (b.dataset.go === 'txt') {
      const got = (await engine()).saveText(textBox.value, `${baseName(base)}.txt`);
      saveBox.querySelector('[data-sum]')!.innerHTML = `Saved <b>${esc(got.name)}</b>, ${sizeOf(got.size)}`;
      announce(`Saved ${got.name}`);
      return;
    }
    const planned = saveFiles({
      task, pages, chosen: pages.map((p) => p.on), base, onlyChosen: b.dataset.go === 'chosen', cuts: cuts(), picture, numbers,
    });
    if (!planned.files.length) return;
    saving = true;
    drawSave();
    const sum = saveBox.querySelector<HTMLElement>('[data-sum]')!;
    sayWaiting(sum, planned.files.length > 1 ? `Making ${planned.files.length} files` : 'Making the file');
    try {
      const opened = new Map(sources.map((s) => [s.id, s.opened]));
      const got = await (await engine()).saveAll(planned, opened);
      saving = false;
      drawSave();
      saveBox.querySelector('[data-sum]')!.innerHTML = `Saved <b>${esc(got.name)}</b>, ${sizeOf(got.size)}`;
      announce(`Saved ${got.name}`);
    } catch {
      saving = false;
      drawSave();
      saveBox.querySelector('[data-sum]')!.textContent = "Your browser couldn't make that file. Try fewer pages at a time.";
    }
  });

  input.addEventListener('change', () => {
    if (input.files?.length) add([...input.files]);
    input.value = '';
  });
  // Dragged over: the box lights up, and a drop adds the PDFs instead of opening them in the tab.
  for (const type of ['dragenter', 'dragover']) drop.addEventListener(type, (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  for (const type of ['dragleave', 'drop']) drop.addEventListener(type, () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files.length) add([...e.dataTransfer.files]);
  });
</script>

