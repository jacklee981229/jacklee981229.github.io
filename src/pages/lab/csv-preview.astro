---
import Icon from '../../components/Icon.astro';
import PreviewTool from '../../components/PreviewTool.astro';
import Switch from '../../components/Switch.astro';
import ToolShell from '../../components/ToolShell.astro';

const ACCEPT = '.csv,.tsv,.txt,text/csv,text/tab-separated-values,text/plain';
---
<ToolShell slug="csv-preview" stays="Your file stays in your browser.">
  <!-- On arrival, only the drop box: the two sides show once there's a file or text to read. -->
  <div class="csv-start" data-start>
    <label class="drop csv-drop" data-drop>
      <input class="visually-hidden" type="file" accept={ACCEPT} data-drop-file />
      <Icon name="table" />
      <span class="drop-big">Drop a CSV here, or <span class="pick">choose one</span></span>
      <span class="drop-small">CSV, TSV or text, with commas, semicolons or tabs.</span>
    </label>
    <p class="actions"><button type="button" class="button" data-paste>Or paste text</button></p>
  </div>
  <div class="csv-work" data-work data-mode="both" hidden>
  <div class="csv-bar" data-bar>
    <Switch name="csv-mode" label="What's shown" choices={[{ value: 'both', label: 'Both' }, { value: 'csv', label: 'CSV' }, { value: 'preview', label: 'Preview' }]} />
    <button type="button" class="button" data-restart>Start over</button>
  </div>
  <PreviewTool label="CSV" sample="" hint="Your table shows here." view="csv-view">
    <button slot="input-actions" type="button" class="button" data-open>Open file</button>
    <input slot="input-actions" type="file" accept={ACCEPT} hidden data-file />
    <label slot="switch" class="csv-find">
      <Icon name="search" />
      <span class="visually-hidden">Search the rows</span>
      <input type="search" placeholder="Search" autocomplete="off" spellcheck="false" data-find />
    </label>
  </PreviewTool>
  </div>
</ToolShell>

<script>
  import { bringIntoView } from '../../games/controls.js';
  import { filterRows, readCsv, sortRows } from '../../lib/lab/csv.js';
  import { ICONS } from '../../lib/icons.js';
  import { announce, setupPreview } from '../../lib/lab/page.ts';

  /** Rows drawn at a time; the rest wait behind a "Show more" button, so a big file shows at once. */
  const CHUNK = 500;

  const make = (tag: string, cls = '', text = '') => {
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    if (text) el.textContent = text;
    return el;
  };
  const count = (n: number, one: string, many: string) => `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;
  const ARROW = `<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">${ICONS['chevron-down']}</svg>`;

  const input = document.querySelector<HTMLTextAreaElement>('[data-in]')!;
  const view = document.querySelector<HTMLElement>('[data-view]')!;
  const find = document.querySelector<HTMLInputElement>('[data-find]')!;
  const file = document.querySelector<HTMLInputElement>('[data-file]')!;
  const start = document.querySelector<HTMLElement>('[data-start]')!;
  const work = document.querySelector<HTMLElement>('[data-work]')!;
  let table: { notes: string[]; header: string[]; rows: string[][] } | null = null;
  // The column sorted by and which way; null keeps the file's order.
  let sort: { column: number; direction: 'up' | 'down' } | null = null;
  let said = 0;

  function headerCell(name: string, column: number) {
    const th = make('th');
    th.setAttribute('scope', 'col');
    const on = sort?.column === column ? sort.direction : null;
    th.setAttribute('aria-sort', on === 'up' ? 'ascending' : on === 'down' ? 'descending' : 'none');
    const button = make('button', 'c-sort') as HTMLButtonElement;
    button.type = 'button';
    button.append(make('span', '', name));
    // A column past the header's end has no name; its button still needs one.
    if (!name.trim()) button.setAttribute('aria-label', `Column ${column + 1}`);
    if (on) {
      button.insertAdjacentHTML('beforeend', ARROW);
      button.dataset.way = on;
    }
    // A-Z, then Z-A, then back to the file's order.
    button.addEventListener('click', () => {
      sort = on === null ? { column, direction: 'up' } : on === 'up' ? { column, direction: 'down' } : null;
      draw();
      view.querySelectorAll<HTMLButtonElement>('.c-sort')[column]?.focus();
    });
    th.append(button);
    return th;
  }

  function addRows(body: HTMLElement, rows: string[][], from: number, after: HTMLElement) {
    const to = Math.min(rows.length, from + CHUNK);
    for (let i = from; i < to; i++) {
      const tr = make('tr');
      // The cell's words sit in a box of their own: a table cell ignores a width limit, a box inside it doesn't.
      for (const cell of rows[i]) {
        const td = make('td');
        td.append(make('div', '', cell));
        tr.append(td);
      }
      body.append(tr);
    }
    if (to === rows.length) return;
    const more = make('button', 'button c-more', `Show ${count(Math.min(CHUNK, rows.length - to), 'more row', 'more rows')} (${(rows.length - to).toLocaleString('en-US')} left)`) as HTMLButtonElement;
    more.type = 'button';
    more.addEventListener('click', () => {
      more.remove();
      addRows(body, rows, to, after);
    });
    after.append(more);
  }

  /** Draws the table as it stands: searched, then sorted. */
  function draw() {
    if (!table) return;
    let rows = filterRows(table.rows, find.value);
    if (sort) rows = sortRows(rows, sort.column, sort.direction);
    const counts = make('p', 'c-counts');
    const shown = rows.length === table.rows.length ? count(rows.length, 'row', 'rows') : `${rows.length.toLocaleString('en-US')} of ${count(table.rows.length, 'row', 'rows')}`;
    counts.append(make('span', '', shown), make('span', '', count(table.header.length, 'column', 'columns')));
    const grid = make('table', 'c-table');
    const head = make('thead');
    const tr = make('tr');
    table.header.forEach((name, i) => tr.append(headerCell(name, i)));
    head.append(tr);
    const body = make('tbody');
    const after = make('div');
    grid.append(head, body);
    addRows(body, rows, 0, after);
    // Lines above the header, such as a report's title, read over the table.
    const notes = table.notes.map((line) => make('p', 'c-note', line));
    const parts: HTMLElement[] = [...notes, counts, grid, after];
    if (!rows.length && table.rows.length) parts.push(make('p', 'c-none', 'No rows match your search.'));
    view.replaceChildren(...parts);
  }

  const { run } = setupPreview((text) => {
    clearTimeout(said);
    table = null;
    input.removeAttribute('aria-invalid');
    if (!text.trim()) return view.replaceChildren();
    const result = readCsv(text);
    if (result.ok) {
      table = result;
      if (sort && sort.column >= result.header.length) sort = null;
      return draw();
    }
    input.setAttribute('aria-invalid', 'true');
    const problem = make('div', 'c-problem');
    const where = `Line ${result.line.toLocaleString('en-US')}`;
    problem.append(make('p', 'c-problem-title', 'Not valid CSV yet'), make('p', '', result.message), make('p', 'c-where', where));
    view.replaceChildren(problem);
    // A quote is open for a moment while typing, so a screen reader hears of it only once typing pauses.
    said = window.setTimeout(() => announce(`Not valid CSV. ${where}. ${result.message}`), 1200);
  });

  find.addEventListener('input', () => {
    draw();
    view.scrollTop = 0;
  });

  // shortcut: a file is read as UTF-8 only, so Excel's plain "CSV" (not "CSV UTF-8") shows its accents and Chinese
  // garbled; read the encoding from the bytes if people bring such files.
  async function open(picked: File | undefined) {
    if (!picked) return;
    input.value = await picked.text();
    sort = null;
    find.value = '';
    run();
    // A file opens on its table alone, as big as it gets.
    setMode('preview');
    showWork();
    view.scrollTop = 0;
    announce(`Opened ${picked.name}`);
  }
  type Mode = 'both' | 'csv' | 'preview';
  function setMode(mode: Mode) {
    document.querySelector<HTMLInputElement>(`input[name="csv-mode"][value="${mode}"]`)!.checked = true;
    work.dataset.mode = mode;
  }
  for (const choice of document.querySelectorAll<HTMLInputElement>('input[name="csv-mode"]')) {
    choice.addEventListener('change', () => { work.dataset.mode = choice.value; });
  }
  /** The drop box makes way for the work, and the page glides to show it whole. */
  function showWork() {
    if (!work.hidden) return;
    start.hidden = true;
    work.hidden = false;
    bringIntoView(document.querySelector<HTMLElement>('[data-bar]')!, document.querySelector<HTMLElement>('.panes')!);
  }
  // Start over: the box emptied and the drop box back, from any mode.
  document.querySelector('[data-restart]')!.addEventListener('click', () => {
    input.value = '';
    find.value = '';
    sort = null;
    run();
    work.hidden = true;
    start.hidden = false;
    document.querySelector<HTMLInputElement>('[data-drop-file]')!.focus();
  });
  // The browser may restore text typed before a reload: then the two sides show at once.
  if (input.value.trim()) {
    start.hidden = true;
    work.hidden = false;
    // The mode switch may come back restored too, without a change event.
    work.dataset.mode = document.querySelector<HTMLInputElement>('input[name="csv-mode"]:checked')?.value ?? 'both';
  }

  document.querySelector('[data-paste]')!.addEventListener('click', () => {
    // Typing wants to see its table at the same time.
    setMode('both');
    showWork();
    input.focus();
  });
  document.querySelector('[data-open]')!.addEventListener('click', () => file.click());
  for (const picker of [file, document.querySelector<HTMLInputElement>('[data-drop-file]')!]) {
    picker.addEventListener('change', () => {
      open(picker.files?.[0]);
      picker.value = '';
    });
  }
  // Dragged over: the drop box lights up, and a drop opens the file instead of the browser showing it in the tab.
  const drop = document.querySelector<HTMLElement>('[data-drop]')!;
  for (const type of ['dragenter', 'dragover']) drop.addEventListener(type, (e) => {
    e.preventDefault();
    drop.classList.add('is-over');
  });
  for (const type of ['dragleave', 'drop']) drop.addEventListener(type, () => drop.classList.remove('is-over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    open(e.dataTransfer?.files[0]);
  });
  // A file dropped on the box opens in it, instead of the browser showing it in the tab; dropped text still drops in.
  for (const type of ['dragenter', 'dragover']) input.addEventListener(type, (e) => {
    if (!(e as DragEvent).dataTransfer?.types.includes('Files')) return;
    e.preventDefault();
    input.classList.add('is-over');
  });
  for (const type of ['dragleave', 'drop']) input.addEventListener(type, () => input.classList.remove('is-over'));
  input.addEventListener('drop', (e) => {
    if (!e.dataTransfer?.files.length) return;
    e.preventDefault();
    open(e.dataTransfer.files[0]);
  });
</script>

<style is:global>
  /* The search: a small field on the page's ground, so a card like the Toolbox's search. */
  .csv-find { display: flex; align-items: center; gap: var(--space-2); width: min(14rem, 60%); padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); background: var(--surface); box-shadow: var(--shadow-card); cursor: text; }
  .csv-find .icon { flex: none; width: 1rem; height: 1rem; color: var(--muted); }
  .csv-find input { flex: 1; min-width: 0; padding: 0; border: 0; background: none; color: var(--ink); font-size: var(--text-sm); outline: none; }
  .csv-find:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .panes .field textarea.is-over { outline: 2px solid var(--focus); outline-offset: 2px; }
  /* One line of the file is one line in the box, scrolling sideways, so the rows stay easy to tell apart. */
  .panes .field textarea[data-in] { white-space: pre; overflow-wrap: normal; overflow-x: auto; }

  /* The drop box: big, and the first thing on the page. */
  .csv-start:not([hidden]) { display: grid; gap: var(--space-3); }
  .csv-start .actions { justify-content: center; margin: 0; }
  /* As tall as the window allows below the page's top, with Or paste text still on screen. */
  .csv-drop { min-height: clamp(12rem, calc(100svh - 28rem), 26rem); align-content: center; }

  /* Both, the CSV alone or the table alone: one side takes the whole width. */
  .csv-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); margin: 0 0 var(--space-4); }
  .csv-bar .button { cursor: pointer; color: var(--ink); }
  .csv-work:not([data-mode='both']) .panes { grid-template-columns: minmax(0, 1fr); }
  .csv-work:not([data-mode='both']) .pane-split,
  .csv-work[data-mode='preview'] .panes > .field,
  .csv-work[data-mode='csv'] .panes > :last-child { display: none; }

  /* The table: as wide as its words, scrolling sideways; the header stays in sight while the rows scroll under it. */
  .csv-view .c-note { margin: 0 0 var(--space-2); color: var(--muted); font-size: var(--text-sm); }
  .csv-view .c-counts { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0 0 var(--space-3); }
  .csv-view .c-counts span { padding: 0 var(--space-2); border-radius: var(--radius-pill); background: var(--wash); color: var(--muted); font-size: var(--text-xs); font-weight: 650; font-variant-numeric: tabular-nums; }
  .csv-view .c-table { width: max-content; border-collapse: separate; border-spacing: 0; font-size: var(--text-sm); line-height: 1.5; }
  .csv-view .c-table :is(th, td) { padding: var(--space-1) var(--space-3); border-bottom: var(--hairline) solid var(--rule); text-align: left; vertical-align: top; }
  /* A long cell wraps at its spaces past this width; only a word longer than the width itself (a link) breaks. */
  .csv-view .c-table td > div { max-width: 24rem; white-space: pre-wrap; overflow-wrap: break-word; }
  .csv-view .c-sort span { white-space: nowrap; }
  .csv-view .c-table th { position: sticky; top: calc(-1 * var(--space-4)); z-index: 1; padding: 0; background: linear-gradient(var(--wash), var(--wash)), var(--surface); }
  .csv-view .c-sort { display: flex; align-items: center; gap: var(--space-1); width: 100%; padding: var(--space-1) var(--space-3); border: 0; border-radius: var(--radius-xs); background: none; color: var(--ink); font: inherit; font-weight: 650; text-align: left; cursor: pointer; transition: background-color var(--motion-quick) ease; }
  .csv-view .c-sort:hover { background: var(--rule); }
  .csv-view .c-sort:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .csv-view .c-sort .icon { flex: none; width: 0.9rem; height: 0.9rem; }
  .csv-view .c-sort[data-way='up'] .icon { rotate: 180deg; }
  .csv-view .c-more { margin: var(--space-3) 0 0; padding: var(--space-1) var(--space-3); color: var(--ink); font-size: var(--text-sm); cursor: pointer; }
  .csv-view .c-none { margin: var(--space-3) 0 0; color: var(--muted); }

  /* What's wrong, in JSON Preview's look. */
  .csv-view .c-problem { font-size: var(--text-base); line-height: 1.5; overflow-wrap: break-word; }
  .csv-view .c-problem p { margin: 0 0 var(--space-2); }
  .csv-view .c-problem-title { font-size: var(--text-md); font-weight: 800; }
  .csv-view .c-where { color: var(--muted); font-size: var(--text-sm); font-weight: 650; }
</style>
