---
// Morning Brief: the newest day's brief (src/content/brief/, made each morning by scripts/brief/). The days before
// are at /brief/YYYY-MM-DD/ ([day].astro). In the sitemap, the palette and a door on the home page, not the menu.
// Logged in to the Now editor (the palette's /login), Jack also sees his oldest open to-dos at the top, pushed from his
// laptop (workers/now/todos.js); the built page holds only an empty spot for them, never a to-do.
import Base from '../../layouts/Base.astro';
import PageTop from '../../components/PageTop.astro';
import BriefDay from '../../components/BriefDay.astro';
import { briefDays } from '../../lib/brief-file.js';
import { BRIEF_LEAD, briefPath } from '../../lib/brief.js';

const days = briefDays();
const day = days.at(-1);
const before = days.at(-2);
---
<Base title="Morning Brief" description="每天早上的华语科技简报：Claude 从 Hacker News、GitHub 和 Lobsters 挑出值得看的几件事。">
  <div class="wrap page">
    <PageTop tone="brief" icon="sunrise" title="Morning Brief" lead={BRIEF_LEAD} />
    <section class="today" aria-labelledby="today-title" data-today hidden></section>
    {day ? <BriefDay day={day} before={before && briefPath(before.date, day.date)} /> : <p class="empty">第一份简报会在明天早上 7 点出来。</p>}
  </div>
</Base>

<script>
  import { PASS_KEY } from '../../lib/now-command.js';
  import { SITE } from '../../site';

  /** The most to-dos shown here; /todo in the palette lists them all. */
  const SHOWN = 5;

  const box = document.querySelector<HTMLElement>('[data-today]');
  let pass = '';
  try { pass = localStorage.getItem(PASS_KEY) ?? ''; } catch { /* blocked: nothing here */ }

  /** The oldest open to-dos, drawn only once they come; anything else (no login, offline, none left) shows nothing. */
  async function showToday(spot: HTMLElement) {
    const answer = await fetch(`${SITE.nowEditor}/api/todos`, { headers: { Authorization: `Bearer ${pass}` } });
    if (!answer.ok) return;
    const { items } = (await answer.json()) as { items: { text: string; project: string }[] };
    if (!items?.length) return;
    const title = document.createElement('h2');
    title.id = 'today-title';
    title.textContent = '今天要做的';
    const list = document.createElement('ol');
    list.append(
      ...items.slice(0, SHOWN).map((item) => {
        const row = document.createElement('li');
        const text = document.createElement('span');
        text.className = 'text';
        text.textContent = item.text;
        const project = document.createElement('span');
        project.className = 'project';
        project.textContent = item.project;
        row.append(text, project);
        return row;
      }),
    );
    spot.replaceChildren(title, list);
    if (items.length > SHOWN) {
      const more = document.createElement('p');
      more.className = 'more';
      more.textContent = `还有 ${items.length - SHOWN} 条，在命令面板输入 /todo 看全部`;
      spot.append(more);
    }
    spot.hidden = false;
  }

  if (box && pass) showToday(box).catch(() => {});
</script>

<style>
  .empty { color: var(--muted); }

  /* Jack's to-dos: a plain frame, no colour, so it reads as his note above the brief rather than one of its cards. */
  /* Rows kept tight so the brief itself still starts on a short laptop's screen. */
  .today { margin-bottom: var(--space-5); padding: var(--space-4) var(--space-5); border: var(--hairline) solid var(--rule); border-radius: var(--radius-2xl); }
  .today[hidden] { display: none; }
  .today :global(h2) { margin: 0 0 var(--space-1); font-size: var(--text-lg); font-weight: 900; letter-spacing: -0.01em; }
  .today :global(ol) { list-style: none; margin: 0; padding: 0; }
  .today :global(li) { display: flex; align-items: baseline; gap: var(--space-4); padding: var(--space-2) 0; border-bottom: var(--hairline) solid var(--rule); }
  .today :global(li:last-child) { border-bottom: 0; padding-bottom: 0; }
  .today :global(.text) { flex: 1; min-width: 0; font-weight: 700; overflow-wrap: anywhere; }
  .today :global(.project) { flex: none; max-width: 40%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0.125rem var(--space-3); border-radius: var(--radius-pill); background: var(--wash); color: var(--muted); font-size: var(--text-xs); font-weight: 700; }
  .today :global(.more) { margin: var(--space-2) 0 0; color: var(--muted); font-size: var(--text-sm); }

  @media (max-width: 599px) {
    .today { padding: var(--space-3) var(--space-4); }
  }
</style>
