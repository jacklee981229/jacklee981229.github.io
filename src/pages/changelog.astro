---
// The Changelog: src/content/changelog.md, newest first, a card for each day (quiet days share one), under its year.
// The newest few show at once; the rest open under Expand (fold in changelog.js). In the sitemap, not in the menu;
// the footer and Site info link here.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageTop from '../components/PageTop.astro';
import ChangelogDays from '../components/ChangelogDays.astro';
import { byYear, fold } from '../lib/changelog.js';
import { changelogFile } from '../lib/changelog-file.js';

/** How many cards show before Expand. */
const SHOWN = 2;
const { open, folded } = fold(byYear(changelogFile()), SHOWN);
---
<Base title="Changelog" description="What changed on Jack's Space, newest first.">
  <div class="wrap page">
    <PageTop tone="changelog" icon="list" title="Changelog" lead="What changed on this site, newest first.">
      <a class="replay" href="/lab/build-log/"><Icon name="branch" />Replay it: Build Log</a>
    </PageTop>
    {open.length === 0 && <p class="empty">No changes listed yet.</p>}
    {open.map(({ year, cards }) => (
      <section class="year" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`}>{year}</h2>
        <ChangelogDays cards={cards} />
      </section>
    ))}
    {folded.length > 0 && (
      <details class="older">
        <summary><span class="fold"><span class="closed">Expand</span><span class="opened">Collapse</span><Icon name="chevron-down" /></span></summary>
        {folded.map(({ year, cards, continued }) => (
          <section class="year" aria-labelledby={`y${year}`}>
            {!continued && <h2 id={`y${year}`}>{year}</h2>}
            <ChangelogDays cards={cards} />
          </section>
        ))}
      </details>
    )}
  </div>
</Base>

<script>
  // About's calendar links to days here; one behind Expand opens it first, as not every browser does that itself.
  const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
  const older = target?.closest('details');
  if (target && older && !older.open) {
    older.open = true;
    target.scrollIntoView();
  }

  // Expand and Collapse glide; a browser opening the fold itself (a link to a day, find in page) shows it at once,
  // so the page still lands on what was asked for.
  const fold = document.querySelector<HTMLDetailsElement>('.older');
  let settled: ReturnType<typeof setTimeout> | undefined;
  fold?.querySelector('summary')?.addEventListener('click', () => {
    fold.classList.add('glide');
    clearTimeout(settled);
    // The browser tells no one when the fold has finished growing, so it gets the growth's own time.
    const growth = parseFloat(getComputedStyle(fold).getPropertyValue('--motion-soft')) || 0;
    settled = setTimeout(() => fold.classList.remove('glide'), growth + 100);
  });
</script>

<style>
  /* The way to the Build Log, a chip on the Changelog's card like the Lab's section links. */
  .replay { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 2.25rem; padding: 0 var(--space-3); border-radius: var(--radius-pill); background: var(--on-colour-chip); color: var(--on-colour); font-size: var(--text-sm); font-weight: 800; text-decoration: none; transition: background-color var(--motion-quick) ease; }
  .replay:hover { background: var(--on-colour-chip-hover); }
  .replay :global(.icon) { width: 1rem; height: 1rem; stroke-width: 2.2; }
  .year + .year { margin-top: var(--space-6); }
  h2 { margin: 0 0 var(--space-4); font-size: var(--text-xl); font-weight: 900; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }

  /* The fold: a line across the page with Expand in the middle; open, it says Collapse and stays above the rest. */
  .older > summary { display: flex; align-items: center; gap: var(--space-4); margin: var(--space-5) 0; list-style: none; cursor: pointer; }
  .older > summary::-webkit-details-marker { display: none; }
  .older > summary::before, .older > summary::after { content: ''; flex: 1; height: var(--hairline); background: var(--rule); }
  .older > summary:focus-visible { outline: none; }
  /* The middle like the site's buttons (.button in global.css). */
  .fold { display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-4); border: 1px solid var(--rule); border-radius: var(--radius-pill); background: var(--surface); font-size: var(--text-sm); font-weight: 800; transition: border-color var(--motion-quick) ease; }
  .older > summary:focus-visible .fold { outline: 2px solid var(--focus); outline-offset: 3px; }
  .older > summary:hover .fold { border-color: var(--ink); }
  .fold :global(.icon) { width: 1rem; height: 1rem; stroke-width: 2.2; transition: rotate var(--motion-soft) var(--ease-out); }
  .older[open] .fold :global(.icon) { rotate: 180deg; }
  /* The older months grow open and fold shut in browsers that can (Chrome, Edge); elsewhere they show at once. */
  .older { interpolate-size: allow-keywords; }
  .older::details-content { block-size: 0; overflow: clip; }
  .older[open]::details-content { block-size: auto; }
  .older.glide::details-content { transition: block-size var(--motion-soft) var(--ease-out), content-visibility var(--motion-soft) allow-discrete; }
  .older[open] .closed, .older:not([open]) .opened { display: none; }
</style>
