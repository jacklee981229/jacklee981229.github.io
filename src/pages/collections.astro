  [data-shine='foil'] .cover::after { background: radial-gradient(farthest-corner circle at var(--mx) var(--my), color-mix(in srgb, var(--shine-warm) 60%, transparent), color-mix(in srgb, var(--shine-gold-light) 16%, transparent) 26%, transparent 56%); mix-blend-mode: overlay; opacity: var(--lit); }
  [data-shine='foil'] .item { --rim: conic-gradient(from var(--angle), var(--shine-gold-light), var(--shine-gold-deep), var(--shine-gold), var(--shine-gold-light), var(--shine-gold-deep), var(--shine-gold), var(--shine-gold-light)); }
