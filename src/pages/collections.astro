---
import PageTop from '../components/PageTop.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Stars from '../components/Stars.astro';
import Icon from '../components/Icon.astro';
import { PILE_STEP, galleryOf, itemKey, moreAfter, pictureOf, pileWords, shineOf } from '../lib/shelves.js';
import { cardColoursOf, pictures } from '../lib/shelf-pictures';
import Switch from '../components/Switch.astro';
import { PLACES, byPlace, searchText, starred } from '../lib/toolbox.js';
/** The widest a cover is drawn, doubled for sharp screens. */
const COVER_WIDTH = 400;
/** The sizes each gallery picture is made in, for the browser to choose from by the window's size and sharpness: up
    to the largest here, or the picture's own width when it's smaller. */
const GALLERY_WIDTHS = [480, 960, 1440];
const widthsFor = (picture: { width: number }) => {
  const top = Math.min(picture.width, GALLERY_WIDTHS.at(-1)!);
  return [...GALLERY_WIDTHS.filter((w) => w < top), top];
};

const shelves = (await getCollection('shelves')).sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity) || a.data.name.localeCompare(b.data.name));
/** Each item's card colours, from its cover, by "collection/name". */
const colours = new Map(await Promise.all(shelves.flatMap((shelf) => shelf.data.items.map(async (item) => [`${shelf.id}/${item.name}`, await cardColoursOf(shelf.id, item)] as const))));

/** The Toolbox, the last tab: its list grouped two ways, by what each tool is for (as listed) and by where it runs. */
const toolGroups = (await getCollection('toolbox'))[0]?.data.groups ?? [];
const toolCount = toolGroups.reduce((n, g) => n + g.tools.length, 0);
const placeOf = (id: string) => PLACES.find((p) => p.id === id)!.label;
type Tool = (typeof toolGroups)[number]['tools'][number] & { group: string };
type ToolGroup = { name: string; place?: string; tools: Tool[] };
// Jack's recommended tools, at the top of both views; each stays in its own group too, so the counts leave them out.
const starredTools = starred(toolGroups) as Tool[];
const toolViews: { id: 'use' | 'place'; groups: ToolGroup[] }[] = [
  { id: 'use', groups: toolGroups.map((g) => ({ name: g.name, tools: g.tools.map((t) => ({ ...t, group: g.name })) })) },
  { id: 'place', groups: byPlace(toolGroups) as ToolGroup[] },
];
---
<Base title="Jack's Collection" description="Things Jack likes, kept where he can look at them, each with its stars.">
  <!-- The cabinet is a turntable: each collection is a card standing on it, one facing the visitor. A tab turns the
       table half-way round to bring another card to the front. -->
  <div class="room">
    <div class="wrap page">
      <PageTop tone="collection" icon="books" title="Jack's Collection" lead="Things I like, kept where I can look at them.">
        <div class="switch tabs" role="tablist" aria-label="Collections">
          {shelves.map((shelf, i) => (
            <button type="button" role="tab" id={`tab-${shelf.id}`} aria-controls={`shelf-${shelf.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={shelf.id}>
              {shelf.data.name} <span class="count">{shelf.data.items.length}<span class="visually-hidden"> items</span></span>
            </button>
          ))}
          {toolCount > 0 && (
            <button type="button" role="tab" id="tab-toolbox" aria-controls="shelf-toolbox" aria-selected="false" tabindex={-1} data-tab="toolbox">
              Toolbox <span class="count">{toolCount}<span class="visually-hidden"> tools</span></span>
            </button>
          )}
        </div>
      </PageTop>

      <div class="stage">
        <div class="table" data-table>
          {shelves.map((shelf, i) => {
            const total = shelf.data.items.length;
            const first = moreAfter(0, total);
            const words = pileWords(first, total);
            return (
            <section class="card" id={`shelf-${shelf.id}`} role="tabpanel" aria-labelledby={`tab-${shelf.id}`} hidden={i !== 0}>
              <div class="board">
                <ul class="items" id={`items-${shelf.id}`}>
                  {shelf.data.items.map((item, index) => {
                    const picture = pictureOf(pictures, shelf.id, item)?.default;
                    const shown = galleryOf(pictures, shelf.id, item).map((p) => p.default);
                    const colour = colours.get(`${shelf.id}/${item.name}`);
                    return (
                      <li style={colour && `--card: ${colour.top}; --card-deep: ${colour.bottom}`} data-key={itemKey(item, index)} data-shine={shineOf(item.stars)} hidden={index >= first}>
                        <button type="button" class="item" aria-haspopup="dialog" data-item>
                          {/* The name is right under the cover, so the picture needs no words of its own. */}
                          {picture ? (
                            <span class="cover"><Image class="picture" src={picture} alt="" width={Math.min(picture.width, COVER_WIDTH)} /><span class="film"></span><span class="glints"></span></span>
                          ) : (
                            <span class="cover plain" aria-hidden="true"><b>{item.name}</b><span class="film"></span><span class="glints"></span></span>
                          )}
                          <strong class="name"><span>{item.name}</span></strong>
                          <Stars stars={item.stars} />
                        </button>
                        {/* The item's gallery, made ready while the site is built; nothing in it loads until it opens. */}
                        <template data-pictures>
                          {shown.map((p, k) => (
                            <Image src={p} alt={`${item.name}, picture ${k + 1} of ${shown.length}`} widths={widthsFor(p)} sizes={p.width > p.height ? '(max-width: 719px) 64vw, 50vw' : '(max-width: 719px) 64vw, 40vw'} />
                          ))}
                        </template>
                      </li>
                    );
                  })}
                  {/* The cards still to come wait in a pile after the ones out; a press deals out the next few. The
                      script lays the next covers on it. */}
                  {first < total && (
                    <li data-pile>
                      <button type="button" class="pile" aria-controls={`items-${shelf.id}`} aria-label={words.label} data-pile-button>
                        <span class="stack" aria-hidden="true" data-stack></span>
                        <strong class="name"><span data-pile-more>{words.more}</span></strong>
                        <span class="pile-count" data-pile-count>{words.count}</span>
                      </button>
                    </li>
                  )}
                </ul>
                {first < total && <p class="gather" hidden data-gather-row><button type="button" class="button" data-gather>Back to the top {PILE_STEP}</button></p>}
              </div>
            </section>
            );
          })}
          {toolCount > 0 && (
            <section class="card" id="shelf-toolbox" role="tabpanel" aria-labelledby="tab-toolbox" hidden data-toolbox>
              <div class="board">
                <div class="tools-bar">
                  <label class="find">
                    <Icon name="search" />
                    <span class="visually-hidden">Find a tool</span>
                    <input type="search" placeholder="Find a tool: try “pdf”, “截图” or “video”" autocomplete="off" spellcheck="false" data-find />
                    <span class="found" aria-live="polite" data-found>{toolCount} tools</span>
                  </label>
                  <Switch name="toolbox-view" label="How the tools are grouped" choices={[{ value: 'use', label: 'What for' }, { value: 'place', label: 'Where' }]} />
                </div>
                {/* What the letters' colours mean; the Where view's headings say it themselves. */}
                <p class="places" data-places>{PLACES.map((p) => <span style={`--c: var(--tool-${p.id})`}><i></i>{p.label}</span>)}</p>
                {toolViews.map((view, v) => (
                  <div class="view" data-view={view.id} hidden={v !== 0}>
                    <div class="chips" role="group" aria-label="Show one group" data-edge-fade="x">
                      <button type="button" aria-pressed="true" data-chip="all">All <span data-chip-count>{toolCount}</span></button>
                      {view.groups.map((g, i) => <button type="button" aria-pressed="false" data-chip={i}>{g.name} <span data-chip-count>{g.tools.length}</span></button>)}
                    </div>
                    {[...(starredTools.length ? [{ name: 'Starred', key: 'starred', tools: starredTools } as ToolGroup & { key: string }] : []), ...view.groups.map((g, i) => ({ ...g, key: String(i) }))].map((g) => (
                      <section class="group" data-group={g.key}>
                        <h2>{g.key === 'starred' && <Icon name="star" />}{g.place && <i style={`--c: var(--tool-${g.place})`}></i>}{g.name} <span class="group-count" data-group-count>{g.tools.length}</span></h2>
                        <ul class="tools">
                          {g.tools.map((t, k) => (
                            <li data-text={searchText(t, t.group)}>
                              {/* Jack's ask: a tool opens in a new tab, so the Toolbox stays where it was. */}
                              <a class="tool" href={t.link} target="_blank" rel="noopener noreferrer">
                                <span class="letter" style={`--c: var(--tool-${t.where})`} aria-hidden="true">{t.name[0].toUpperCase()}</span>
                                <span class="tool-name" data-mark>{t.name}</span>
                                {/* What the view's heading doesn't say: where it runs, or what it's for. */}
                                <span class="also">{view.id === 'use' ? placeOf(t.where) : t.group}</span>
                                <span class="note" data-mark>{t.note}</span>
                              </a>
                              {t.command && (
                                <div class="command">
                                  <code id={`command-${view.id}-${g.key}-${k}`} data-edge-fade="x">{t.command}</code>
                                  <button type="button" class="button" data-copy={`command-${view.id}-${g.key}-${k}`}><Icon name="copy" /><span data-label>Copy</span></button>
                                </div>
                              )}
                            </li>
                          ))}
                        </ul>
                      </section>
                    ))}
                    <p class="nothing" hidden data-nothing>Nothing called “<span data-nothing-word></span>” yet.</p>
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>
      </div>

    </div>
  </div>

  <!-- An item's gallery: one dialog, filled with whichever item's pictures are asked for. It looks like
       a post's enlarged picture (PostScripts.astro): the same dark backdrop and Close button. -->
  <dialog class="gallery" aria-labelledby="gallery-name" data-gallery>
    <!-- First in the dialog, so the Tab key reaches Close first, as its place at the top right suggests. -->
    <form method="dialog"><button class="close" autofocus><Icon name="close" />Close</button></form>
    <div class="gallery-head">
      <h2 id="gallery-name" data-gallery-name></h2>
      <span data-gallery-stars></span>
    </div>
    <div class="gallery-stage" data-gallery-stage></div>
    <button type="button" class="step prev" aria-label="Previous picture" data-gallery-step="-1"><Icon name="back" /></button>
    <button type="button" class="step next" aria-label="Next picture" data-gallery-step="1"><Icon name="back" /></button>
    <p class="gallery-count" aria-live="polite" data-gallery-count></p>
  </dialog>
</Base>

<script>
  import { moreAfter, pileWords, stepsFrom, turnFrames } from '../lib/shelves.js';
  import { slidePills } from '../lib/switch-pill';
  import { found, marked } from '../lib/toolbox.js';
  import { wireCopyButtons } from '../lib/lab/page';

  slidePills();

  /** How long half a turn of the table takes, in milliseconds. */
  const TURN_MS = 950;
  /** How long the gallery takes to open out of an item's card, and to close back into it, in milliseconds. */
  const OPEN_MS = 420;
  const CLOSE_MS = 340;
  /** How far each card stands from the table's middle: this share of the table's width, up to so many pixels. */
  const RADIUS_SHARE = 0.3;
  const MOST_RADIUS = 340;
  /** The gallery's middle picture at most this share of its width (more on a phone, where the sides only peek in),
      the gap between pictures as a share of it too, and how the pictures beside it look: smaller, turned in a
      little, dimmed and a touch blurred; the ones past them smaller still, and out of sight. */
  const MIDDLE_SHARE = 0.5;
  const MIDDLE_SHARE_NARROW = 0.64;
  const GAP_SHARE = 0.03;
  const SIDE = { scale: 0.74, turn: 20, filter: 'brightness(0.5) blur(1.5px)' };
  const FAR = { scale: 0.55, filter: 'brightness(0.3) blur(3px)' };
  /** How far a finger has to travel across the gallery to count as a swipe, in pixels; less is a tap. */
  const SWIPE = 40;
  /** The pile deals each card out in a little arc, one after another (milliseconds for each, and between them), and
      gathers them back quicker. A card on the pile is this share of a card on the board, the arc this high in pixels. */
  const DEAL_MS = 600;
  const DEAL_GAP = 80;
  const GATHER_MS = 300;
  const GATHER_GAP = 30;
  const PILE_CARD = 0.74;
  const ARC = 34;
  /** How each of the top three cards on the pile lies, from the top one down, in degrees. */
  const PILE_TURNS = [0, 6, -7];

  const table = document.querySelector<HTMLElement>('[data-table]')!;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const cards = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')!)!);
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const chosen = () => tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
  /** The card facing the visitor. */
  let front = 0;
  let turning = false;

  /** Brings a tab's card to the front: at once, or with half a turn of the table. */
  async function show(index: number, turn = true) {
    tabs.forEach((tab, i) => {
      tab.setAttribute('aria-selected', String(i === index));
      tab.tabIndex = i === index ? 0 : -1;
    });
    // A turn under way finishes first; it then follows the tabs again.
    if (turning || index === front) return;
    const from = cards[front];
    const to = cards[index];
    to.hidden = false;
    if (turn && !still.matches) {
      turning = true;
      const radius = Math.min(MOST_RADIUS, table.offsetWidth * RADIUS_SHARE);
      const heights = [from.offsetHeight, to.offsetHeight].map((height) => `${height}px`);
      table.classList.add('turning');
      from.style.transform = `translateZ(${radius}px)`;
      to.style.transform = `rotateY(180deg) translateZ(${radius}px)`;
      // A tab further along turns the table clockwise (seen from above); a tab back turns it the other way.
      const turned = table.animate(turnFrames(index > front ? 1 : -1, radius), { duration: TURN_MS, fill: 'forwards' });
      const grown = table.animate({ height: heights }, { duration: TURN_MS, easing: 'ease-in-out', fill: 'forwards' });
      await turned.finished.catch(() => {});
      from.style.transform = to.style.transform = '';
      table.classList.remove('turning');
      turned.cancel();
      grown.cancel();
      turning = false;
    }
    from.hidden = true;
    front = index;
    glint();
    if (chosen() !== front) show(chosen());
  }

  const choose = (index: number) => {
    show(index);
    // The address remembers the tab, so a link can open the page on it.
    history.replaceState(null, '', `#${tabs[index].dataset.tab}`);
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => choose(i));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = (i + step + tabs.length) % tabs.length;
      tabs[next].focus();
      choose(next);
    });
  });
  // The gallery: a click on an item shows its pictures one at a time, the one before on the left and the one after
  // on the right. A click on either (or the buttons, the arrow keys, a swipe) brings it to the middle; it goes round.
  const gallery = document.querySelector<HTMLDialogElement>('[data-gallery]')!;
  const stage = gallery.querySelector<HTMLElement>('[data-gallery-stage]')!;
  const count = gallery.querySelector('[data-gallery-count]')!;
  let slides: HTMLElement[] = [];
  let current = 0;
  let opener: HTMLElement | null = null;

  /** Puts every picture in its place: the middle one big and sharp, its neighbours beside it, the rest out of sight. */
  function lay() {
    // The count first: its line takes room from the stage, so it must be there before the stage is measured.
    count.textContent = `${current + 1} / ${slides.length}`;
    const width = stage.clientWidth;
    const narrow = matchMedia('(max-width: 719px)').matches;
    const most = { width: width * (narrow ? MIDDLE_SHARE_NARROW : MIDDLE_SHARE), height: stage.clientHeight };
    const gap = width * GAP_SHARE;
    const n = slides.length;
    // Each picture in its own shape, as big as the middle's room allows.
    const sizes = slides.map((slide) => {
      const img = slide.querySelector('img')!;
      const ratio = Number(img.getAttribute('width')) / Number(img.getAttribute('height')) || 2 / 3;
      return ratio > most.width / most.height ? { width: most.width, height: most.width / ratio } : { width: most.height * ratio, height: most.height };
    });
    slides.forEach((slide, i) => {
      const d = stepsFrom(i, current, n);
      const side = Math.sign(d);
      const beside = sizes[(current + side + n) % n];
      // Beside the middle: just clear of it. Further on: just clear of the one beside it.
      const x = d === 0 ? 0 : side * (sizes[current].width / 2 + gap + beside.width * SIDE.scale / 2 + (Math.abs(d) > 1 ? beside.width * SIDE.scale / 2 + gap + sizes[i].width * FAR.scale / 2 : 0));
      const look = d === 0 ? { scale: 1, turn: 0, filter: 'none' } : Math.abs(d) === 1 ? SIDE : { ...FAR, turn: SIDE.turn };
      slide.style.width = `${sizes[i].width}px`;
      slide.style.height = `${sizes[i].height}px`;
      slide.style.transform = `translate(-50%, -50%) translateX(${x}px) scale(${look.scale}) rotateY(${-side * look.turn}deg)`;
      slide.style.filter = look.filter;
      slide.style.opacity = Math.abs(d) > 1 ? '0' : '1';
      // Out of sight is out of reach too: a click there is on the dark, not on a picture two along.
      slide.style.pointerEvents = Math.abs(d) > 1 ? 'none' : '';
      slide.style.zIndex = String(3 - Math.min(2, Math.abs(d)));
      slide.classList.toggle('middle', d === 0);
      slide.classList.toggle('beside', Math.abs(d) === 1);
      slide.setAttribute('aria-hidden', String(d !== 0));
    });
  }

  const go = (step: number) => {
    current = (current + step + slides.length) % slides.length;
    lay();
  };

  function openGallery(item: HTMLElement) {
    opener = item;
    const template = item.nextElementSibling as HTMLTemplateElement;
    gallery.querySelector('[data-gallery-name]')!.textContent = item.querySelector('.name')!.textContent;
    gallery.querySelector('[data-gallery-stars]')!.replaceChildren(item.querySelector('.stars')!.cloneNode(true));
    slides = [...template.content.querySelectorAll('img')].map((img, i) => {
      const slide = document.createElement('figure');
      slide.className = 'slide';
      slide.append(img.cloneNode());
      slide.addEventListener('click', () => {
        const d = stepsFrom(i, current, slides.length);
        if (d && !swiped) go(d);
      });
      return slide;
    });
    stage.replaceChildren(...slides);
    current = 0;
    swiped = false;
    gallery.classList.toggle('single', slides.length < 2);
    gallery.showModal();
    // Into place at once on opening; after that, every change slides.
    stage.classList.add('placing');
    lay();
    stage.getBoundingClientRect();
    stage.classList.remove('placing');
    openOut(item);
  }

  /** The gallery opens out of the item's card: its first picture grows from the card's cover into the middle, and the
      rest (the pictures beside it, the name, the buttons) fade in as it lands. Less motion: it's just there. */
  function openOut(item: HTMLElement) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const middle = slides[current];
    const from = (item.querySelector('.cover') ?? item).getBoundingClientRect();
    const to = middle.getBoundingClientRect();
    const dx = from.left + from.width / 2 - (to.left + to.width / 2);
    const dy = from.top + from.height / 2 - (to.top + to.height / 2);
    const placed = middle.style.transform;
    // The same list of steps at both ends, so each one runs smoothly from its start to its end.
    middle.animate([{ transform: `translate(${dx}px, ${dy}px) ${placed} scale(${from.width / to.width})` }, { transform: `translate(0px, 0px) ${placed} scale(1)` }], { duration: OPEN_MS, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
    const rest = [...slides.filter((slide) => slide !== middle), ...gallery.querySelectorAll<HTMLElement>('.gallery-head, .step, .gallery-count, .close')];
    for (const el of rest) el.animate([{ opacity: 0 }, { opacity: getComputedStyle(el).opacity }], { duration: OPEN_MS * 0.7, delay: OPEN_MS * 0.4, easing: 'ease', fill: 'backwards' });
  }

  /** The gallery closes back into the item's card, the way it came: the middle picture shrinks into the card's cover
      as the rest and the dark fade. Less motion: it just closes. */
  let closing = false;
  async function closeIn() {
    if (closing || !gallery.open) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !opener || !slides.length) return gallery.close();
    closing = true;
    const middle = slides[current];
    const to = (opener.querySelector('.cover') ?? opener).getBoundingClientRect();
    const from = middle.getBoundingClientRect();
    const dx = to.left + to.width / 2 - (from.left + from.width / 2);
    const dy = to.top + to.height / 2 - (from.top + from.height / 2);
    const placed = middle.style.transform;
    gallery.classList.add('closing');
    const shrink = middle.animate([{ transform: `translate(0px, 0px) ${placed} scale(1)` }, { transform: `translate(${dx}px, ${dy}px) ${placed} scale(${to.width / from.width})` }], { duration: CLOSE_MS, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' });
    const rest = [...slides.filter((slide) => slide !== middle), ...gallery.querySelectorAll<HTMLElement>('.gallery-head, .step, .gallery-count, .close')];
    for (const el of rest) el.animate([{ opacity: getComputedStyle(el).opacity }, { opacity: 0 }], { duration: CLOSE_MS * 0.6, easing: 'ease', fill: 'forwards' });
    await shrink.finished.catch(() => {});
    gallery.close();
    gallery.classList.remove('closing');
    for (const el of gallery.querySelectorAll<HTMLElement>('.gallery-head, .step, .gallery-count, .close')) el.getAnimations().forEach((a) => a.cancel());
    closing = false;
  }
  // Every way out closes it back into its card: the Close button, Esc, and a tap on the dark around the pictures.
  gallery.querySelector('form[method="dialog"]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    closeIn();
  });
  gallery.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeIn();
  });

  for (const item of document.querySelectorAll<HTMLElement>('[data-item]')) item.addEventListener('click', () => openGallery(item));

  /** Lights a card's shine: where the light falls on it (0 to 1 across and down) and how bright, from 0 to 1. */
  function light(item: HTMLElement, x: number, y: number, lit: number) {
    const s = item.style;
    s.setProperty('--mx', `${(x * 100).toFixed(1)}%`);
    s.setProperty('--my', `${(y * 100).toFixed(1)}%`);
    s.setProperty('--px', x.toFixed(3));
    s.setProperty('--py', y.toFixed(3));
    s.setProperty('--shine-x', `${(100 - x * 100).toFixed(1)}%`);
    s.setProperty('--angle', `${((Math.atan2(y - 0.5, x - 0.5) * 180) / Math.PI + 90).toFixed(1)}deg`);
    s.setProperty('--lit', lit.toFixed(3));
  }

  // A card tilts toward the mouse, at most 9 degrees, its shine lit where the mouse is. Mouse only, and not for less
  // motion.
  const tilting = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  for (const item of document.querySelectorAll<HTMLElement>('[data-item]')) {
    item.addEventListener('pointermove', (e) => {
      if (!tilting.matches) return;
      const box = item.getBoundingClientRect();
      const x = Math.min(1, Math.max(0, (e.clientX - box.left) / box.width));
      const y = Math.min(1, Math.max(0, (e.clientY - box.top) / box.height));
      item.classList.add('is-tilting');
      item.style.setProperty('--ry', `${(x - 0.5) * 18}deg`);
      item.style.setProperty('--rx', `${(0.5 - y) * 14}deg`);
      light(item, x, y, 1);
    });
    item.addEventListener('pointerleave', () => {
      item.classList.remove('is-tilting');
      for (const name of ['--rx', '--ry', '--lit']) item.style.removeProperty(name);
    });
  }

  // A phone has no mouse to follow: each card catches the light as it scrolls past the middle of the screen, the
  // light running across it as it rises. Not for less motion.
  const glinting = matchMedia('(hover: none) and (prefers-reduced-motion: no-preference)');
  let glintFrame = 0;
  function glint() {
    glintFrame = 0;
    if (!glinting.matches) return;
    for (const item of cards[front].querySelectorAll<HTMLElement>('[data-item]')) {
      const box = item.getBoundingClientRect();
      if (!box.height || box.bottom < 0 || box.top > innerHeight) continue;
      const along = (box.top + box.height / 2) / innerHeight;
      const t = Math.min(1, Math.max(0, 1.25 - along * 1.5));
      light(item, t, t, Math.max(0, 1 - Math.abs(along - 0.5) * 2.2));
    }
  }
  const glintSoon = () => (glintFrame ||= requestAnimationFrame(glint));
  addEventListener('scroll', glintSoon, { passive: true });
  addEventListener('resize', glintSoon);

  // The pile: each collection shows its best few, and the rest wait in a pile in the next place on the board. A press
  // deals out the next few, the pile moving on after them, until all are out; then a button under the board gathers
  // them back into the pile.
  /** A list's cards, without its pile. */
  const cardsIn = (list: HTMLElement) => [...list.querySelectorAll<HTMLElement>(':scope > li:not([data-pile])')];

  /** Shows a list's first `count` cards and hides the rest. The pile holds the rest, with the next covers on it, or
      gives way to the button that gathers them back once all are out. */
  function setShown(list: HTMLElement, count: number) {
    const all = cardsIn(list);
    all.forEach((li, i) => (li.hidden = i >= count));
    const pile = list.querySelector<HTMLElement>('[data-pile]');
    if (!pile) return;
    const shown = Math.min(count, all.length);
    pile.hidden = shown === all.length;
    list.parentElement!.querySelector<HTMLElement>('[data-gather-row]')!.hidden = !pile.hidden;
    if (pile.hidden) return;
    const words = pileWords(shown, all.length);
    pile.querySelector('[data-pile-more]')!.textContent = words.more;
    pile.querySelector('[data-pile-count]')!.textContent = words.count;
    pile.querySelector('[data-pile-button]')!.setAttribute('aria-label', words.label);
    // The next three covers, the next one on top, each lying as PILE_TURNS says (--side tells pointing which way to
    // fan it out).
    pile.querySelector('[data-stack]')!.replaceChildren(...all.slice(shown, shown + PILE_TURNS.length).map((li, depth) => {
      const card = document.createElement('span');
      card.className = 'pile-card';
      card.style.cssText = li.getAttribute('style') ?? '';
      card.style.setProperty('--turn', `${PILE_TURNS[depth]}deg`);
      card.style.setProperty('--side', String(Math.sign(PILE_TURNS[depth])));
      card.style.zIndex = String(PILE_TURNS.length - depth);
      const picture = li.querySelector('.picture');
      if (picture) card.append(picture.cloneNode());
      else card.append(Object.assign(document.createElement('b'), { textContent: li.querySelector('.name')!.textContent }));
      return card;
    }));
  }

  /** Deals the next few cards out of a pile: each flies from the pile to its place in a little arc, and the pile
      moves on after them. Less motion: they're just there. */
  function deal(pile: HTMLElement) {
    const list = pile.parentElement!;
    const all = cardsIn(list);
    const shown = all.filter((li) => !li.hidden).length;
    const dealt = all.slice(shown, shown + moreAfter(shown, all.length));
    const from = pile.querySelector('[data-stack]')!.getBoundingClientRect();
    const pileFrom = pile.getBoundingClientRect();
    setShown(list, shown + dealt.length);
    // The keyboard carries on from the first card dealt, where the pile was.
    dealt[0]?.querySelector<HTMLElement>('[data-item]')!.focus({ preventScroll: true });
    if (still.matches) return glint();
    dealt.forEach((li, k) => {
      const to = li.getBoundingClientRect();
      const dx = from.left + from.width / 2 - (to.left + to.width / 2);
      const dy = from.top + from.height / 2 - (to.top + to.height / 2);
      const scale = (from.width * PILE_CARD) / to.width;
      const turn = PILE_TURNS[k % PILE_TURNS.length];
      li.animate([
        { transform: `translate(${dx}px, ${dy}px) rotate(${turn}deg) scale(${scale})` },
        { transform: `translate(${dx * 0.45}px, ${dy * 0.45 - ARC}px) rotate(${turn / 2}deg) scale(${(scale + 1) / 2})`, offset: 0.55 },
        { transform: 'none' },
      ], { duration: DEAL_MS, delay: k * DEAL_GAP, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', fill: 'backwards' });
    });
    if (!pile.hidden) {
      const pileTo = pile.getBoundingClientRect();
      pile.animate([{ transform: `translate(${pileFrom.left - pileTo.left}px, ${pileFrom.top - pileTo.top}px)` }, { transform: 'none' }], { duration: DEAL_MS, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
    }
    glint();
  }

  /** Gathers every card past the first few back into the pile, the last first, quicker than they came out. */
  async function gather(list: HTMLElement) {
    const all = cardsIn(list);
    const first = moreAfter(0, all.length);
    const extra = all.slice(first);
    if (!still.matches) {
      const to = extra[0].getBoundingClientRect();
      await Promise.all(extra.map((li, k) => {
        const box = li.getBoundingClientRect();
        const turn = PILE_TURNS[k % PILE_TURNS.length];
        return li.animate([{ transform: 'none' }, { transform: `translate(${to.left - box.left}px, ${to.top - box.top}px) rotate(${turn}deg) scale(${PILE_CARD})`, opacity: 0 }], { duration: GATHER_MS, delay: (extra.length - 1 - k) * GATHER_GAP, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }).finished.catch(() => {});
      }));
    }
    setShown(list, first);
    for (const li of extra) li.getAnimations().forEach((a) => a.cancel());
    const pile = list.querySelector<HTMLElement>('[data-pile]')!;
    if (!still.matches) pile.animate([{ opacity: 0, transform: 'scale(0.94)' }, { opacity: 1, transform: 'none' }], { duration: GATHER_MS, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
    pile.querySelector<HTMLElement>('[data-pile-button]')!.focus();
    glint();
  }

  for (const pile of document.querySelectorAll<HTMLElement>('[data-pile]')) {
    setShown(pile.parentElement!, moreAfter(0, cardsIn(pile.parentElement!).length));
    pile.querySelector('[data-pile-button]')!.addEventListener('click', () => deal(pile));
  }
  for (const button of document.querySelectorAll<HTMLElement>('[data-gather]')) button.addEventListener('click', () => gather(button.closest('.board')!.querySelector<HTMLElement>('.items')!));
  glint();
  for (const button of gallery.querySelectorAll<HTMLElement>('[data-gallery-step]')) button.addEventListener('click', () => go(Number(button.dataset.galleryStep)));
  gallery.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    e.preventDefault();
    if (slides.length > 1) go(e.key === 'ArrowLeft' ? -1 : 1);
  });
  // A swipe across moves one picture along; a tap on the dark around the pictures closes the gallery, as on a
  // post's enlarged picture.
  let downAt: number | null = null;
  let swiped = false;
  stage.addEventListener('pointerdown', (e) => {
    downAt = e.clientX;
    swiped = false;
  });
  stage.addEventListener('pointerup', (e) => {
    if (downAt !== null && Math.abs(e.clientX - downAt) > SWIPE && slides.length > 1) {
      swiped = true;
      go(e.clientX < downAt ? 1 : -1);
    }
    downAt = null;
  });
  stage.addEventListener('click', (e) => {
    if (e.target === stage && !swiped) closeIn();
  });
  addEventListener('resize', () => {
    if (gallery.open) lay();
  });
  gallery.addEventListener('close', () => {
    stage.replaceChildren();
    slides = [];
    opener?.focus();
  });

  // A link to a tab (/collections/#games) opens the page on it, without the turn. A link to an item in it
  // (/collections/#movies/zhu-yu, from About's favourites) then opens the item's gallery, half a second after the page
  // has loaded; the address is left at the tab, so going back to the page doesn't open it again.
  const [tabPart, itemPart] = location.hash.slice(1).split('/');
  const linked = tabs.findIndex((tab) => tab.dataset.tab === tabPart);
  if (linked > 0) show(linked, false);
  // The palette's Toolbox opens /collections/#toolbox; on this page already, only the address's end changes.
  addEventListener('hashchange', () => {
    const asked = tabs.findIndex((tab) => tab.dataset.tab === location.hash.slice(1).split('/')[0]);
    if (asked >= 0) show(asked);
  });
  const linkedItem = itemPart ? cards[linked]?.querySelector<HTMLElement>(`[data-key="${CSS.escape(decodeURIComponent(itemPart))}"] [data-item]`) : null;
  if (linkedItem) {
    // A card still in the pile comes out first, with all the rest.
    const linkedLi = linkedItem.closest('li')!;
    if (linkedLi.hidden) setShown(linkedLi.parentElement!, Infinity);
    history.replaceState(null, '', `#${tabPart}`);
    const later = () => {
      // At once, not gliding (global.css), so the gallery grows out of the card where it has come to rest.
      linkedItem.scrollIntoView({ block: 'nearest', behavior: 'instant' });
      setTimeout(() => openGallery(linkedItem), 500);
    };
    if (document.readyState === 'complete') later();
    else addEventListener('load', later, { once: true });
  }

  // The Toolbox: the search hides what it doesn't hold and marks what it found, in both views at once, so switching
  // views keeps it. A chip shows one group of the view; its count follows the search, and a group the search empties
  // can't be chosen.
  const toolbox = document.querySelector<HTMLElement>('[data-toolbox]');
  if (toolbox) {
    const find = toolbox.querySelector<HTMLInputElement>('[data-find]')!;
    const foundLine = toolbox.querySelector<HTMLElement>('[data-found]')!;
    const views = [...toolbox.querySelectorAll<HTMLElement>('[data-view]')];
    const total = toolbox.querySelectorAll('[data-view] [data-group]:not([data-group="starred"]) li').length / views.length;
    const plain = new Map([...toolbox.querySelectorAll<HTMLElement>('[data-mark]')].map((el) => [el, el.textContent ?? '']));
    const picked = new Map(views.map((view) => [view, 'all']));

    function update() {
      const query = find.value;
      let shown = 0;
      for (const view of views) {
        const groups = [...view.querySelectorAll<HTMLElement>('[data-group]')];
        const chosen = picked.get(view)!;
        let inView = 0;
        for (const group of groups) {
          const key = group.dataset.group!;
          let n = 0;
          for (const li of group.querySelectorAll<HTMLElement>('li')) {
            const hit = found(li.dataset.text ?? '', query);
            li.hidden = !hit;
            if (hit) n++;
          }
          group.querySelector('[data-group-count]')!.textContent = String(n);
          group.hidden = n === 0 || (chosen !== 'all' && chosen !== key);
          // Starred repeats tools from the groups, so it has no chip and isn't counted twice.
          if (key === 'starred') continue;
          inView += n;
          const chip = view.querySelector<HTMLButtonElement>(`[data-chip="${key}"]`)!;
          chip.querySelector('[data-chip-count]')!.textContent = String(n);
          chip.disabled = n === 0;
        }
        view.querySelector('[data-chip="all"] [data-chip-count]')!.textContent = String(inView);
        view.querySelector<HTMLElement>('[data-nothing]')!.hidden = inView > 0;
        view.querySelector('[data-nothing-word]')!.textContent = query.trim();
        shown = inView;
      }
      for (const [el, text] of plain) el.innerHTML = marked(text, query);
      foundLine.textContent = query.trim() ? `${shown} of ${total}` : `${total} tools`;
    }

    find.addEventListener('input', update);
    for (const view of views) {
      for (const chip of view.querySelectorAll<HTMLButtonElement>('[data-chip]')) {
        chip.addEventListener('click', () => {
          picked.set(view, chip.dataset.chip!);
          for (const other of view.querySelectorAll('[data-chip]')) other.setAttribute('aria-pressed', String(other === chip));
          update();
        });
      }
    }
    // A chip the search has just emptied goes back to All, so the view never shows nothing for a chosen group.
    find.addEventListener('input', () => {
      for (const view of views) {
        const chip = view.querySelector<HTMLButtonElement>(`[data-chip="${picked.get(view)}"]`);
        if (chip?.disabled) view.querySelector<HTMLButtonElement>('[data-chip="all"]')!.click();
      }
    });
    for (const input of toolbox.querySelectorAll<HTMLInputElement>('input[name="toolbox-view"]')) {
      input.addEventListener('change', () => {
        for (const view of views) view.hidden = view.dataset.view !== input.value;
        toolbox.querySelector<HTMLElement>('[data-places]')!.hidden = input.value === 'place';
      });
    }
    wireCopyButtons();
  }
</script>

