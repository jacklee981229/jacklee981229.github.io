  [data-shine='holo'] .item { --rim: conic-gradient(from var(--angle), var(--shine-holo-1), var(--shine-holo-2), var(--shine-holo-3), var(--shine-holo-4), var(--shine-holo-5), var(--shine-holo-1)); }
