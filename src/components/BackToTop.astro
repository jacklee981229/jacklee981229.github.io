---
import Icon from './Icon.astro';

interface Props {
  /** A ring round the button fills as the page is read (on posts). */
  progress?: boolean;
}

const { progress = false } = Astro.props;
---
<button type="button" class="to-top" data-back-to-top aria-label="Back to top">
  {progress && <svg class="ring" viewBox="0 0 44 44" aria-hidden="true" data-ring><circle class="track" cx="22" cy="22" r="20.5" /><circle class="read" cx="22" cy="22" r="20.5" pathLength="1" /></svg>}
  <Icon name="up" />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (button) {
    const ring = button.querySelector<SVGElement>('[data-ring]');
    // A travel story (TravelStory.astro) is read a slide at a time and fills most of its page: on it the ring counts
    // slides (its data-read), gliding from one to the next, and stays full once the story is behind the reader.
    const story = document.querySelector<HTMLElement>('[data-story]');
    const toggle = () => {
      button.classList.toggle('is-visible', scrollY > innerHeight * 0.8);
      if (!ring) return;
      const band = story?.getBoundingClientRect();
      const inStory = !!band && band.top <= 1 && band.bottom >= 1;
      const read = inStory ? Number(story!.dataset.read) : band && band.bottom < 1 ? 1 : scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight);
      ring.classList.toggle('slides', inStory);
      ring.classList.toggle('full', read >= 0.999);
      ring.style.setProperty('--read', String(Math.min(1, read)));
    };
    addEventListener('scroll', toggle, { passive: true });
    story?.addEventListener('story-read', toggle);
    toggle();
    button.addEventListener('click', () => {
      // Move keyboard focus back to the top too, so the next Tab starts at the page content.
      document.getElementById('main')?.focus({ preventScroll: true });
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' });
    });
  }
</script>

<style>
  /* Hidden with visibility (not just opacity) so it can't be tabbed to until it shows. */
  .to-top { position: fixed; right: var(--space-4); bottom: var(--space-4); z-index: 20; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; border-radius: 50%; background: var(--surface); box-shadow: var(--shadow-card); color: var(--ink); cursor: pointer; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity var(--motion-quick) ease, transform var(--motion-quick) ease, visibility var(--motion-quick); }
  .to-top.is-visible { opacity: 1; visibility: visible; transform: none; }
  /* How far down the post the reader is, drawn round the button's edge from the top, clockwise. */
  .ring { position: absolute; inset: 0; width: 100%; height: 100%; rotate: -90deg; pointer-events: none; }
  .ring circle { fill: none; stroke-width: 2.5; }
  .track { stroke: transparent; }
  .read { stroke: var(--ink); stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--read, 0)); }
  .slides .read { transition: stroke-dashoffset var(--motion-settle) var(--ease-out); }
  /* Full, a dashed circle still shows a hairline where its two ends meet: draw it whole. */
  .full .read { stroke-dasharray: none; }
</style>
