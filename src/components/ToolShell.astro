---
// The frame every Lab tool page shares: the Lab page's top (the tool's name and description, from the tool list, and
// where the visitor's data stays), the tool itself in the slot, then other Lab items to check out.
import Base from '../layouts/Base.astro';
import LabHeader from './LabHeader.astro';
import LabMore from './LabMore.astro';
import { toolBySlug } from '../lib/lab/tools.js';
import '../styles/lab.css';

interface Props {
  slug: string;
  /** For example "Your text stays in your browser." */
  stays: string;
}

const { slug, stays } = Astro.props;
const tool = toolBySlug(slug);
---
<Base title={tool.name} description={tool.description} area="lab">
  <div class="wrap page">
    <LabHeader title={tool.name} description={`${tool.description} ${stays}`} />
    <slot />
  </div>
  <LabMore current={slug} />
</Base>
