---
// A link that stands on its own, drawn as `.go` in global.css: no underline, and a press that gives a little.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

// `rest` carries the parent's style-scope attribute, so the page placing it can still style it.
const { class: className, ...rest } = Astro.props;
---
<a class:list={['go', className]} {...rest}><slot /></a>
