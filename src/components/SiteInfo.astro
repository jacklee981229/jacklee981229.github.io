---
import Go from './Go.astro';
import { SITE } from '../site';
import { daysBetween, formatDate } from '../lib/dates.js';
import { lastUpdate } from '../lib/changelog-file.js';

interface Props {
  /** The newest post's date. */
  newestPost?: Date;
}

const { newestPost } = Astro.props;
const updated = lastUpdate(newestPost);
const days = daysBetween(new Date(), new Date(`${SITE.started}T00:00:00+08:00`));
---
<dl class="info">
  <div><dt>Running for</dt><dd><span data-running-since={SITE.started}>{days.toLocaleString('en-US')}</span> days</dd></div>
  <!-- Visits to the whole site from GoatCounter (src/lib/visits.js), filled in on the live site; the row goes away if
       no number comes. -->
  <div data-visits="TOTAL" data-local><dt>Visitors</dt><dd data-visits-number>–</dd></div>
  {updated && <div><dt>Last update</dt><dd><Go href="/changelog/">{formatDate(updated)}</Go></dd></div>}
</dl>

<script>
  import { showRunningDays } from '../lib/running.js';
  import { showVisits } from '../lib/visits.js';
  import Go from './Go.astro';
import { SITE } from '../site';

  showRunningDays();
  // The visit count, on the live site only; a local preview says so.
  showVisits(SITE.goatcounter, new URL(import.meta.env.SITE).hostname);
</script>

<style>
  .info { display: grid; gap: var(--space-2); margin: 0; }
  div { display: flex; justify-content: space-between; gap: var(--space-4); }
  div[hidden] { display: none; }
  dt { color: var(--muted); }
  /* No tabular figures here: they give the comma in "1,312" a full digit's width. */
  dd { margin: 0; font-weight: 650; }
  .local { color: var(--muted); font-weight: 400; }
</style>
