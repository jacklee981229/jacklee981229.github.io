---
// Jack's links as coloured tiles: icons only, 4 in a row, in a post's profile card; with their names on the About
// page (`labels`), where each name sits beside a small tile, in the text colour so it reads on any tile's colour.
// Icons only still carry the name, for screen readers (hidden text) and as a tooltip on hover. The tiles' colours
// are the `link-…` classes in global.css, shared with the home page.
import Icon from './Icon.astro';
import { LINKS } from '../site';
import { isExternal, NEW_TAB } from '../lib/links.js';

interface Props {
  labels?: boolean;
}

const { labels = false } = Astro.props;
---
<ul class:list={['links', { labels }]}>
  {LINKS.map(({ label, href, icon }) => (
    <li>
      <a class={`link-${icon}`} href={href} title={labels ? undefined : label} {...(isExternal(href, String(Astro.site)) ? NEW_TAB : {})}>
        <span class="tile"><Icon name={icon} /></span><span class:list={[{ 'visually-hidden': !labels }]}>{label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .links li { margin: 0; }
  /* Icons only: the link is the tile. */
  .links a { display: flex; align-items: center; justify-content: center; gap: var(--space-3); min-height: 2.75rem; border: 1px solid var(--tile-edge, transparent); border-radius: var(--radius-md); background: var(--tile); color: var(--on-colour); font-size: var(--text-ui); font-weight: 800; text-decoration: none; transition: transform 0.15s ease; }
  .links .tile { display: contents; }
  .links :global(.icon) { width: 20px; height: 20px; }
  /* With names: two by two, each name beside its tile. */
  .links.labels { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .links.labels a { justify-content: flex-start; padding: var(--space-2); border-color: transparent; background: var(--wash); color: var(--ink); }
  .links.labels .tile { display: grid; place-items: center; flex: none; width: 2.25rem; height: 2.25rem; border: 1px solid var(--tile-edge, transparent); border-radius: var(--radius-sm); background: var(--tile); color: var(--on-colour); }
  .links.labels :global(.icon) { width: 18px; height: 18px; }
  /* Like the home page's tiles: the one pointed at rises a little. */
  .links a:focus-visible { transform: translateY(-2px); }
  /* Mouse only: on a touch screen, a tapped tile would stay raised. */
  @media (hover: hover) {
    .links a:hover { transform: translateY(-2px); }
  }
</style>
