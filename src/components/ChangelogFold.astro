---
// The bottom of the home page: a line right across the page with "Changelog" in the middle. Opening it shows the
// latest few days of the Changelog (ChangelogDays) and a way to all of it. It's a <details>, so it opens without
// any script and the keyboard and screen readers know it.
import ChangelogDays from './ChangelogDays.astro';
import Icon from './Icon.astro';
import { byDay } from '../lib/changelog.js';
import { changelogFile } from '../lib/changelog-file.js';

/** How many days the fold shows; /changelog/ has the rest. */
const DAYS = 3;
const days = byDay(changelogFile()).slice(0, DAYS);
---
{days.length > 0 && (
  <details class="fold">
    <summary><span class="label">Changelog<Icon name="chevron-down" /></span></summary>
    <div class="wrap panel">
      <div class="head">
        <h2>Latest changes</h2>
        <a href="/changelog/">See all changes</a>
      </div>
      <ChangelogDays days={days} />
    </div>
  </details>
)}

<style>
  .fold { padding-bottom: var(--space-4); }
  .fold[open] { padding-bottom: var(--space-8); }
  /* The line runs the full width of the window, the word sitting in a gap in the middle. */
  summary { display: flex; align-items: center; gap: var(--space-4); padding-block: var(--space-3); color: var(--muted); cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::before, summary::after { content: ''; flex: 1; height: 1px; background: var(--rule); }
  .label { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-3); border: 1px solid var(--rule); border-radius: var(--radius-pill); background: var(--surface); font-size: var(--text-sm); font-weight: 650; }
  summary:hover .label { border-color: var(--ink); color: var(--ink); }
  .label :global(.icon) { width: 1rem; height: 1rem; transition: transform 0.2s ease; }
  .fold[open] .label { color: var(--ink); }
  .fold[open] .label :global(.icon) { transform: rotate(180deg); }
  .panel { max-width: calc(52rem + 2 * var(--gutter)); padding-top: var(--space-5); }
  .fold[open] .panel { animation: open 0.25s ease-out; }
  @keyframes open {
    from { opacity: 0; translate: 0 -0.5rem; }
  }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); margin-bottom: var(--space-4); }
  h2 { margin: 0; font-size: var(--text-lg); font-weight: 750; }
  .head a { font-size: var(--text-sm); font-weight: 650; }

  @media (prefers-reduced-motion: reduce) {
    .fold[open] .panel { animation: none; }
    .label :global(.icon) { transition: none; }
  }
</style>
