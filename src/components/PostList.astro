---
// A compact list of posts: topic dot, title, date. Used by the tag pages.
import { formatDate } from '../lib/dates.js';
import { topicOf } from '../lib/topics.js';
import { postUrl, type Post } from '../lib/collections';
import { flowStyle } from '../lib/flow.js';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---
<ul class="list">
  {posts.map((post) => (
    <li style={`--c: var(--lane-${post.data.topic})`}>
      <a href={postUrl(post)}>
        <span class="dot" title={topicOf(post.data.topic).name} aria-hidden="true" />
        <span class="title" style={flowStyle(postUrl(post))}><span class="words">{post.data.title}</span></span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </a>
    </li>
  ))}
</ul>

<style>
  .list { display: grid; margin: 0; padding: 0; list-style: none; }
  a { display: flex; align-items: baseline; gap: var(--space-3); margin-inline: calc(-1 * var(--space-2)); padding: 0.625rem var(--space-2); border-bottom: var(--hairline) solid var(--rule); text-decoration: none; transition: background-color var(--motion-quick) ease; }
  .dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--c); translate: 0 -1px; }
  .title { flex: 1; min-width: 0; font-weight: 600; }
  /* Pointed at, a marker sweeps in behind the title's words, in its topic's colour. */
  .words { background: linear-gradient(color-mix(in srgb, var(--c) 38%, transparent), color-mix(in srgb, var(--c) 38%, transparent)) 0 88% / 0% 42% no-repeat; box-decoration-break: clone; -webkit-box-decoration-break: clone; transition: background-size var(--motion-soft) var(--ease-out); }
  a:focus-visible .words { background-size: 100% 42%; }
  @media (hover: hover) {
    a:hover .words { background-size: 100% 42%; }
  }
  time { color: var(--muted); font-size: var(--text-sm); font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
