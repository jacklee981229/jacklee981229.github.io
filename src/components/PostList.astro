---
// A compact list of posts: topic dot, title, date. Used by Writing, tag pages and "Recent posts".
import { formatDate } from '../lib/dates.js';
import { topicOf } from '../lib/topics.js';
import { postUrl, type Post } from '../lib/collections';

interface Props {
  posts: Post[];
  showTopic?: boolean;
}

const { posts, showTopic = true } = Astro.props;
---
<ul class="list">
  {posts.map((post) => (
    <li style={`--c: var(--lane-${post.data.topic})`}>
      <a href={postUrl(post)}>
        {showTopic && <span class="dot" title={topicOf(post.data.topic).name} aria-hidden="true" />}
        <span class="title">{post.data.title}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </a>
    </li>
  ))}
</ul>

<style>
  .list { display: grid; margin: 0; padding: 0; list-style: none; }
  /* A row under the mouse takes the tint of the site's standalone links (.go in global.css), a little past its words. */
  a { display: flex; align-items: baseline; gap: var(--space-3); margin-inline: calc(-1 * var(--space-2)); padding: 0.625rem var(--space-2); border-bottom: 1px solid var(--rule); text-decoration: none; transition: background-color 0.2s ease; }
  a:hover { background: var(--wash); }
  .dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--c); translate: 0 -1px; }
  .title { flex: 1; min-width: 0; font-weight: 600; }
  time { color: var(--muted); font-size: var(--text-sm); font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
