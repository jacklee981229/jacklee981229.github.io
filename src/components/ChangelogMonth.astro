---
// This month's changes as a calendar (calendarMonth in changelog.js): a square a day, whiter the more changes it had,
// each day with changes a link to its card on /changelog/. For a colour card (About's). Made when the site is built:
// the daily rebuild (deploy.yml) keeps today in step.
import { calendarMonth, shortDay } from '../lib/changelog.js';
import { isoDay } from '../lib/dates.js';

interface Props {
  /** Every change in the changelog (readChangelog in changelog.js). */
  changes: { day: string }[];
}

const { changes } = Astro.props;
const month = calendarMonth(changes, isoDay(new Date()));
const tip = (day: string, count: number) => `${shortDay(day)}: ${count || 'no'} change${count === 1 ? '' : 's'}`;
---
<div class="month">
  <p class="name">{month.name}</p>
  <div class="grid">
    {[...'MTWTFSS'].map((letter) => <span class="head" aria-hidden="true">{letter}</span>)}
    {Array.from({ length: month.blank }, () => <span aria-hidden="true" />)}
    {month.days.map((d) => (d.later
      ? <span class="square later" aria-hidden="true" />
      : d.changes
        ? <a class:list={['square', `step-${d.step}`, { today: d.today }]} href={`/changelog/#${d.day}`} title={tip(d.day, d.changes)} aria-label={tip(d.day, d.changes)} />
        : <span class:list={['square', 'step-0', { today: d.today }]} title={tip(d.day, 0)} aria-hidden="true" />))}
  </div>
</div>

<style>
  .month { --cell: 1.25rem; flex: none; }
  .name { margin: 0 0 var(--space-2); font-size: var(--text-sm); font-weight: 800; }
  .grid { display: grid; grid-template-columns: repeat(7, var(--cell)); gap: var(--space-1); }
  .head { color: var(--on-colour-soft); font-size: var(--text-xs); font-weight: 700; line-height: 1.4; text-align: center; }
  .square { width: var(--cell); height: var(--cell); border-radius: var(--radius-xs); }
  .step-0 { background: var(--changelog-step-0); }
  .step-1 { background: var(--changelog-step-1); }
  .step-2 { background: var(--changelog-step-2); }
  .step-3 { background: var(--changelog-step-3); }
  .step-4 { background: var(--changelog-step-4); }
  .later { box-shadow: inset 0 0 0 1px var(--changelog-later); }
  .today { outline: 2px solid var(--on-colour); outline-offset: 2px; }
  /* A day with changes grows under the pointer and with the keys' focus: a ring alone would look like today's. */
  a.square { transition: scale 0.15s ease; }
  a.square:hover, a.square:focus-visible { scale: 1.3; }

  @media (prefers-reduced-motion: reduce) {
    a.square { transition: none; }
  }
</style>
