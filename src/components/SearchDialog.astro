  .search[open] { animation: palette-in var(--motion-soft) var(--ease-out); }
  .search[open]::backdrop { animation: palette-shade var(--motion-quick) ease; }
  .search.closing { animation: palette-out var(--motion-quick) var(--ease-out) forwards; }
  .search.closing::backdrop { animation: palette-unshade var(--motion-quick) ease forwards; }
  @keyframes palette-out {
    to { opacity: 0; transform: translateY(-6px) scale(0.98); }
