  .results :global(.option) { position: relative; z-index: 1; display: flex; align-items: flex-start; gap: var(--space-3); padding: 0.625rem var(--space-3); border-radius: var(--radius-image); cursor: pointer; }
  .results :global(.option .icon) { margin-top: 0.1rem; color: var(--muted); }
  .results :global(.option[aria-selected='true'] .icon) { color: var(--ink); }
  /* A to-do or title with a long address and no spaces breaks anywhere instead of running out of the box. */
  .results :global(.text) { display: grid; gap: var(--space-1); min-width: 0; overflow-wrap: anywhere; }
  .results :global(.title) { font-weight: 650; }
  .results :global(.excerpt) { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; }
  /* A to-do's day, at the row's right end on the title's line. */
  .results :global(.day) { flex: none; margin-left: auto; padding-top: 0.15rem; color: var(--muted); font-size: var(--text-sm); font-weight: 700; white-space: nowrap; }
  .results :global(.day.late) { color: var(--todo-late); }
  /* The project's tag under Today, as /brief/'s rows have it. */
  .results :global(.project) { justify-self: start; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0.125rem var(--space-3); border-radius: var(--radius-pill); background: var(--wash); color: var(--muted); font-size: var(--text-xs); font-weight: 700; }
  /* The /now line's pictures: the picked one stands out, the rest step back. */
  /* The tiles stay in one row, shrinking on a phone. */
  .results :global(.picks) { display: flex; gap: var(--space-2); margin-top: var(--space-1); }
  .results :global(.pick) { position: relative; display: grid; place-items: center; flex: 0 1 72px; min-width: 0; aspect-ratio: 3 / 4; overflow: hidden; border-radius: var(--radius-image); outline: 2px solid transparent; outline-offset: 2px; background: var(--paper); color: var(--muted); font-size: var(--text-xs); font-weight: 600; text-align: center; transition: outline-color var(--motion-quick) var(--ease-out); }
  .results :global(.pick.picked) { outline-color: var(--focus); }
  /* Only the pictures step back: "No picture" keeps its words readable. */
  .results :global(.pick:not(.picked) img) { opacity: 0.45; }
