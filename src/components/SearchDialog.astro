---
// The command palette (Ctrl/⌘+K, "/", or the search button): actions, pages and the Lab's tools, games and effects,
// matched as you type (src/lib/palette.js), then posts from the Pagefind index that `npm run build` makes. The
// pages and the Lab come from lists the site already keeps (src/lib/palette-items.ts), so new ones show up by
// themselves. The list is drawn in the browser, with the site's own icons (src/lib/icons.js) as a hidden sprite.
// Jack's /login and /logout (src/lib/now-command.js) log this browser in to his Now editor, and /now changes Now from
// here once it has.
import Icon from './Icon.astro';
import { ICONS } from '../lib/icons.js';
import { openables, paletteItems } from '../lib/palette-items';
import { getCollection } from 'astro:content';

const items = await paletteItems();
const things = (await openables()).map(({ title, href }) => ({ title, href }));
// The Collection's things that have a cover: /now finds no pictures for those, as Now shows their cover.
const covered = (await getCollection('shelves')).flatMap((shelf) => shelf.data.items.filter((i) => i.image).map((i) => i.name.trim().toLowerCase()));
/** Every icon the list can show: the items' own and the actions'. */
const used = [...new Set([...items.map((i) => i.icon), 'sun', 'moon', 'star', 'dice', 'expand', 'shrink', 'sparkles', 'file', 'clock', 'user', 'check', 'sliders'])];
---
<dialog class="search" aria-label="Search or run a command" data-search>
  <div class="box">
    <Icon name="search" />
    <label class="visually-hidden" for="search-input">Search or run a command</label>
    <input id="search-input" type="search" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" placeholder="Search or run a command" autocomplete="off" spellcheck="false" />
    <form method="dialog"><button class="esc">Esc</button></form>
  </div>
  <div class="results" id="palette-list" role="listbox" aria-label="Results" data-results data-edge-fade="y"></div>
  <p class="status" data-status hidden></p>
  <script is:inline type="application/json" data-palette set:html={JSON.stringify({ items, things, covered })} />
  <svg class="sprite" aria-hidden="true" focusable="false">
    {used.map((name) => <symbol id={`pi-${name}`} viewBox="0 0 24 24" set:html={ICONS[name as keyof typeof ICONS]} />)}
  </svg>
</dialog>

<script>
  import { fingerprint, pickOne, search } from '../lib/palette.js';
  import { isNight, nightFound, setNight, switchTheme, themeLabel } from '../lib/theme';
  import { SITE } from '../site';
  import { announce } from '../lib/lab/page';
  import { LEVEL_KEY, PASS_KEY, oneLine, readNowCommand } from '../lib/now-command.js';
  import { sayWaiting } from '../lib/waiting.js';
  import { dayWords, malaysiaToday, todoGroups } from '../lib/todo-days.js';

  // keep: running it leaves the palette open (the /now steps).
  // pictures: the /now line's pictures to pick from.
  // day: a /todo row's day at its right end, red once passed. project: its project's tag, under Today.
  type Option = { title: string; group: string; icon: string; description?: string; excerpt?: string; words?: string[]; href?: string; run?: () => void; keep?: boolean; pictures?: string[]; day?: { text: string; kind: 'late' | 'today' | 'later' }; project?: string };
  type Result = { url: string; meta: { title?: string }; excerpt: string };
  type Pagefind = { search: (query: string) => Promise<{ results: { data: () => Promise<Result> }[] }> };

  /** The secret word's fingerprint (fingerprint() in palette.js). The word itself is in no file. */
  const SECRET = 'cea02fc9';

  const dialog = document.querySelector<HTMLDialogElement>('[data-search]');
  const input = dialog?.querySelector('input');
  const list = dialog?.querySelector<HTMLElement>('[data-results]');
  const status = dialog?.querySelector<HTMLElement>('[data-status]');
  const data = JSON.parse(dialog?.querySelector('[data-palette]')?.textContent ?? '{}') as { items: Option[]; things: { title: string; href: string }[]; covered: string[] };

  let pagefind: Promise<Pagefind | null> | null = null;
  // The index only exists in a built site, so `npm run dev` finds no posts (everything else works there).
  const loadIndex = () => {
    const path = '/pagefind/pagefind.js';
    pagefind ??= import(/* @vite-ignore */ path).catch(() => null);
    return pagefind;
  };

  /** Shows `text` under the list; `waiting` ends it in the waiting dots. */
  const say = (text: string, waiting = false) => {
    if (!status) return;
    status.hidden = !text;
    if (waiting) sayWaiting(status, text);
    else status.textContent = text;
  };

  /** The thing that shows full screen on this page (the Travel Map, a game, an effect), if the browser can. */
  const fullscreenTarget = () => (document.fullscreenEnabled ? document.querySelector<HTMLElement>('[data-fullscreen]') : null);

  /** The actions, as they stand right now: their labels change with the theme and the full screen. */
  function actions(): Option[] {
    const target = fullscreenTarget();
    const night = isNight();
    return [
      { title: themeLabel(), group: 'Actions', icon: night ? 'star' : document.documentElement.dataset.theme === 'dark' ? 'sun' : 'moon', words: ['theme', 'dark', 'light', 'mode', 'colours', 'colors'], run: switchTheme },
      ...(SITE.surprise ? [{ title: 'Surprise me', group: 'Actions', icon: 'dice', description: 'Open something at random', words: ['random', 'lucky', 'anything'], run: surprise }] : []),
      ...(target ? [{ title: document.fullscreenElement ? 'Exit fullscreen' : 'Fullscreen', group: 'Actions', icon: document.fullscreenElement ? 'shrink' : 'expand', description: document.fullscreenElement ? undefined : target.dataset.fullscreen, words: ['full', 'screen', 'big', 'expand'], run: toggleFullscreen }] : []),
      // Once found, the night sky can be gone back to; while it's on, the theme item above leaves it.
      ...(nightFound() && !night ? [{ title: 'Starry Night', group: 'Actions', icon: 'star', description: 'Turn the site into a night sky', words: ['night', 'sky', 'stars', 'space'], run: () => setNight(true) }] : []),
    ];
  }

  function surprise() {
    const pick = pickOne(data.things ?? [], location.pathname);
    if (pick) location.href = pick.href;
  }

  function toggleFullscreen() {
    if (document.fullscreenElement) document.exitFullscreen();
    else fullscreenTarget()?.requestFullscreen().catch(() => {});
  }

  /** The secret word typed exactly: one row and nothing else, saying nothing. */
  function secretRow(query: string): Option[] {
    return query.trim() && fingerprint(query) === SECRET ? [{ title: '???', group: 'Actions', icon: 'sparkles', run: findNight }] : [];
  }

  function findNight() {
    setNight(true);
    document.dispatchEvent(new CustomEvent('nightfound'));
    const note = 'You found the night sky. It stays on until you press the star at the top, or pick “Leave the night sky” here.';
    announce(note);
    document.dispatchEvent(new CustomEvent('nightnote', { detail: note }));
  }

  // /login and /now: the login pass this browser keeps (none for visitors), whether the box is asking for the password, a
  // request on its way, and Claude's tidied line waiting for a second Enter, with the game it names (which item, the
  // title to search, the item's thing), Steam's pictures of it and the one picked (pictures.length is "No picture").
  const pass = {
    get: () => { try { return localStorage.getItem(PASS_KEY) ?? ''; } catch { return ''; } },
    set: (value: string) => {
      try { if (value) localStorage.setItem(PASS_KEY, value); else localStorage.removeItem(PASS_KEY); } catch { /* blocked: logs in again next time */ }
      // The menu's Dashboard link comes and goes with the login at once (Header.astro); its colour is read again.
      document.documentElement.toggleAttribute('data-signed-in', !!value);
      delete document.documentElement.dataset.dash;
      try { localStorage.removeItem(LEVEL_KEY); } catch { /* nothing kept */ }
      if (value) import('../lib/dashboard-nav').then((m) => m.refreshLevel());
    },
  };
  let asking = false;
  let nowBusy = false;
  type Game = { line: number; name: string; value: string };
  let tidied: { words: string; text: string; sha: string; game: Game | null; pictures: string[]; pick: number } | null = null;

  async function callNow(path: string, body?: unknown): Promise<{ status: number; data: any }> {
    try {
      const headers: Record<string, string> = { Authorization: `Bearer ${pass.get()}`, ...(body === undefined ? {} : { 'Content-Type': 'application/json' }) };
      const answer = await fetch(`${SITE.nowEditor}${path}`, body === undefined ? { headers } : { method: 'POST', headers, body: JSON.stringify(body) });
      return { status: answer.status, data: await answer.json().catch(() => ({ error: 'Something went wrong. Please try again.' })) };
    } catch {
      return { status: 0, data: { error: "Couldn't reach the Now editor. Check the connection and try again." } };
    }
  }

  // /todo: Jack's open to-dos as his laptop last pushed them (workers/now/todos.js), asked for once each time the
  // palette opens: the ones whose day has come under Today, then each project's (src/lib/todo-days.js).
  type TodoList = { pushedAt: number | null; projects: string[]; items: { id: string; project: string; text: string; notes: string; on?: string }[] };
  let todoList: Promise<{ status: number; data: any }> | null = null;
  const NOTES_SHOWN = 160;

  /** "Synced 10:42", with the day when it wasn't today. @param {number} at */
  function synced(at: number) {
    const when = new Date(at);
    const time = when.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    return when.toDateString() === new Date().toDateString() ? `Synced ${time}` : `Synced ${when.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}, ${time}`;
  }

  async function showTodos(ticket: number) {
    options = [];
    draw();
    say('Getting your to-dos', true);
    todoList ??= callNow('/api/todos');
    const { status, data: list } = await todoList;
    if (ticket !== latest) return;
    if (list.error) {
      todoList = null;
      return nowFailed(status, list.error);
    }
    const { pushedAt, projects, items } = list as TodoList;
    const today = malaysiaToday();
    const short = (notes: string) => (notes.length > NOTES_SHOWN ? `${notes.slice(0, NOTES_SHOWN)}…` : notes);
    options = todoGroups(projects, items, today).flatMap((group) =>
      group.items.map((i) => ({
        title: i.text,
        group: group.name,
        icon: 'check',
        // Today mixes projects, so its rows carry theirs as a tag; there the group's name already says "Today".
        project: group.today ? i.project : undefined,
        description: short(i.notes) || undefined,
        day: i.on && i.on !== today ? dayWords(i.on, today) : undefined,
        keep: true,
      })),
    );
    draw();
    if (!pushedAt) return say('No to-dos have come from the laptop yet.');
    say(options.length ? synced(pushedAt) : `Nothing to do. ${synced(pushedAt)}`);
  }

  /** The row for what's typed: log in or out, tidy the words, or save Claude's line for them. */
  function nowRows(command: { login: true } | { logout: true } | { words: string }): Option[] {
    if ('login' in command) return [{ title: 'Log in', group: 'Actions', icon: 'user', description: 'Asks for the editor password', run: askPassword, keep: true }];
    if ('logout' in command) return [{ title: 'Log out', group: 'Actions', icon: 'user', description: 'Forgets the login in this browser', run: logOut, keep: true }];
    const { words } = command;
    if (!words) return [];
    if (tidied?.words === words) {
      const pictures = tidied.pictures.length ? tidied.pictures : undefined;
      const description = pictures ? 'Enter saves this as Now with the picture · ← → picks another · Esc cancels' : 'Enter saves this as Now · Esc cancels';
      return [{ title: oneLine(tidied.text), group: 'Actions', icon: 'clock', description, run: saveNow, keep: true, pictures }];
    }
    return [{ title: `Change Now to “${words}”`, group: 'Actions', icon: 'clock', description: 'Claude tidies it first, then you check it', run: () => tidyNow(words), keep: true }];
  }

  function askPassword() {
    if (!input) return;
    asking = true;
    input.value = '';
    input.type = 'password';
    input.placeholder = 'Password';
    options = [];
    draw();
    say('Type the password, then press Enter.');
  }

  function stopAsking() {
    if (!input || !asking) return;
    asking = false;
    input.value = '';
    input.type = 'search';
    input.placeholder = 'Search or run a command';
  }

  async function logIn(password: string) {
    if (!input || !password) return;
    nowBusy = true;
    say('Logging in', true);
    const { data } = await callNow('/api/login', { password });
    nowBusy = false;
    if (data.error) return say(data.error);
    pass.set(data.pass);
    stopAsking();
    input.value = '/now ';
    update(input.value);
    say('Logged in. Type what you’re up to after /now.');
  }

  /** The reload hides what the login showed on this page (scores, drafts). */
  function logOut() {
    pass.set('');
    location.reload();
  }

  /** Anything but a login that ran out keeps its message; that one forgets the pass. */
  function nowFailed(status: number, error: string) {
    if (status === 401) {
      pass.set('');
      say('Your login ran out. Type /login to log in again.');
    } else say(error);
  }

  async function tidyNow(words: string) {
    if (nowBusy) return;
    nowBusy = true;
    say('Claude is tidying', true);
    const [made, current] = await Promise.all([callNow('/api/tidy', { text: words }), callNow('/api/now')]);
    nowBusy = false;
    if (made.data.error || current.data.error) return nowFailed(made.status === 401 ? 401 : current.status, made.data.error ?? current.data.error);
    const game: Game | null = made.data.game ?? null;
    tidied = { words, text: made.data.text, sha: current.data.sha, game, pictures: [], pick: 0 };
    if (input && readNowCommand(input.value)) update(input.value);
    const known = game && [game.name, game.value].some((name) => data.covered?.includes(name.trim().toLowerCase()));
    if (game && !known) findPictures(tidied, game);
  }

  /** Steam's pictures of the game the line names, shown under it once they come. */
  async function findPictures(line: NonNullable<typeof tidied>, game: Game) {
    nowBusy = true;
    say('Finding pictures', true);
    const { status, data: found } = await callNow(`/api/pictures?name=${encodeURIComponent(game.name)}`);
    nowBusy = false;
    if (tidied !== line) return;
    if (found.error) return nowFailed(status, `${found.error} Enter saves the line without one.`);
    line.pictures = Array.isArray(found.pictures) ? found.pictures : [];
    if (input && readNowCommand(input.value)) update(input.value);
    say(line.pictures.length ? '' : `No pictures of ${game.name} on Steam. Enter saves the line without one.`);
  }

  /** Picks the picture at this place (the last place is "No picture"), without drawing the list again. */
  function pickPicture(index: number) {
    if (!tidied?.pictures.length) return;
    const count = tidied.pictures.length + 1;
    const pick = (index + count) % count;
    tidied.pick = pick;
    list?.querySelectorAll<HTMLElement>('[data-pick]').forEach((tile) => tile.classList.toggle('picked', Number(tile.dataset.pick) === pick));
  }

  async function saveNow() {
    if (!tidied || nowBusy) return;
    nowBusy = true;
    say('Saving', true);
    const { game, pictures, pick } = tidied;
    const picture = game && pick < pictures.length ? { line: game.line, url: pictures[pick] } : undefined;
    const { status, data } = await callNow('/api/save', { text: tidied.text, sha: tidied.sha, picture });
    nowBusy = false;
    if (data.error) return nowFailed(status, data.error);
    tidied = null;
    options = [];
    draw();
    say('Saved. Now on the site changes in about two minutes.');
  }

  let options: Option[] = [];
  let posts: Option[] = [];
  let active = 0;

  // One highlight slides from result to result as the keys or the mouse move; a list drawn afresh puts it in place.
  const highlight = document.createElement('div');
  highlight.className = 'highlight';
  highlight.setAttribute('aria-hidden', 'true');
  function place(slide: boolean) {
    const option = list?.querySelector<HTMLElement>(`#po-${active}`);
    if (!option) return;
    if (!slide) highlight.style.transition = 'none';
    highlight.style.height = `${option.offsetHeight}px`;
    highlight.style.transform = `translateY(${option.offsetTop}px)`;
    if (!slide) {
      void highlight.offsetHeight;
      highlight.style.transition = '';
    }
  }
  /** Marks a result as the one Enter would run, without drawing the list again. @param index its place in the list */
  function select(index: number) {
    if (!list) return;
    active = index;
    list.querySelectorAll('[aria-selected="true"]').forEach((o) => o.setAttribute('aria-selected', 'false'));
    const option = list.querySelector<HTMLElement>(`#po-${active}`);
    if (!option) return;
    option.setAttribute('aria-selected', 'true');
    input?.setAttribute('aria-activedescendant', option.id);
    option.scrollIntoView({ block: 'nearest' });
    place(true);
  }

  /** The short list for an empty box. */
  function suggestions(): Option[] {
    const [theme, ...rest] = actions();
    const home = data.items.find((i) => i.href === '/');
    const lab = data.items.find((i) => i.href === '/lab/');
    return [theme, ...(home ? [home] : []), ...(lab ? [lab] : []), ...rest].map((o) => ({ ...o, group: '' }));
  }

  function draw() {
    if (!list || !input) return;
    const all = [...options, ...posts];
    active = Math.min(active, Math.max(0, all.length - 1));
    const groups = new Map<string, number[]>();
    all.forEach((o, i) => groups.set(o.group, [...(groups.get(o.group) ?? []), i]));
    list.replaceChildren(
      ...(all.length ? [highlight] : []),
      ...[...groups].map(([group, indexes], g) => {
        const box = document.createElement('div');
        box.setAttribute('role', 'group');
        if (group) {
          const title = document.createElement('div');
          title.className = 'group-title';
          title.id = `pg-${g}`;
          title.textContent = group;
          title.setAttribute('role', 'presentation');
          box.setAttribute('aria-labelledby', title.id);
          box.append(title);
        }
        box.append(...indexes.map((i) => optionElement(all[i], i)));
        return box;
      }),
    );
    const current = list.querySelector<HTMLElement>(`#po-${active}`);
    if (current) {
      input.setAttribute('aria-activedescendant', current.id);
      current.scrollIntoView({ block: 'nearest' });
      place(false);
    } else input.removeAttribute('aria-activedescendant');
  }

  function optionElement(option: Option, index: number) {
    const el = document.createElement('div');
    el.className = 'option';
    el.id = `po-${index}`;
    el.setAttribute('role', 'option');
    el.setAttribute('aria-selected', String(index === active));
    el.dataset.index = String(index);
    const svgNs = 'http://www.w3.org/2000/svg';
    const icon = document.createElementNS(svgNs, 'svg');
    icon.setAttribute('class', 'icon');
    icon.setAttribute('aria-hidden', 'true');
    const use = document.createElementNS(svgNs, 'use');
    use.setAttribute('href', `#pi-${option.icon}`);
    icon.append(use);
    const text = document.createElement('span');
    text.className = 'text';
    const title = document.createElement('span');
    title.className = 'title';
    title.textContent = option.title;
    text.append(title);
    if (option.project) {
      const project = document.createElement('span');
      project.className = 'project';
      project.textContent = option.project;
      text.append(project);
    }
    if (option.excerpt) {
      const excerpt = document.createElement('span');
      excerpt.className = 'excerpt';
      // Pagefind escapes the page text and only adds <mark> around the matches.
      excerpt.innerHTML = option.excerpt;
      text.append(excerpt);
    } else if (option.description) {
      const description = document.createElement('span');
      description.className = 'excerpt';
      description.textContent = option.description;
      text.append(description);
    }
    if (option.pictures) text.append(pictureStrip(option.pictures));
    el.append(icon, text);
    if (option.day) {
      const day = document.createElement('span');
      day.className = `day ${option.day.kind}`;
      day.textContent = option.day.text;
      el.append(day);
    }
    return el;
  }

  /** The /now line's pictures as tiles, each cut to the home card's shape, then "No picture"; a click picks one. */
  function pictureStrip(pictures: string[]) {
    const strip = document.createElement('span');
    strip.className = 'picks';
    strip.append(
      ...[...pictures, ''].map((address, i) => {
        const tile = document.createElement('span');
        tile.className = 'pick';
        tile.dataset.pick = String(i);
        tile.classList.toggle('picked', i === tidied?.pick);
        if (address) {
          const img = document.createElement('img');
          img.src = address;
          img.alt = `Picture ${i + 1}`;
          img.width = 72;
          img.height = 96;
          tile.append(img);
        } else tile.textContent = 'No picture';
        return tile;
      }),
    );
    return strip;
  }

  let latest = 0;
  async function update(query: string) {
    const ticket = ++latest;
    posts = [];
    active = 0;
    if (!query.trim()) {
      options = suggestions();
      say('');
      draw();
      return;
    }
    const command = readNowCommand(query);
    // Visitors' /now, /todo and /dashboard are just searches; a browser that has logged in gets the commands.
    if (command && 'todo' in command) {
      if (pass.get()) return showTodos(ticket);
    } else if (command && 'dashboard' in command) {
      if (pass.get()) {
        options = [{ title: 'Dashboard', group: 'Actions', icon: 'sliders', description: 'What needs you, and what you did', href: '/dashboard/' }];
        draw();
        return say('');
      }
    } else if (command && ('login' in command || pass.get())) {
      options = nowRows(command);
      draw();
      return say(options.length ? '' : 'Type what you’re up to after /now, like “/now Playing chess”.');
    }
    const secret = secretRow(query);
    options = secret.length ? secret : search([...actions(), ...data.items], query);
    draw();
    if (secret.length) return say('');
    const index = await loadIndex();
    if (ticket !== latest) return;
    if (index) {
      const found = await index.search(query);
      const results = await Promise.all(found.results.slice(0, 8).map((r) => r.data()));
      if (ticket !== latest) return;
      posts = results.map((r) => ({ title: r.meta.title ?? r.url, group: 'Posts', icon: 'file', excerpt: r.excerpt, href: r.url }));
      draw();
    }
    if (options.length + posts.length === 0) say(`Nothing matches “${query.trim()}”. Try a shorter word.`);
    else if (!index) say('Posts can only be searched on the built site.');
    else say('');
  }

  function runOption(index: number) {
    const option = [...options, ...posts][index];
    if (!option || !dialog) return;
    if (option.keep) return option.run?.();
    dialog.close();
    if (option.run) option.run();
    else if (option.href) location.href = option.href;
  }

  /** Whatever opened the palette gets the focus back when it closes. */
  let opener: HTMLElement | null = null;

  /** Bumped by every close and every open, so a close that was cut short by an open never finishes. */
  let closing = 0;

  /** Esc, the Esc button and a click outside: it fades out first. A result closes it at once (runOption), since the
   *  page flow or the theme circle takes over and would catch it half faded. */
  function shut() {
    if (!dialog?.open || dialog.classList.contains('closing')) return;
    const box = dialog;
    const ticket = ++closing;
    box.classList.add('closing');
    const done = () => {
      if (ticket !== closing) return;
      box.classList.remove('closing');
      box.close();
    };
    // With less motion asked for there is no animation to wait for, and it closes at once. An open cuts the fade
    // short, which rejects; that close is simply dropped.
    Promise.all(box.getAnimations().map((a) => a.finished)).then(done, done);
  }

  function open() {
    // Asked for again while fading out: it comes straight back.
    if (dialog?.classList.contains('closing')) {
      closing++;
      dialog.classList.remove('closing');
      input?.focus();
      return;
    }
    if (!dialog || !input || dialog.open) return;
    opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    input.value = '';
    update('');
    todoList = null;
    dialog.showModal();
    input.focus();
    loadIndex();
  }

  let timer: ReturnType<typeof setTimeout> | undefined;
  /** True between a keystroke and the list catching up with it. */
  let pending = false;
  input?.addEventListener('input', () => {
    if (asking) return;
    clearTimeout(timer);
    pending = true;
    timer = setTimeout(() => {
      pending = false;
      update(input.value);
    }, 100);
  });
  input?.addEventListener('keydown', (e) => {
    // A Chinese or Japanese word still being put together: its keys belong to the input method (the arrows pick a
    // candidate, Esc drops the word, Enter chooses it), not to the palette.
    if (e.isComposing || e.keyCode === 229) return;
    const count = options.length + posts.length;
    // With pictures under the /now line, the side arrows pick one instead of moving through the words.
    if ((e.key === 'ArrowLeft' || e.key === 'ArrowRight') && options[active]?.pictures && tidied) {
      e.preventDefault();
      pickPicture(tidied.pick + (e.key === 'ArrowRight' ? 1 : -1));
    } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (!count) return;
      select(e.key === 'ArrowDown' ? (active + 1) % count : (active - 1 + count) % count);
    } else if (e.key === 'Escape') {
      // A search box's own Esc only empties it; here it closes the palette in one press.
      e.preventDefault();
      shut();
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (nowBusy) return;
      if (asking) return void logIn(input.value);
      // The list may lag a keystroke behind; catch it up first (everything but the posts is worked out at once).
      if (pending) {
        clearTimeout(timer);
        pending = false;
        update(input.value);
      }
      runOption(active);
    }
  });
  list?.addEventListener('click', (e) => {
    const tile = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-pick]') : null;
    if (tile) return pickPicture(Number(tile.dataset.pick));
    const option = e.target instanceof Element ? e.target.closest<HTMLElement>('[role="option"]') : null;
    if (option) runOption(Number(option.dataset.index));
  });
  list?.addEventListener('pointermove', (e) => {
    const option = e.target instanceof Element ? e.target.closest<HTMLElement>('[role="option"]') : null;
    if (option && Number(option.dataset.index) !== active) select(Number(option.dataset.index));
  });
  dialog?.addEventListener('close', () => {
    stopAsking();
    if (opener?.isConnected) opener.focus();
    opener = null;
  });
  document.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('[data-search-open]')) open();
  });
  document.addEventListener('keydown', (e) => {
    const typing = e.target instanceof HTMLElement && (e.target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName));
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      open();
    } else if (e.key === '/' && !typing) {
      e.preventDefault();
      open();
    }
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) shut();
  });
  dialog?.addEventListener('cancel', (e) => {
    e.preventDefault();
    shut();
  });
  dialog?.querySelector('form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    shut();
  });
</script>

<style>
  .search { width: min(40rem, calc(100vw - 2rem)); max-height: min(34rem, 80dvh); margin: 12vh auto auto; padding: 0; overflow: hidden; border: 0; border-radius: var(--radius-lg); background: var(--surface); color: var(--ink); box-shadow: var(--shadow-dialog); }
