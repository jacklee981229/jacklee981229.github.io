  .box { display: flex; align-items: center; gap: var(--space-3); padding: 0.625rem var(--space-4); border-bottom: var(--hairline) solid var(--rule); }
  .box:focus-within { box-shadow: inset 0 -2px var(--focus); }
  input { flex: 1; min-width: 0; padding: var(--space-2) 0; border: 0; background: transparent; color: inherit; font-size: var(--text-md); font-weight: 500; }
  input:focus { outline: none; }
  .esc { padding: var(--space-1) var(--space-2); border: 0; border-radius: var(--radius-sm); background: var(--wash); color: var(--muted); font-size: var(--text-xs); font-weight: 600; cursor: pointer; }
  /* A column while open, the list taking what's left, so a long list never pushes the status line (/todo's "Synced …")
     out of the dialog. Only while open: a closed dialog keeps the browser's display: none. */
  .search[open] { display: flex; flex-direction: column; }
  .results { position: relative; flex: 1 1 auto; min-height: 0; padding: var(--space-2); overflow-y: auto; }
  .results :global(.highlight) { position: absolute; top: 0; left: var(--space-2); right: var(--space-2); border-radius: var(--radius-image); background: var(--wash); box-shadow: inset 2px 0 var(--focus); pointer-events: none; transition: transform var(--motion-quick) var(--ease-out), height var(--motion-quick) var(--ease-out); }
  .results:empty { display: none; }
