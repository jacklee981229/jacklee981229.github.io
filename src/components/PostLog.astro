---
// The home page timeline: a date ruler, the topic lanes and one card per post, then the page links.
import PostCard from './PostCard.astro';
import { timelineRows } from '../lib/graph.js';
import { homePageUrl } from '../lib/posts.js';
import { TOPICS } from '../lib/topics.js';
import type { Post } from '../lib/collections';

interface Props {
  posts: Post[];
  start: number;
  end: number;
  page: number;
  pages: number;
}

const { posts, start, end, page, pages } = Astro.props;
const rows = timelineRows(posts, TOPICS, start, end);
const lane = (x: number, topic: string) => `--x:${x};--c:var(--lane-${topic})`;
---
<ol class="log" style={`--lanes:${TOPICS.length}`}>
  {rows.map((row, r) => {
    if (row.kind === 'post') {
      const post = posts[row.index];
      return (
        <li class="row commit" style={`--row:${r}`}>
          <div class="ruler" aria-hidden="true">{row.month && <span class="month">{row.month}</span>}</div>
          <div class="graph" aria-hidden="true">
            {row.lanes.map((l) => (
              <>
                {l.top && <span class="seg top" data-lane={l.topic} style={lane(l.x, l.topic)} />}
                {l.bottom && <span class="seg bottom" data-lane={l.topic} style={lane(l.x, l.topic)} />}
                {l.node && <span class="link" data-lane={l.topic} style={lane(l.x, l.topic)} />}
                {l.node && <span class="node" data-lane={l.topic} style={lane(l.x, l.topic)} />}
              </>
            ))}
          </div>
          <PostCard post={post} />
        </li>
      );
    }
    return (
      <li class:list={['row', row.kind]} style={`--row:${r}`}>
        <div class="graph" aria-hidden="true">
          {row.lanes.map((l) => <span class:list={['seg', row.kind === 'break' ? 'dash' : 'full']} data-lane={l.topic} style={lane(l.x, l.topic)} />)}
        </div>
        {row.kind === 'year' ? <p class="year">{row.year}</p> : <p class="break-label">{row.label}</p>}
      </li>
    );
  })}
</ol>

{pages > 1 && (
  <nav class="pager" aria-label="Pages">
    <span>Page {page} of {pages}</span>
    <span class="links">
      {page > 1 && <a href={homePageUrl(page - 1)}>Newer posts</a>}
      {page < pages && <a href={homePageUrl(page + 1)}>Older posts</a>}
    </span>
  </nav>
)}

<style>
  /* Spacing between rows lives inside the rows (as card margin), so the lanes run unbroken from row to row. */
  .log {
    --lane-gap: 12px;
    --node: 12px;
    --stroke: 2.5px;
    --node-y: 30px;
    --col-gap: var(--space-4);
    --ruler-w: 3rem;
    --graph-w: calc((var(--lanes) - 1) * var(--lane-gap) + var(--node) + 4px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row { position: relative; display: grid; grid-template-columns: var(--ruler-w) var(--graph-w) minmax(0, 1fr); column-gap: var(--col-gap); }
  .row > * { grid-row: 1; }
  .ruler { grid-column: 1; }
  .graph { position: relative; grid-column: 2; }
  .commit > :global(.card) { grid-column: 3; margin-bottom: 1.25rem; }
  .month { display: block; padding-top: calc(var(--node-y) - 0.625rem); color: var(--muted); font-size: 0.8125rem; font-weight: 650; text-align: right; }
  .year { grid-column: 1; margin: 0; padding-block: var(--space-1) var(--space-4); font-size: var(--text-ui); font-weight: 750; text-align: right; font-variant-numeric: tabular-nums; }
  .break-label { display: flex; grid-column: 3; align-items: center; gap: var(--space-3); margin: 0; padding-block: var(--space-1) var(--space-5); color: var(--muted); font-size: var(--text-sm); font-weight: 600; }
  .break-label::after { content: ''; flex: 1; border-top: 1px dashed var(--rule); }

  .seg { position: absolute; left: calc(var(--x) * var(--lane-gap) + var(--node) / 2 - var(--stroke) / 2); width: var(--stroke); background: var(--c); transform-origin: top; transition: opacity 0.2s ease; }
  .seg.top { top: 0; height: var(--node-y); }
  .seg.bottom { top: var(--node-y); bottom: 0; }
  .seg.full, .seg.dash { top: 0; bottom: 0; }
  .seg.dash { background: repeating-linear-gradient(to bottom, var(--c) 0 4px, transparent 4px 9px); }
  .link { position: absolute; top: calc(var(--node-y) - var(--stroke) / 2); left: calc(var(--x) * var(--lane-gap) + var(--node) / 2); right: calc(var(--col-gap) * -1); height: var(--stroke); background: var(--c); transform-origin: left; transition: opacity 0.2s ease; }
  .node { position: absolute; top: calc(var(--node-y) - var(--node) / 2); left: calc(var(--x) * var(--lane-gap)); width: var(--node); height: var(--node); border-radius: 50%; background: var(--paper); box-shadow: inset 0 0 0 var(--stroke) var(--c); transition: background-color 0.15s ease, opacity 0.2s ease; }
  .commit:hover .node, .commit:focus-within .node { background: var(--c); }
  .dim { opacity: 0.18; }

  .pager { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-2) var(--space-4); margin-top: var(--space-2); padding: var(--space-4) 0 0 calc(var(--ruler-w) + var(--graph-w) + var(--col-gap) * 2); color: var(--muted); font-size: var(--text-ui); }
  .links { display: flex; gap: var(--space-5); }
  .pager a { padding-block: 0.375rem; color: var(--ink); font-weight: 650; }

  /* One orchestrated moment: the lanes draw themselves in on load. */
  @media (prefers-reduced-motion: no-preference) {
    .seg { animation: draw 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--row, 0) * 45ms); }
    .link { animation: reach 0.35s ease-out both; animation-delay: calc(var(--row, 0) * 45ms + 180ms); }
    .node { animation: pop 0.3s ease-out both; animation-delay: calc(var(--row, 0) * 45ms + 140ms); }
    @keyframes draw { from { transform: scaleY(0); } }
    @keyframes reach { from { transform: scaleX(0); } }
    @keyframes pop { from { transform: scale(0); } }
  }

  /* Phones drop the month ruler (each card shows its date) and put the year beside the lanes. */
  @media (max-width: 719px) {
    .log { --lane-gap: 9px; --node: 10px; --stroke: 2px; --node-y: 22px; --col-gap: 0.625rem; }
    .row { grid-template-columns: var(--graph-w) minmax(0, 1fr); }
    .ruler { display: none; }
    .graph { grid-column: 1; }
    .commit > :global(.card), .year, .break-label { grid-column: 2; }
    .commit > :global(.card) { margin-bottom: var(--space-4); }
    .year { text-align: left; }
    .pager { padding-left: 0; }
  }
</style>
