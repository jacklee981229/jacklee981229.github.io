---
// The welcome screen (style B, "Curtain"). The head script in Base.astro decides whether it plays by adding html.welcome.
// The whole timeline is CSS, so the screen clears itself at 3 s even if the script below never runs.
import { SITE } from '../site';

const words = SITE.title.split(' ');
---
<div class="curtain" aria-hidden="true">
  <div class="stage">
    <p class="kicker line"><span class="word" style="--d: 0.1s">Welcome</span> <span class="word" style="--d: 0.18s">to</span></p>
    <p class="name line">{words.map((word, i) => <>{i > 0 && ' '}<span class="word" style={`--d: ${0.38 + i * 0.12}s`}>{word}</span></>)}</p>
    <div class="bar"></div>
  </div>
</div>

<script>
  // A click, a key or a scroll skips the screen: it fades out at once and the title starts typing straight away.
  const root = document.documentElement;
  const curtain = document.querySelector<HTMLElement>('.curtain');
  if (curtain && root.classList.contains('welcome')) {
    const listening = new AbortController();
    const done = () => {
      listening.abort();
      curtain.remove();
    };
    // The lift is the curtain's own animation; its children's animations bubble up here too.
    curtain.addEventListener('animationend', (e) => { if (e.target === curtain) done(); });
    const skip = () => {
      listening.abort();
      // The title's typing waits for --type-start (index.astro); move that to the moment the fade ends.
      const typing = document.querySelector('#site-title .ch')?.getAnimations()[0];
      const elapsed = typing?.startTime == null ? 0 : Number(document.timeline.currentTime) - Number(typing.startTime);
      root.style.setProperty('--type-start', `${Math.round(elapsed) + 350}ms`);
      curtain.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 350, easing: 'ease', fill: 'forwards' }).finished.then(done);
    };
    for (const type of ['pointerdown', 'keydown', 'wheel']) document.addEventListener(type, skip, { signal: listening.signal });
  }
</script>

<style>
  .curtain { display: none; }
  /* Words slide up from behind a line, a bar fills, then at 2.2 s the whole screen lifts away, done by 3 s. */
  :global(html.welcome) .curtain { position: fixed; inset: 0; z-index: 40; display: grid; place-items: center; background: var(--paper); box-shadow: var(--shadow-dialog); animation: lift 0.8s 2.2s cubic-bezier(0.76, 0, 0.24, 1) forwards; }
  /* The title types as the curtain uncovers it (see index.astro). */
  :global(html.welcome) { --type-start: 2700ms; }
  .stage { display: grid; justify-items: center; text-align: center; animation: stage-out 0.6s 2.2s cubic-bezier(0.76, 0, 0.24, 1) forwards; }
  /* Each line is a mask the words rise into; the bottom padding keeps the descenders (the "p") inside it. */
  .line { display: block; overflow: hidden; padding: 0.04em 0.08em 0.18em; margin-bottom: -0.14em; }
  .kicker { margin: 0 0 0.35em; color: var(--muted); font-size: clamp(1.1rem, 2.2vw, 1.6rem); font-weight: 500; letter-spacing: -0.01em; }
  .name { margin: 0; font-size: clamp(3.4rem, 11vw, 9rem); font-weight: var(--display-weight); line-height: 0.95; letter-spacing: var(--display-tracking); }
  .word { display: inline-block; animation: word-up 1s var(--d) cubic-bezier(0.16, 1, 0.3, 1) both; }
  .bar { position: relative; width: clamp(120px, 16vw, 220px); height: 3px; margin-top: var(--space-6); overflow: hidden; border-radius: var(--radius-pill); background: var(--rule); }
  .bar::after { content: ''; position: absolute; inset: 0; background: var(--ink); transform-origin: left; animation: bar-fill 1.7s 0.5s cubic-bezier(0.65, 0, 0.35, 1) both; }
  @keyframes word-up { from { transform: translateY(110%); } }
  @keyframes bar-fill { from { transform: scaleX(0); } }
  @keyframes stage-out { to { transform: translateY(-8vh); opacity: 0; } }
  @keyframes lift { to { transform: translateY(-100%); visibility: hidden; } }
  /* Backup for the head script's check: global.css turns animations off for less motion, so the curtain would never lift. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.welcome) .curtain { display: none; }
  }
</style>
