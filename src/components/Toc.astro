---
// "On this page": the post's h2 and h3 headings. Open beside the post on wide screens, folded above it on narrow ones.
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length >= 2 && (
  <details class="toc" data-toc data-pagefind-ignore>
    <summary>On this page</summary>
    <ol>
      {items.map((h) => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ol>
  </details>
)}

<script>
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
  if (toc) {
    const wide = matchMedia('(min-width: 1100px)');
    const sync = () => { toc.open = wide.matches; };
    wide.addEventListener('change', sync);
    sync();
    // Mark the heading currently being read.
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of links) {
          if (a.hash === `#${entry.target.id}`) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        }
      }
    }, { rootMargin: '0px 0px -70% 0px' });
    for (const a of links) {
      const heading = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (heading) observer.observe(heading);
    }
  }
</script>

<style>
  .toc { position: sticky; top: var(--space-5); grid-row: 1; grid-column: 2; align-self: start; padding: var(--space-4) var(--space-5); border-radius: var(--radius-xl); background: var(--surface); box-shadow: var(--shadow-card); font-size: var(--text-sm); }
  summary { font-weight: 900; cursor: pointer; }
  .toc[open] summary { margin-bottom: var(--space-3); }
  ol { display: grid; gap: var(--space-2); margin: 0; padding: 0 0 0 0.875rem; border-left: 1px solid var(--rule); list-style: none; }
  a { position: relative; display: block; color: var(--muted); line-height: 1.35; text-decoration: none; }
  a:hover, a[aria-current] { color: var(--ink); }
  a[aria-current]::before { content: ''; position: absolute; top: 0; bottom: 0; left: calc(-0.875rem - 1.5px); width: 2px; background: var(--c); }
  .depth-3 { padding-left: var(--space-3); }

  @media (min-width: 1100px) {
    summary { list-style: none; cursor: default; pointer-events: none; }
    summary::-webkit-details-marker { display: none; }
  }
  @media (max-width: 1099px) {
    .toc { position: static; grid-row: auto; grid-column: 1; }
  }
</style>
