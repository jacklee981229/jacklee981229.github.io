---
// Inline stroke icons. Always decorative: the control or text next to an icon carries its name.
import type { HTMLAttributes } from 'astro/types';
import { ICONS } from '../lib/icons.js';

export type IconName = keyof typeof ICONS;

interface Props extends HTMLAttributes<'svg'> {
  name: IconName | string;
}

// `rest` carries the parent's style-scope attribute, so parents can style the icon they place.
const { name, class: className, ...rest } = Astro.props;
const path = ICONS[name as IconName];
if (!path) throw new Error(`Unknown icon "${name}". Add it to src/lib/icons.js.`);
---
<svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false" {...rest} set:html={path} />
