---
// "Check these too!" under a Lab tool, game or effect: other Lab items as cards, the same kind first (moreLabItems),
// in the band that closes the page. It goes after the page's .wrap.
import LabItemCard from './LabItemCard.astro';
import MoreBand from './MoreBand.astro';
import { experimentPosts } from '../lib/collections';
import { effectBySlug, moreLabItems, toolBySlug } from '../lib/lab/tools.js';

interface Props {
  /** The page's own item: a tool's address, a game's post or an effect's address. */
  current: string;
}

const items = moreLabItems(Astro.props.current);
const posts = await experimentPosts();
// The note names what's shown: under an effect, that's the other effects.
const note = items[0]?.kind === 'effect' ? 'Other effects, and more from the Lab.' : 'Other tools and games in the Lab.';
---
{items.length > 0 && (
  <MoreBand title="Check these too!" note={note}>
    <ul class="cards">
      {items.map((item) =>
        item.kind === 'tool' ? <LabItemCard tool={toolBySlug(item.id)} />
        : item.kind === 'effect' ? <LabItemCard effect={effectBySlug(item.id)} />
        : <LabItemCard post={posts.find((p) => p.id === item.id)!} />)}
    </ul>
  </MoreBand>
)}

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
</style>
