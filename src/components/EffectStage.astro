---
// The stage an effect plays on: a canvas right across the window. src/effects/stage.js runs it, with the effect's
// own code (src/effects/<slug>.js), fetched only when it's shown. A Little World (`world`, such as
// Jack's Town) plays on the same stage, from src/worlds/<slug>.js. A world can put buttons of its own beside Pause
// (the `controls` slot); its code finds them in the stage.
interface Props {
  /** The effect or world to run; left out, the page runs and swaps the effects itself (the Effects page). */
  slug?: string;
  /** What the moving picture shows, for someone who can't see it. */
  label: string;
  /** A Little World rather than an effect: its own colours, nothing to point at, and a finger scrolls the page. */
  world?: boolean;
}

const { slug, label, world = false } = Astro.props;
---
<div class="stage" data-stage={slug ?? ''} data-world={world || undefined} data-fullscreen={world ? 'Show this world on the whole screen' : 'Show the effect on the whole screen'}>
  <canvas role="img" aria-label={label}></canvas>
  <div class="controls">
    <slot name="controls" />
    <button type="button" class="button" data-stage-toggle>Pause</button>
  </div>
</div>

<script>
  import { runStage } from '../effects/stage.js';

  // One file per effect or world; only the one this page names is fetched.
  type Piece = { default: Parameters<typeof runStage>[1] };
  const effects = import.meta.glob<Piece>('../effects/*.js');
  const worlds = import.meta.glob<Piece>('../worlds/*.js');
  const root = document.querySelector<HTMLElement>('[data-stage]');
  // With no slug, the page itself runs the effects (the Effects page).
  const load = root?.dataset.stage && ('world' in root.dataset ? worlds[`../worlds/${root.dataset.stage}.js`] : effects[`../effects/${root.dataset.stage}.js`]);
  if (root && load) load().then((piece) => runStage(root, piece.default));
</script>

<style>
  /* On a card, like the Travel Map: drawn straight onto the card's colour, which it takes for its page (--paper). As
     tall as the window allows under the page's top, leaving room under the card and a strip of what follows in
     sight: a finger on an effect moves the effect, not the page, so the page needs somewhere else to be scrolled
     from. --c1 onward are the colours the effects draw with: the site's topic colours. */
  .stage { --c1: var(--lane-flutter); --c2: var(--lane-games); --c3: var(--lane-hexo); --c4: var(--lane-chatgpt); --c5: var(--lane-git); --paper: var(--surface); position: relative; height: clamp(18rem, calc(100svh - 17.5rem), 64rem); overflow: hidden; border-radius: var(--radius-2xl); background: var(--surface); box-shadow: var(--shadow-card); }
  /* Phones: the page's top is taller there (the menu and the description wrap), so the stage gives up more height. */
  @media (max-width: 719px) {
    .stage { height: clamp(18rem, calc(100svh - 23.5rem), 40rem); }
  }
  /* The command palette's Fullscreen: the stage alone, edge to edge. */
  .stage:fullscreen { height: 100%; border-radius: 0; box-shadow: none; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }
  /* A world: the homes' four colours, the lights' go, wait and stop, and the ground (the card's colour). Nothing
     follows the pointer, so a finger on it scrolls the page as anywhere else. */
  .stage[data-world] { --c1: var(--lane-flutter); --c2: var(--lane-hexo); --c3: var(--lane-chatgpt); --c4: var(--lane-git); --c5: var(--signal-go); --c6: var(--signal-wait); --c7: var(--signal-stop); --c8: var(--surface); }
  .stage[data-world] canvas { touch-action: auto; cursor: default; }
  .controls { position: absolute; top: var(--space-4); right: var(--space-4); display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-2); }
  .controls :global(.button) { padding: var(--space-1) var(--space-3); color: var(--ink); font-size: var(--text-sm); cursor: pointer; }
  .controls :global(.button:disabled) { color: var(--muted); cursor: default; }
  .controls :global(.button:disabled:hover) { border-color: var(--rule); }
</style>
