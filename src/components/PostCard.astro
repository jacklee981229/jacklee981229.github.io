---
import Cover from './Cover.astro';
import { formatDate } from '../lib/dates.js';
import { topicOf } from '../lib/topics.js';
import { postUrl, summaryOf, type Post } from '../lib/collections';

interface Props {
  post: Post;
  level?: 2 | 3;
}

const { post, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const summary = summaryOf(post);
---
<article class="card" style={`--c: var(--lane-${post.data.topic})`} data-lane={post.data.topic}>
  <Cover post={post} class="card-cover" />
  <div class="body">
    <p class="topic">{topicOf(post.data.topic).name}</p>
    <Heading class="title"><a href={postUrl(post)}>{post.data.title}</a></Heading>
    {summary && <p class="excerpt">{summary}</p>}
    <div class="foot">
      {post.data.tags.length > 0 ? (
        <ul class="tags" aria-label="Tags">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
      ) : (
        <span />
      )}
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </div>
  </div>
</article>

<style>
  /* Grows from its left edge, so the timeline's line into the card stays attached. */
  .card { position: relative; display: grid; grid-template-columns: minmax(11rem, 36%) minmax(0, 1fr); overflow: hidden; border: 1px solid var(--rule); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-card); transform-origin: left center; transition: border-color 0.2s ease, opacity 0.2s ease, transform 0.2s ease; }
  .card:hover { border-color: var(--c); }
  .card:has(.title a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; transform: scale(1.02); }
  /* Mouse only: on a touch screen, a tapped card would stay enlarged. */
  @media (hover: hover) {
    .card:hover { transform: scale(1.02); }
  }
  .card.dim { opacity: 0.45; }
  .card :global(.card-cover) { aspect-ratio: auto; min-height: 12rem; }
  .body { display: flex; flex-direction: column; gap: var(--space-2); padding: 1.25rem var(--space-5) 1.375rem; }
  .topic { margin: 0; color: var(--c); font-size: 0.8125rem; font-weight: 650; }
  .title { margin: 0; font-size: var(--text-lg); font-weight: var(--display-weight); line-height: 1.2; letter-spacing: calc(var(--display-tracking) / 2); text-wrap: balance; }
  .title a { text-decoration: none; }
  .title a:focus-visible { outline: none; }
  /* The title link covers the whole card, so the card is one click target with one accessible name. */
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .excerpt { display: -webkit-box; margin: 0; overflow: hidden; color: var(--muted); line-height: 1.55; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-top: auto; padding-top: var(--space-2); }
  .tags { display: flex; flex-wrap: wrap; gap: 0.375rem; margin: 0; padding: 0; list-style: none; }
  .tags li { padding: 0.125rem 0.5625rem; border-radius: var(--radius-pill); background: var(--wash); color: var(--muted); font-size: var(--text-xs); font-weight: 600; }
  time { color: var(--ink); font-size: var(--text-ui); font-weight: 650; font-variant-numeric: tabular-nums; white-space: nowrap; }

  @media (max-width: 719px) {
    .card { grid-template-columns: minmax(0, 1fr); }
    .card :global(.card-cover) { aspect-ratio: 16 / 9; min-height: 0; }
    .body { padding: var(--space-4) 1.125rem 1.125rem; }
    .title { font-size: 1.25rem; }
    .foot { flex-wrap: wrap; }
  }
</style>
