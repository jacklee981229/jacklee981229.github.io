---
interface Props {
  topics: { id: string; name: string; count: number }[];
}

const { topics } = Astro.props;
---
<ul class="legend" aria-label="Topics">
  {topics.map((t) => (
    <li>
      <a href={`/writing/#${t.id}`} data-legend={t.id} style={`--c: var(--lane-${t.id})`}>
        <span class="dot" aria-hidden="true" />{t.name} <span class="count">{t.count}</span>
      </a>
    </li>
  ))}
</ul>

<script>
  // Pointing at a topic lights up its lane and cards and dims the rest.
  document.querySelectorAll<HTMLElement>('.legend').forEach((legend) => {
    const focus = (topic: string | null) => {
      document.querySelectorAll<HTMLElement>('[data-lane]').forEach((el) => {
        el.classList.toggle('dim', topic !== null && el.dataset.lane !== topic);
      });
    };
    const topicAt = (target: EventTarget | null) => (target instanceof Element ? target.closest<HTMLElement>('[data-legend]')?.dataset.legend ?? null : null);
    legend.addEventListener('pointerover', (e) => focus(topicAt(e.target)));
    legend.addEventListener('pointerleave', () => focus(null));
    legend.addEventListener('focusin', (e) => focus(topicAt(e.target)));
    legend.addEventListener('focusout', () => focus(null));
  });
</script>

<style>
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0 0 var(--space-4); padding: 0; list-style: none; }
  a { display: inline-flex; align-items: center; gap: var(--space-2); padding: 0.375rem 0.875rem 0.375rem var(--space-3); border: 1px solid var(--rule); border-radius: var(--radius-pill); background: var(--surface); font-size: var(--text-sm); font-weight: 600; text-decoration: none; transition: border-color 0.15s ease; }
  a:hover, a:focus-visible { border-color: var(--c); }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--c); }
  .count { color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
