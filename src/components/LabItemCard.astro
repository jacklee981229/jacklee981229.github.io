---
// One Lab item as a card: a tool, with its example as the cover (Effects, with one effect's drawing, a different one
// each day the site is built: the home page's toy of that day); a game's post, with its own cover; or a Little World,
// with a drawing of it.
import Cover from './Cover.astro';
import EffectCover from './EffectCover.astro';
import LabCard from './LabCard.astro';
import WorldCover from './WorldCover.astro';
import { postUrl, summaryOf, type LabItem } from '../lib/collections';
import { todaysToy } from '../lib/home.js';
import { EFFECTS, toolUrl, worldUrl } from '../lib/lab/tools.js';

type Props = LabItem;

const { tool, post, world } = Astro.props;
// Key Jam is left out, as from the home page's toy, so the two show the same effect on the day of a build.
const drawn = todaysToy(EFFECTS.filter((e) => e.slug !== 'key-jam'), new Date())?.slug ?? EFFECTS[0].slug;
const kind = tool?.group as 'text' | 'preview' | 'image' | 'misc';
---
{tool ? (
  tool.example ? (
    <LabCard href={tool.status === 'ready' ? toolUrl(tool.slug) : undefined} icon={tool.icon} name={tool.name} description={tool.description} example={tool.example} kind={kind} />
  ) : (
    <LabCard href={toolUrl(tool.slug)} icon={tool.icon} name={tool.name} description={tool.description} kind={kind}>
      <EffectCover slot="cover" slug={drawn} />
    </LabCard>
  )
) : post ? (
  <LabCard href={postUrl(post)} icon="gamepad" name={post.data.title} description={summaryOf(post)} kind="game">
    <Cover slot="cover" post={post} variant="mini" />
  </LabCard>
) : world && (
  <LabCard href={worldUrl(world.slug)} icon={world.icon} name={world.name} description={world.description} kind="world">
    <WorldCover slot="cover" slug={world.slug} />
  </LabCard>
)}
