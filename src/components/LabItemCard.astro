---
// One Lab item as a card: a tool, with its example as the cover; a game's post, with its own cover; an effect,
// with a drawing of what it does; or a Little World, with a picture of it.
import { Image } from 'astro:assets';
import Cover from './Cover.astro';
import EffectCover from './EffectCover.astro';
import LabCard from './LabCard.astro';
import { postUrl, summaryOf, type LabItem } from '../lib/collections';
import { effectUrl, toolUrl, worldUrl } from '../lib/lab/tools.js';

type Props = LabItem;

const { tool, post, effect, world } = Astro.props;
const pictures = import.meta.glob<{ default: ImageMetadata }>('/src/assets/worlds/*.png', { eager: true });
const picture = world && pictures[`/src/assets/worlds/${world.slug}.png`]?.default;
---
{tool ? (
  <LabCard href={tool.status === 'ready' ? toolUrl(tool.slug) : undefined} icon={tool.icon} name={tool.name} description={tool.description} example={tool.example} />
) : post ? (
  <LabCard href={postUrl(post)} icon="gamepad" name={post.data.title} description={summaryOf(post)}>
    <Cover slot="cover" post={post} variant="mini" />
  </LabCard>
) : effect ? (
  <LabCard href={effectUrl(effect.slug)} icon="pointer" name={effect.name} description={effect.description}>
    <EffectCover slot="cover" slug={effect.slug} />
  </LabCard>
) : world && (
  <LabCard href={worldUrl(world.slug)} icon="car" name={world.name} description={world.description}>
    <span slot="cover" class="cover world" aria-hidden="true">{picture && <Image src={picture} alt="" width={480} />}</span>
  </LabCard>
)}

<style>
  /* A world's picture, cut to the card's cover height from its middle. */
  .world { display: block; overflow: hidden; background: var(--wash); }
  .world :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
