---
// One tile of the home page's grid: a header (an icon chip, the title, and a short note or link on the right) over
// its body. Every tile but the hero's shell is one of these, so they can't drift apart. Placed by the page.
import Go from './Go.astro';
import Icon from './Icon.astro';

interface Props {
  /** Names the tile's heading, for the section's label. */
  id: string;
  title: string;
  icon: string;
  /** Where the title leads, when the tile has a page of its own. */
  href?: string;
  /** The Lab's tile: its chip in the Lab's green. Every other chip is grey. */
  lab?: boolean;
  class?: string;
}

const { id, title, icon, href, lab = false, class: className } = Astro.props;
---
<section class:list={['tile', className]} aria-labelledby={`${id}-title`}>
  <header class="head">
    <h2 id={`${id}-title`}>
      <span class:list={['chip', { lab }]}><Icon name={icon} /></span>
      {href ? <Go href={href}>{title}</Go> : title}
    </h2>
    {Astro.slots.has('meta') && <div class="meta"><slot name="meta" /></div>}
  </header>
  <div class="body"><slot /></div>
</section>

<style>
  .tile { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; padding: var(--space-5); border: 1px solid var(--rule); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-card); }
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-3); min-height: 28px; }
  h2 { display: flex; align-items: center; gap: var(--space-2); margin: 0; font-size: var(--text-ui); font-weight: 700; letter-spacing: -0.01em; }
  .chip { display: grid; place-items: center; width: 28px; height: 28px; flex: none; border-radius: var(--radius-art); background: var(--wash); color: var(--muted); }
  .chip :global(.icon) { width: 16px; height: 16px; }
  .chip.lab { background: color-mix(in srgb, var(--lane-games) 16%, transparent); color: var(--lane-games); }
  .meta { color: var(--muted); font-size: var(--text-sm); }
  .meta :global(p) { margin: 0; }
  /* The body's last part ("See all…") sits at the bottom, so bottoms line up across a row. */
  .body { display: flex; flex: 1; flex-direction: column; gap: var(--space-4); min-width: 0; }
  .body > :global(.foot) { margin-top: auto; }
</style>
