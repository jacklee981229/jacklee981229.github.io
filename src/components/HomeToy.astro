---
// Today's toy: one of the Lab's effects running on the home page, picked by the visitor's date (todaysToy in
// src/lib/home.js): the same for everyone on a day, another the next. It runs on the effects' own stage
// (src/effects/stage.js): only while it's on screen, with a pointer or a finger, and as a still picture when less
// motion is asked for. A finger can still scroll the page across it, and it never takes the keyboard's focus.
// The stage opts into the Lab's colours (data-area="lab", tokens.css).
import { EFFECTS, effectUrl } from '../lib/lab/tools.js';

// Key Jam is left out: it plays sounds from the keyboard, which a page you've only opened shouldn't.
const toys = EFFECTS.filter((e) => e.slug !== 'key-jam').map((e) => ({ slug: e.slug, name: e.name, href: effectUrl(e.slug), description: e.description }));
---
<figure class="home-toy">
  <div class="toy" data-area="lab" data-toy>
    <canvas role="img" aria-label="Today's toy, one of the Lab's effects"></canvas>
    <script is:inline type="application/json" data-toys set:html={JSON.stringify(toys)} />
  </div>
  <figcaption>Today's toy: <a href="/lab/#effects" data-toy-link>one of the Lab's effects</a>. A new one every day.</figcaption>
</figure>

<script>
  import { runStage } from '../effects/stage.js';
  import { todaysToy } from '../lib/home.js';

  const pieces = import.meta.glob<{ default: Parameters<typeof runStage>[1] }>('../effects/*.js');
  const root = document.querySelector<HTMLElement>('[data-toy]');
  if (root) {
    const toys = JSON.parse(root.querySelector('[data-toys]')?.textContent ?? '[]') as { slug: string; name: string; href: string; description: string }[];
    const toy = todaysToy(toys, new Date());
    if (toy) {
      const link = document.querySelector<HTMLAnchorElement>('[data-toy-link]');
      if (link) {
        link.href = toy.href;
        link.textContent = toy.name;
      }
      root.querySelector('canvas')?.setAttribute('aria-label', `${toy.name}: ${toy.description}`);
      pieces[`../effects/${toy.slug}.js`]?.().then((piece) => runStage(root, piece.default));
    }
  }
</script>

<style>
  .home-toy { margin: 0; }
  /* --c1 onward are the colours the effects draw with: the site's topic colours, as on an effect's own page. */
  .toy { --c1: var(--lane-flutter); --c2: var(--lane-games); --c3: var(--lane-hexo); --c4: var(--lane-chatgpt); --c5: var(--lane-git); position: relative; aspect-ratio: 2 / 1; overflow: hidden; border: 1px solid var(--rule); border-radius: var(--radius-lg); background: var(--paper); }
  /* A finger dragging up or down scrolls the page; across, it plays. */
  canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: pan-y; cursor: crosshair; }
  figcaption { margin-top: var(--space-3); color: var(--muted); font-size: var(--text-sm); }
  figcaption a { color: var(--ink); font-weight: 600; }
  /* A phone's toy is taller than half its width, so there's something to play with. */
  @media (max-width: 719px) {
    .toy { aspect-ratio: auto; height: 15rem; border-radius: var(--radius-md); }
  }
</style>
