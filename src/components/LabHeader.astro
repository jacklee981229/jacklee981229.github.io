---
// The top of a Lab page (a tool, a game, an effect or a little world): a card in the Lab's green, like the Lab home's
// top, with the way back, the name, a one-line description and an optional slot at its foot for the page's own
// controls (a game's colours switch), drawn in white to sit on the colour like the main pages' (PageTop.astro).
import Icon from './Icon.astro';
import { flowStyle } from '../lib/flow.js';

interface Props {
  title: string;
  /** Left out, the top shows the name alone (Jack's Exact Time). */
  description?: string;
  /** Where the back link goes: a game or an effect goes back to its section of the Lab home. */
  back?: string;
  /** A small top, for a page whose whole point is the thing under it (an effect's stage). */
  compact?: boolean;
}

const { title, description, back = '/lab/', compact = false } = Astro.props;
// The card that led here grows into this top (flow.js).
---
<div class:list={['lab-header', { compact }]} style={flowStyle(Astro.url.pathname)}>
  <a class="back" href={back}><Icon name="back" />Lab</a>
  <h1 class="page-title">{title}</h1>
  {description && <p class="lede" data-lede>{description}</p>}
  {Astro.slots.has('default') && <div class="under"><slot /></div>}
</div>

<style>
  .lab-header { --focus: var(--on-colour); margin-bottom: var(--space-6); padding: var(--space-5) var(--space-6) var(--space-6); border-radius: var(--radius-2xl); background: linear-gradient(120deg, var(--lab-from), var(--lab-to)); color: var(--on-colour); }
  .back { display: inline-flex; align-items: center; gap: var(--space-1); min-height: 2rem; margin: 0 0 var(--space-3) calc(-1 * var(--space-1)); padding: 0 var(--space-3) 0 var(--space-2); border-radius: var(--radius-pill); background: var(--on-colour-chip); font-size: var(--text-sm); font-weight: 800; text-decoration: none; }
  .back:hover { background: var(--on-colour-chip-hover); }
  .back :global(.icon) { width: 1rem; height: 1rem; stroke-width: 2.2; }
  /* A Lab item's name is a title in a card, the size of the home page's. */
  .page-title { margin: 0; font-size: var(--text-hero); font-weight: 900; letter-spacing: -0.04em; }
  .lede { margin-top: var(--space-2); color: var(--on-colour-soft); }
  .under { margin-top: var(--space-5); }
  /* A switch on the colour, as on the main pages' tops: a dark-tinted pill with the chosen one in white. */
  .lab-header :global(.switch) { border-color: transparent; background: var(--on-colour-chip); }
  .lab-header :global(:is(.switch label, .switch button)) { color: var(--on-colour-soft); }
  .lab-header :global(:is(.switch label, .switch button):hover) { color: var(--on-colour); }
  .lab-header :global(:is(.switch label:has(:checked), .switch button[aria-selected='true'])) { background: var(--on-colour); color: var(--lab-to); }

  /* Compact: one slim row, the way back, the name and the description side by side. */
  .compact { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-4); margin-bottom: var(--space-4); padding: var(--space-3) var(--space-5); }
  .compact .back { margin: 0 0 0 calc(-1 * var(--space-2)); }
  .compact .page-title { font-size: var(--text-xl); line-height: 1.2; letter-spacing: -0.02em; }
  .compact .lede { margin: 0; font-size: var(--text-ui); }

  @media (max-width: 719px) {
    .lab-header { padding: var(--space-4) var(--space-5) var(--space-5); }
    .compact { padding: var(--space-3) var(--space-4); }
  }
</style>
