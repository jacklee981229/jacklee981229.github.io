---
// The home page body (page 1 and /page/N/): topic key, timeline and sidebar.
import PostCard from './PostCard.astro';
import PostLog from './PostLog.astro';
import ProfileCard from './ProfileCard.astro';
import SiteInfo from './SiteInfo.astro';
import TagCloud from './TagCloud.astro';
import TopicLegend from './TopicLegend.astro';
import { lastUpdated, paginate, pinned, tagCounts, topicCounts } from '../lib/posts.js';
import { TOPICS } from '../lib/topics.js';
import { listedPosts } from '../lib/collections';
import { POSTS_PER_PAGE } from '../site';

interface Props {
  page: number;
}

const { page } = Astro.props;
const posts = await listedPosts();
const pages = paginate(posts, POSTS_PER_PAGE);
const current = pages[page - 1];
const pinnedPosts = page === 1 ? pinned(posts) : [];
const tags = tagCounts(posts);
const topics = topicCounts(posts, TOPICS);
---
<div class="wrap feed">
  <section class="main" aria-labelledby="feed-title">
    <h2 id="feed-title" class="visually-hidden">{page === 1 ? 'Latest posts' : `Posts, page ${page}`}</h2>
    {pinnedPosts.length > 0 && (
      <section class="pinned" aria-labelledby="pinned-title">
        <h3 id="pinned-title" class="label">Pinned</h3>
        <div class="pinned-cards">{pinnedPosts.map((post) => <PostCard post={post} level={3} />)}</div>
      </section>
    )}
    <TopicLegend topics={topics} />
    {posts.length > 0 ? (
      <PostLog posts={posts} start={current.start} end={current.start + current.items.length} page={page} pages={pages.length} />
    ) : (
      <p class="empty">No posts yet.</p>
    )}
  </section>

  <aside class="side" aria-label="About this site">
    <section class="block"><ProfileCard posts={posts.length} topics={topics.filter((t) => t.count > 0).length} tags={tags.length} /></section>
    <section class="block" aria-labelledby="tags-title">
      <h2 id="tags-title">Tags</h2>
      <TagCloud tags={tags} />
    </section>
    <section class="block" aria-labelledby="info-title">
      <h2 id="info-title">Site info</h2>
      <SiteInfo updated={lastUpdated(posts)} />
    </section>
  </aside>
</div>

<style>
  .feed { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: 3.5rem; padding-bottom: var(--space-9); }
  .pinned { margin-bottom: var(--space-6); }
  .label { margin: 0 0 var(--space-3); font-size: var(--text-ui); font-weight: 700; }
  .pinned-cards { display: grid; gap: var(--space-4); }
  .side { display: flex; flex-direction: column; gap: var(--space-4); font-size: var(--text-ui); }
  .block { padding: 1.25rem; border: 1px solid var(--rule); border-radius: var(--radius-lg); background: var(--surface); }
  .block h2 { margin: 0 0 0.875rem; font-size: var(--text-ui); font-weight: 700; }

  @media (max-width: 1099px) {
    .feed { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .side { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  }
</style>
