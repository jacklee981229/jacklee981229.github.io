---
// A change's kind as a label (New, Improved, Design, Fix), on /changelog/.
import Icon from './Icon.astro';
import { KINDS } from '../lib/changelog.js';

interface Props {
  kind: keyof typeof KINDS;
}

const { kind } = Astro.props;
---
<span class:list={['kind', kind]}><Icon name={KINDS[kind].icon} />{KINDS[kind].name}</span>

<style>
  /* Every label the same width, whatever its word. Each kind in a colour of its own, from the site's topic colours:
     a tint behind and the icon in full strength. The word stays in the text colour, which keeps small letters
     readable on the tint in every theme. */
  .kind { --k: var(--lane-games); display: inline-flex; align-items: center; justify-content: center; gap: 0.3rem; justify-self: start; width: 6.5rem; padding: 0.15rem 0.5rem; border-radius: var(--radius-pill); background: color-mix(in srgb, var(--k) 14%, transparent); color: var(--ink); font-size: var(--text-xs); font-weight: 650; white-space: nowrap; }
  .kind :global(.icon) { width: 0.95rem; height: 0.95rem; color: var(--k); }
  .improved { --k: var(--lane-flutter); }
  .design { --k: var(--lane-chatgpt); }
  .fix { --k: var(--lane-git); }
</style>
