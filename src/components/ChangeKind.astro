---
// A change's kind as a label (New, Improved, Design, Fix), on /changelog/.
import Icon from './Icon.astro';
import { KINDS } from '../lib/changelog.js';

interface Props {
  kind: keyof typeof KINDS;
}

const { kind } = Astro.props;
---
<span class:list={['kind', kind]}><Icon name={KINDS[kind].icon} />{KINDS[kind].name}</span>

<style>
  /* Every label the same width, whatever its word. Each kind a solid pill in a bold colour of its own, from the
     topics' deep colours, with white words (4.5:1 or more on each, in every theme). */
  .kind { --k: var(--topic-games); display: inline-flex; align-items: center; justify-content: center; gap: 0.3rem; justify-self: start; width: 6.5rem; padding: 0.15rem 0.5rem; border-radius: var(--radius-pill); background: var(--k); color: var(--on-colour); font-size: var(--text-xs); font-weight: 800; white-space: nowrap; }
  .kind :global(.icon) { width: 0.95rem; height: 0.95rem; }
  .improved { --k: var(--topic-flutter); }
  .design { --k: var(--topic-chatgpt); }
  .fix { --k: var(--topic-git); }
</style>
