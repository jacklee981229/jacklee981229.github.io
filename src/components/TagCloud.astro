---
import { tagUrl } from '../lib/collections';

interface Props {
  tags: { tag: string; count: number }[];
  large?: boolean;
}

const { tags, large = false } = Astro.props;
---
<ul class:list={['cloud', { large }]}>
  {tags.map(({ tag, count }) => (
    <li>
      <a href={tagUrl(tag)}>{tag} <span class="count">{count}</span></a>
    </li>
  ))}
</ul>

<style>
  .cloud { display: flex; flex-wrap: wrap; gap: 0.375rem; margin: 0; padding: 0; list-style: none; }
  a { display: inline-flex; align-items: baseline; gap: 0.375rem; padding: 0.1875rem 0.625rem; border-radius: var(--radius-pill); background: var(--wash); color: var(--ink); font-size: var(--text-sm); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .count { color: var(--muted); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .large { gap: var(--space-2); }
  .large a { padding: 0.375rem 0.875rem; font-size: var(--text-base); font-weight: 600; }
</style>
