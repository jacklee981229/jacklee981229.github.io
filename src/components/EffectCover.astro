---
// The picture on an effect's card: a still drawing of what it does, in the site's colours. Each is worked out here
// from the same idea as the effect itself, so the card looks like what you'll get.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
// Wider than any card: a card shows the middle of it and trims the sides, so each picture keeps its subject in the middle.
const W = 360;
const H = 88;
const LANES = 5;
// The same "random" numbers on every build, so the pictures don't change from one publish to the next.
let seed = 7;
const random = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const round = (n: number) => Math.round(n * 10) / 10;
const pts = (list: number[][]) => list.map(([x, y]) => `${round(x)},${round(y)}`).join(' ');

type Dot = { x: number; y: number; r: number; lane: number; alpha: number };
type Line = { points: string; lane: number; alpha: number; width: number };
type Ring = { x: number; y: number; r: number; lane: number; alpha: number; width: number };
type Fill = { points: string; lane: number; alpha: number };
const dots: Dot[] = [];
const lines: Line[] = [];
const rings: Ring[] = [];
const fills: Fill[] = [];

if (slug === 'dot-grid') {
  // A grid of dots pushed away from one spot, coloured by the way they went.
  const at = { x: 180, y: 46 };
  for (let y = 8; y < H; y += 12) {
    for (let x = 6; x < W; x += 12) {
      const dx = x - at.x;
      const dy = y - at.y;
      const far = Math.hypot(dx, dy) || 1;
      const push = far < 46 ? (1 - far / 46) ** 2 * 16 : 0;
      const moved = Math.min(1, push / 9);
      const lane = moved < 0.05 ? -1 : Math.floor(((Math.atan2(dy, dx) + Math.PI) / (2 * Math.PI)) * LANES) % LANES;
      dots.push({ x: x + (dx / far) * push, y: y + (dy / far) * push, r: 1.1 + 2.2 * moved, lane, alpha: lane < 0 ? 0.5 : 0.55 + 0.45 * moved });
    }
  }
} else if (slug === 'mouse-trail') {
  // Ribbons of beads that weave around each other and taper away behind their heads.
  for (let ribbon = 4; ribbon >= 0; ribbon--) {
    for (let i = 0; i < 40; i++) {
      const along = i / 39;
      const x = 250 - along * 170;
      const y = 44 + Math.sin(along * 7.5 + ribbon * 1.26) * (7 + 15 * along);
      dots.push({ x, y, r: 0.5 + (5 - ribbon * 0.6) * (1 - along) ** 1.2, lane: ribbon, alpha: (1 - along) ** 0.9 });
    }
  }
} else if (slug === 'gravity-trail') {
  // Balls thrown from the top left, falling and bouncing lower each time.
  let x = 70;
  let y = 14;
  let vx = 5.2;
  let vy = 0;
  for (let i = 0; i < 46; i++) {
    dots.push({ x, y, r: 1.4 + random() * 3.2, lane: Math.floor(random() * LANES), alpha: 0.35 + 0.65 * (i / 46) });
    vy += 1.15;
    x += vx;
    y += vy;
    if (y > H - 8) {
      y = H - 8;
      vy = -vy * 0.68;
      vx *= 0.93;
    }
  }
} else if (slug === 'particles') {
  // Scattered points, a line between any two close enough.
  const points = Array.from({ length: 30 }, () => ({ x: 10 + random() * (W - 20), y: 8 + random() * (H - 16) }));
  points.forEach((a, i) => {
    points.slice(i + 1).forEach((b) => {
      const far = Math.hypot(a.x - b.x, a.y - b.y);
      if (far < 54) lines.push({ points: `${round(a.x)},${round(a.y)} ${round(b.x)},${round(b.y)}`, lane: -1, alpha: (1 - far / 54) * 0.75, width: 1 });
    });
    dots.push({ x: a.x, y: a.y, r: 1.6 + random() * 1.8, lane: i % LANES, alpha: 1 });
  });
} else if (slug === 'gooey-cursor') {
  // Blobs overlapping into one shape, with a few drops that got away.
  for (const [x, y, r, lane] of [[164, 46, 25, 1], [196, 40, 19, 0], [220, 50, 14, 2], [140, 54, 15, 3], [242, 36, 8, 4], [260, 58, 5, 0], [118, 34, 6, 4]]) dots.push({ x, y, r, lane, alpha: 0.92 });
} else if (slug === 'distortion') {
  // A net of lines swollen and twisted around one spot.
  const at = { x: 180, y: 44 };
  const bend = (x: number, y: number) => {
    const dx = x - at.x;
    const dy = y - at.y;
    const hold = Math.max(0, 1 - Math.hypot(dx, dy) / 66) ** 2;
    const angle = 1.05 * hold;
    const grow = 1 + 0.6 * hold;
    return [at.x + (dx * Math.cos(angle) - dy * Math.sin(angle)) * grow, at.y + (dx * Math.sin(angle) + dy * Math.cos(angle)) * grow, hold];
  };
  const add = (across: boolean, fixed: number, length: number) => {
    const points = [];
    let hold = 0;
    for (let along = -4; along <= length + 4; along += 4) {
      const [x, y, h] = across ? bend(along, fixed) : bend(fixed, along);
      points.push(`${round(x)},${round(y)}`);
      hold = Math.max(hold, h);
    }
    lines.push({ points: points.join(' '), lane: hold > 0.08 ? Math.floor(fixed / 12) % LANES : -1, alpha: hold > 0.08 ? 0.5 + 0.5 * hold : 0.5, width: 1 + hold * 0.8 });
  };
  for (let y = 8; y < H; y += 12) add(true, y, W);
  for (let x = 6; x < W; x += 12) add(false, x, H);
} else if (slug === 'ripples') {
  // Drops left along a path, the oldest spread widest and nearly gone, each with fainter rings inside.
  ([[112, 50, 0.82], [150, 38, 0.62], [186, 48, 0.42], [218, 38, 0.24], [246, 46, 0.1]] as const).forEach(([x, y, age], lane) => {
    const reach = 44 * (1 - (1 - age) ** 2.4);
    for (let k = 0; k < 3 && reach - k * 7 > 1.5; k++) rings.push({ x, y, r: reach - k * 7, lane, alpha: (1 - age) ** 0.8 * (1 - k / 3), width: 2 - 1.1 * age });
  });
} else if (slug === 'compass') {
  // A grid of needles all pointing at one spot, the near ones longer and coloured by the way they point.
  const at = { x: 180, y: 44 };
  for (let y = 8; y < H; y += 18) {
    for (let x = 9; x < W; x += 18) {
      const angle = Math.atan2(at.y - y, at.x - x);
      const near = Math.max(0, 1 - Math.hypot(at.x - x, at.y - y) / 70) ** 2;
      const half = (7 + 7 * near) / 2;
      const lane = near < 0.06 ? -1 : Math.floor(((angle + Math.PI) / (2 * Math.PI)) * LANES) % LANES;
      const head = { x: x + Math.cos(angle) * half, y: y + Math.sin(angle) * half };
      lines.push({ points: `${round(x - Math.cos(angle) * half)},${round(y - Math.sin(angle) * half)} ${round(head.x)},${round(head.y)}`, lane, alpha: lane < 0 ? 0.5 : 0.6 + 0.4 * near, width: 1 + near });
      dots.push({ x: head.x, y: head.y, r: 1.1 + near, lane, alpha: lane < 0 ? 0.5 : 0.6 + 0.4 * near });
    }
  }
} else if (slug === 'spotlight') {
  // Dots too faint to make out, except inside the torch's ring, where they show in colour.
  const at = { x: 180, y: 44 };
  for (let i = 0; i < 110; i++) {
    const x = random() * W;
    const y = random() * H;
    const lit = Math.hypot(x - at.x, y - at.y) < 34;
    dots.push({ x, y, r: lit ? 2.2 + random() * 2.6 : 1.6 + random() * 1.4, lane: lit ? Math.floor(random() * LANES) : -1, alpha: lit ? 1 : 0.22 });
  }
  rings.push({ x: at.x, y: at.y, r: 36, lane: -1, alpha: 0.5, width: 1 });
} else if (slug === 'sand') {
  // Striped dunes, and a stream of grains falling onto them.
  const top = (x: number) => 26 + 12 * Math.sin(x * 0.03 + 1) + 5 * Math.sin(x * 0.09);
  const xs = Array.from({ length: 46 }, (_, i) => i * 8);
  for (let stripe = 0; stripe < 4; stripe++) {
    const upper = xs.map((x) => [x, H - (top(x) * (stripe + 1)) / 4]);
    const lower = xs.map((x) => [x, H - (top(x) * stripe) / 4]).reverse();
    fills.push({ points: pts([...upper, ...lower]), lane: stripe, alpha: 0.9 });
  }
  for (let i = 0; i < 16; i++) dots.push({ x: 196 + (random() - 0.5) * 7, y: 6 + i * 2.6, r: 1.3, lane: 4, alpha: 0.95 });
} else if (slug === 'kaleidoscope') {
  // One wavy line, repeated and mirrored eight times round the middle. Each point is how far out, and how far aside.
  const wave = Array.from({ length: 22 }, (_, i) => [6 + (34 * i) / 21, Math.sin((i / 21) * 6) * 9 * (i / 21) + 3]);
  for (let k = 0; k < 8; k++) {
    const a = (k * Math.PI) / 4;
    for (const flip of [1, -1]) lines.push({ points: pts(wave.map(([out, aside]) => [180 + Math.cos(a) * out - Math.sin(a) * aside * flip, 44 + Math.sin(a) * out + Math.cos(a) * aside * flip])), lane: k % LANES, alpha: 0.9, width: 1.5 });
  }
} else if (slug === 'starfield') {
  // Streaks flying out from one point, longer and bolder the further out they are.
  for (let i = 0; i < 64; i++) {
    const a = random() * Math.PI * 2;
    const from = 6 + random() * 80;
    const to = from * (1.18 + random() * 0.2);
    const far = Math.min(1, from / 70);
    lines.push({ points: pts([[180 + Math.cos(a) * from, 44 + Math.sin(a) * from * 0.8], [180 + Math.cos(a) * to, 44 + Math.sin(a) * to * 0.8]]), lane: i % 4 ? -1 : i % LANES, alpha: 0.35 + 0.65 * far, width: 0.7 + 1.4 * far });
  }
} else if (slug === 'strings') {
  // Strings side by side; the ones just plucked are bowed out and coloured.
  for (let i = 0; i < 26; i++) {
    const x = 12 + i * 13.5;
    const bow = [3, -7, 10, -12, 8, -5, 2][i - 10] ?? 0;
    lines.push({ points: pts(Array.from({ length: 9 }, (_, k) => [x + bow * 4 * (k / 8) * (1 - k / 8), (k / 8) * H])), lane: bow ? i % LANES : -1, alpha: bow ? 0.95 : 0.5, width: bow ? 1.8 : 1 });
  }
} else if (slug === 'stained-glass') {
  // Panes: each is everywhere nearer to its own point than to any other, found by cutting the card down point by point.
  const points = Array.from({ length: 20 }, () => [random() * W, random() * H]);
  points.forEach(([ax, ay], i) => {
    let pane = [[0, 0], [W, 0], [W, H], [0, H]];
    for (const [bx, by] of points) {
      if (bx === ax && by === ay) continue;
      const next: number[][] = [];
      pane.forEach(([x1, y1], j) => {
        const [x2, y2] = pane[(j + 1) % pane.length];
        const d1 = (x1 - (ax + bx) / 2) * (bx - ax) + (y1 - (ay + by) / 2) * (by - ay);
        const d2 = (x2 - (ax + bx) / 2) * (bx - ax) + (y2 - (ay + by) / 2) * (by - ay);
        if (d1 <= 0) next.push([x1, y1]);
        if (d1 * d2 < 0) next.push([x1 + ((x2 - x1) * d1) / (d1 - d2), y1 + ((y2 - y1) * d1) / (d1 - d2)]);
      });
      pane = next;
    }
    if (pane.length < 3) return;
    // Drawn a little small, so the card's backing shows between the panes.
    const cx = pane.reduce((sum, p) => sum + p[0], 0) / pane.length;
    const cy = pane.reduce((sum, p) => sum + p[1], 0) / pane.length;
    fills.push({ points: pts(pane.map(([x, y]) => [cx + (x - cx) * 0.9, cy + (y - cy) * 0.9])), lane: i % LANES, alpha: 0.35 + random() * 0.55 });
  });
} else if (slug === 'flock') {
  // Darts all swimming much the same way, in a loose group.
  for (let i = 0; i < 26; i++) {
    const x = 110 + random() * 140;
    const y = 14 + random() * 60;
    const a = -0.35 + (random() - 0.5) * 0.5;
    const hx = Math.cos(a);
    const hy = Math.sin(a);
    fills.push({ points: pts([[x + hx * 8, y + hy * 8], [x - hx * 6 - hy * 4, y - hy * 6 + hx * 4], [x - hx * 3, y - hy * 3], [x - hx * 6 + hy * 4, y - hy * 6 - hx * 4]]), lane: i % LANES, alpha: 1 });
  }
} else if (slug === 'orbits') {
  // A sun, three oval paths round it, and on each a planet with a short tail.
  dots.push({ x: 180, y: 44, r: 4.5, lane: -1, alpha: 1 });
  [[34, 16, 0.3], [62, 26, -0.2], [92, 36, 0.12]].forEach(([rx, ry, tilt], i) => {
    const at = (t: number) => [180 + Math.cos(t) * rx * Math.cos(tilt) - Math.sin(t) * ry * Math.sin(tilt), 44 + Math.cos(t) * rx * Math.sin(tilt) + Math.sin(t) * ry * Math.cos(tilt)];
    lines.push({ points: pts(Array.from({ length: 49 }, (_, k) => at((k / 48) * Math.PI * 2))), lane: -1, alpha: 0.3, width: 0.8 });
    const where = 1 + i * 2.1;
    const lane = (i * 2) % LANES;
    lines.push({ points: pts(Array.from({ length: 9 }, (_, k) => at(where - k * 0.07))), lane, alpha: 0.7, width: 2 });
    dots.push({ x: at(where)[0], y: at(where)[1], r: 3 + i * 0.6, lane, alpha: 1 });
  });
} else if (slug === 'moire') {
  // Two sets of rings, a little apart: the bands between them are in neither set.
  for (const [x, lane] of [[166, 0], [196, 4]]) for (let r = 5; r < 150; r += 8) rings.push({ x, y: 44, r, lane, alpha: 0.75, width: 2.6 });
} else if (slug === 'garden') {
  // Three plants, each forking as it goes up, with a flower at every tip.
  const branch = (x: number, y: number, angle: number, length: number, depth: number, lane: number) => {
    const ex = x + Math.cos(angle) * length;
    const ey = y + Math.sin(angle) * length;
    lines.push({ points: pts([[x, y], [ex, ey]]), lane: -1, alpha: 0.8, width: Math.max(0.7, 2.4 - depth * 0.5) });
    if (depth === 4) return void dots.push({ x: ex, y: ey, r: 2.2, lane, alpha: 1 });
    for (const side of [-1, 1]) branch(ex, ey, angle + side * (0.38 + random() * 0.25), length * 0.72, depth + 1, lane);
  };
  for (const [x, length, lane] of [[120, 21, 1], [182, 26, 3], [246, 19, 4]]) branch(x, H, -Math.PI / 2 + (random() - 0.5) * 0.15, length, 0, lane);
} else if (slug === 'key-jam') {
  // A few of the shows at once: bars, a disc, a ring, a burst of dots and a zigzag.
  for (let i = 0; i < 5; i++) {
    const x = 78 + i * 11;
    const tall = [26, 44, 34, 54, 30][i];
    fills.push({ points: pts([[x, H], [x, H - tall], [x + 7, H - tall], [x + 7, H]]), lane: i % 2 ? 2 : 0, alpha: 0.95 });
  }
  dots.push({ x: 168, y: 40, r: 17, lane: 1, alpha: 1 });
  rings.push({ x: 216, y: 42, r: 24, lane: 4, alpha: 0.95, width: 5 });
  for (let i = 0; i < 9; i++) {
    const a = (i / 9) * Math.PI * 2 + 0.3;
    dots.push({ x: 268 + Math.cos(a) * (14 + random() * 12), y: 40 + Math.sin(a) * (14 + random() * 12), r: 2 + random() * 3, lane: i % 2 ? 3 : 0, alpha: 1 });
  }
  lines.push({ points: pts(Array.from({ length: 13 }, (_, i) => [136 + i * 13, 76 + (i % 2 ? -6 : 6)])), lane: 3, alpha: 0.95, width: 3 });
}
---
<span class="cover" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    {fills.map((f) => <polygon class={`c${f.lane}`} points={f.points} fill="currentColor" fill-opacity={round(f.alpha)} />)}
    {lines.map((l) => <polyline class={`c${l.lane}`} points={l.points} fill="none" stroke="currentColor" stroke-width={round(l.width)} stroke-opacity={round(l.alpha)} />)}
    {dots.map((d) => <circle class={`c${d.lane}`} cx={round(d.x)} cy={round(d.y)} r={round(d.r)} fill="currentColor" fill-opacity={round(d.alpha)} />)}
    {rings.map((r) => <circle class={`c${r.lane}`} cx={r.x} cy={r.y} r={round(r.r)} fill="none" stroke="currentColor" stroke-width={round(r.width)} stroke-opacity={round(r.alpha)} />)}
  </svg>
</span>

<style>
  /* The same faint backing as a tool card's example. The classes are the colours: c-1 the quiet grey, c0 onward the
     topic colours, in the stage's own order (EffectStage.astro). */
  .cover { display: block; background: var(--wash); }
  svg { display: block; width: 100%; height: 100%; }
  .c-1 { color: var(--muted); }
  .c0 { color: var(--lane-flutter); }
  .c1 { color: var(--lane-games); }
  .c2 { color: var(--lane-hexo); }
  .c3 { color: var(--lane-chatgpt); }
  .c4 { color: var(--lane-git); }
</style>
