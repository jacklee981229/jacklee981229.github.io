---
import Cover from './Cover.astro';
import { formatDate } from '../lib/dates.js';
import { postUrl, type Post } from '../lib/collections';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---
<li class="mini" style={`--c: var(--lane-${post.data.topic})`}>
  <Cover post={post} variant="mini" />
  <div class="text">
    <a class="title" href={postUrl(post)}>{post.data.title}</a>
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
  </div>
</li>

<style>
  .mini { position: relative; overflow: hidden; border: 1px solid var(--rule); border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--shadow-card); transition: border-color 0.2s ease, transform 0.2s ease; }
  .mini:hover { border-color: var(--c); }
  .mini:has(.title:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; transform: scale(1.02); }
  /* Mouse only: on a touch screen, a tapped card would stay enlarged. */
  @media (hover: hover) {
    .mini:hover { transform: scale(1.02); }
  }
  .text { display: grid; gap: var(--space-1); padding: 0.875rem var(--space-4) var(--space-4); }
  .title { font-weight: 700; line-height: 1.3; text-decoration: none; }
  .title:focus-visible { outline: none; }
  .title::after { content: ''; position: absolute; inset: 0; }
  time { color: var(--muted); font-size: 0.8125rem; }
</style>
