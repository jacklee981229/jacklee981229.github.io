---
// Now's items (src/content/now.md, read by src/lib/now.js): each its label and value. When a value is the name of
// something in a collection, its cover shows beside it and the value leads to that collection's tab.
import { Image } from 'astro:assets';
import Go from './Go.astro';
import { inlineHtml, plainText } from '../lib/now.js';
import { shelfItemNamed } from '../lib/shelf-pictures';

interface Props {
  items: { label?: string; value: string }[];
}

const { items } = Astro.props;
const site = String(Astro.site);
/** The cover's width on screen, in pixels; drawn at twice that for sharp screens. */
const THUMB = 44;
const rows = await Promise.all(
  items.map(async (item) => {
    const found = await shelfItemNamed(plainText(item.value));
    // A value that is its own link keeps it; otherwise a match makes it a link to the collection.
    const link = found && !/\]\(/.test(item.value) ? `/collections/#${found.shelf}` : undefined;
    return { ...item, html: inlineHtml(item.value, site), found, link };
  }),
);
---
<ul class="now">
  {rows.map((row) => (
    <li>
      <span class="text">
        {row.label && <span class="label">{row.label}</span>}
        {row.link ? <Go class="value" href={row.link}><Fragment set:html={row.html} /></Go> : <span class="value" set:html={row.html} />}
      </span>
      {row.found?.picture && (
        <a class="thumb" href={`/collections/#${row.found.shelf}`} tabindex="-1" aria-hidden="true">
          <Image src={row.found.picture} alt="" width={THUMB * 2} style={`width: ${THUMB}px`} />
        </a>
      )}
    </li>
  ))}
</ul>

<style>
  /* Each item a card, two across, as on the home page's Now: the label small above, the value big; a cover, when
     there is one, at the right. */
  .now { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  li { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-4) var(--space-5); border-radius: var(--radius-xl); background: var(--surface); box-shadow: var(--shadow-card); }
  .thumb { flex: none; line-height: 0; }
  .thumb :global(img) { height: auto; border-radius: var(--radius-xs); box-shadow: var(--shadow-card); rotate: 5deg; }
  .text { display: grid; gap: var(--space-1); min-width: 0; }
  .label { color: var(--muted); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  .value { font-size: var(--text-lg); font-weight: 900; line-height: 1.3; overflow-wrap: anywhere; }

  @media (max-width: 719px) {
    .now { grid-template-columns: minmax(0, 1fr); }
  }
</style>
