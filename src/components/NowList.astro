---
// Now's items (src/content/now.md, read by src/lib/now.js), each a card: its label, its name, a line about it and
// since when it's been on Now. An item that names a project or a post shows its picture across the card's top, lends
// its line when Jack wrote none, and leads to it; one that names something in a collection shows its cover beside the
// name and leads to that collection's tab.
import { Image } from 'astro:assets';
import { namesTitle, plainText } from '../lib/now.js';
import { shelfItemNamed } from '../lib/shelf-pictures';
import { PROJECTS } from '../lib/projects';
import { coverOf, pagePosts, postUrl } from '../lib/collections';
import { getCollection } from 'astro:content';
import { shortDate } from '../lib/dates.js';
import { isExternal, newTab } from '../lib/links.js';

interface Props {
  items: { label?: string; value: string; detail?: string }[];
  /** Since when each item has been on Now, in the same order; none when git can't say. */
  since: (Date | undefined)[];
}

const { items, since } = Astro.props;
const site = String(Astro.site);
/** The cover's width on screen, in pixels; drawn at twice that for sharp screens. */
const THUMB = 44;
const posts = await getCollection('posts');
// A draft's cover may show, but never a link to it: the live site has no page for it.
const live = new Set((await pagePosts()).filter((post) => !post.data.draft).map((post) => post.id));

const rows = await Promise.all(
  items.map(async (item, i) => {
    const name = plainText(item.value);
    const own = item.value.match(/\]\(([^)\s]+)\)/)?.[1];
    const project = PROJECTS.find((p) => namesTitle(item.value, p.name));
    const post = project ? undefined : posts.find((p) => namesTitle(item.value, p.data.title));
    const shelf = project || post ? undefined : await shelfItemNamed(name);
    const postHref = post && live.has(post.id) ? postUrl(post) : undefined;
    // A value that is its own link keeps it; otherwise what it names decides where the card leads.
    const href = own ?? (project ? '/projects/' : postHref ?? (shelf ? `/collections/#${shelf.shelf}` : undefined));
    const go = own ? 'Open' : project ? 'See it on Projects' : post ? (postHref ? 'Read the post' : 'Coming soon') : shelf ? 'In my Collection' : undefined;
    return {
      label: item.label,
      name,
      // As plain text: the card is itself a link, and links can't sit inside links.
      detail: item.detail ? plainText(item.detail) : (project?.line ?? post?.data.description),
      picture: project?.picture ?? (post && coverOf(post)),
      // A project's picture is its window on a clear background, so it sits on its kind's colours, as on Projects.
      kind: project?.kind,
      thumb: shelf?.picture,
      href,
      external: href ? isExternal(href, site) : false,
      go,
      since: since[i],
    };
  }),
);
---
<ul class="now">
  {rows.map((row) => {
    const Tag = row.href ? 'a' : 'div';
    return (
      <li>
        <Tag class="item" href={row.href} {...(row.external ? newTab() : {})}>
          {row.picture && <span class="pic" style={row.kind && `--from: var(--kind-${row.kind}-from); --to: var(--kind-${row.kind}-to)`}><Image src={row.picture} alt="" width={720} /></span>}
          <span class="text">
            <span class="head">
              <span class="words">
                {row.label && <span class="label">{row.label}</span>}
                <span class="name">{row.name}</span>
              </span>
              {row.thumb && <span class="thumb"><Image src={row.thumb} alt="" width={THUMB * 2} style={`width: ${THUMB}px`} /></span>}
            </span>
            {row.detail && <span class="detail">{row.detail}</span>}
            {(row.since || row.go) && (
              <span class="foot">
                {row.since && <span class="since">Since <time datetime={row.since.toISOString()} data-since>{shortDate(row.since)}</time></span>}
                {row.go && <span class:list={['go', { soon: !row.href }]}>{row.go}{row.href && ' →'}</span>}
              </span>
            )}
          </span>
        </Tag>
      </li>
    );
  })}
</ul>

<script>
  import { daysBetween } from '../lib/dates.js';

  // The page is built once, so "today" and "yesterday" are worked out in the visitor's browser.
  document.querySelectorAll<HTMLTimeElement>('time[data-since]').forEach((el) => {
    const days = daysBetween(new Date(), new Date(el.dateTime));
    if (days <= 0) el.textContent = 'today';
    else if (days === 1) el.textContent = 'yesterday';
  });
</script>

<style>
  /* Two across: a picture over the words when the item has one, the cover of a collection's item beside its name. */
  .now { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  li { display: flex; }
  .item { display: flex; flex-direction: column; width: 100%; overflow: hidden; border-radius: var(--radius-xl); background: var(--surface); box-shadow: var(--shadow-card); color: inherit; text-decoration: none; transition: transform var(--motion-quick) ease; }
  /* Like the Lab's cards: the one pointed at rises and its picture zooms in. */
  a.item:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; transform: translateY(-4px); }
  @media (hover: hover) {
    a.item:hover { transform: translateY(-4px); }
  }
  .pic { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: linear-gradient(150deg, var(--from, transparent), var(--to, transparent)); }
  .pic :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform var(--motion-settle) var(--ease-out); }
  @media (prefers-reduced-motion: no-preference) {
    a.item:focus-visible .pic :global(img) { transform: scale(1.06); }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a.item:hover .pic :global(img) { transform: scale(1.06); }
  }
  .text { display: flex; flex: 1; flex-direction: column; gap: var(--space-2); padding: var(--space-4) var(--space-5) var(--space-5); }
  .head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .words { display: grid; gap: var(--space-1); min-width: 0; }
  .label { color: var(--muted); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  .name { font-size: var(--text-xl); font-weight: 900; line-height: 1.15; overflow-wrap: anywhere; }
  .thumb { flex: none; line-height: 0; }
  .thumb :global(img) { height: auto; border-radius: var(--radius-xs); box-shadow: var(--shadow-card); rotate: 5deg; }
  .detail { color: var(--muted); font-size: var(--text-base); line-height: 1.5; }
  /* The foot sits at the card's bottom, so two cards side by side line theirs up. */
  .foot { display: flex; justify-content: space-between; gap: var(--space-3); margin-top: auto; padding-top: var(--space-2); font-size: var(--text-sm); font-weight: 700; }
  .since { color: var(--muted); }
  .go { margin-left: auto; color: var(--now-from); }
  .go.soon { color: var(--muted); }
  :global([data-theme='dark']) .go:not(.soon) { color: var(--now-soft); }

  @media (max-width: 719px) {
    .now { grid-template-columns: minmax(0, 1fr); }
    .name { font-size: var(--text-lg); }
  }
</style>
