---
// The picture on a Little World's card: a still drawing of it in white on the worlds' colours, like the effect cards'
// (EffectCover.astro), so the Lab's cards read as one family. Its photo (src/assets/worlds/<slug>.png) stays for its
// link previews.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
// As the effect drawings: wider than any card, which shows the middle and trims the sides, so each keeps its subject
// in the middle.
const W = 360;
const H = 88;
const round = (n: number) => Math.round(n * 10) / 10;

type Shape =
  | { kind: 'rect'; x: number; y: number; w: number; h: number; rx?: number; alpha: number; turn?: number }
  | { kind: 'path'; d: string; alpha: number; width?: number; fill?: boolean; turn?: number; at?: [number, number] }
  | { kind: 'circle'; x: number; y: number; r: number; alpha: number; width?: number };
const shapes: Shape[] = [];
const rect = (x: number, y: number, w: number, h: number, alpha: number, rx = 1.5, turn = 0) => shapes.push({ kind: 'rect', x, y, w, h, rx, alpha, turn });

if (slug === 'town') {
  // From above: a road across and three down, little houses in the blocks between, cars on the roads and at the kerb,
  // and the traffic lights at the crossings.
  const across = 44;
  const downs = [44, 112, 180, 248, 316];
  rect(0, across - 6, W, 12, 0.3, 0);
  for (const x of downs) rect(x - 6, 0, 12, H, 0.3, 0);
  for (let x = 4; x < W; x += 14) if (!downs.some((d) => Math.abs(x + 3 - d) < 9)) rect(x, across - 0.6, 6, 1.2, 0.55, 0.6);
  const blocks = [[-18, 38], [50, 106], [118, 174], [186, 242], [254, 310], [322, 378]];
  for (const [from, to] of blocks) {
    for (const y of [8, 22, 56, 70]) {
      for (let x = from + 4; x + 9 <= to - 2; x += 13) rect(x, y, 9, 9, 0.5 + ((x + y) % 3) * 0.12, 1.5);
    }
  }
  // The cars: one way along the road across, both ways up and down.
  for (const x of [72, 140, 214, 286]) rect(x, across - 4.6, 10, 5.4, 1, 1.8);
  for (const x of [150, 230]) rect(x, across + 0.6, 10, 5.4, 0.85, 1.8);
  rect(108.6, 14, 5.4, 10, 1, 1.8);
  rect(176.6, 60, 5.4, 10, 0.9, 1.8);
  rect(244.6, 22, 5.4, 10, 1, 1.8);
  for (const x of downs.slice(1, -1)) {
    shapes.push({ kind: 'circle', x: x - 9, y: across - 9, r: 1.8, alpha: 1 });
    shapes.push({ kind: 'circle', x: x + 9, y: across + 9, r: 1.8, alpha: 0.7 });
  }
} else if (slug === 'trains') {
  // A loop of track with a station on its top straight and a siding of wagons under it, sleepers along the bottom,
  // and two trains out on the line.
  const left = 84;
  const right = 276;
  const top = 18;
  const bottom = 64;
  const r = (bottom - top) / 2;
  const loop = `M${left + r} ${top}H${right - r}A${r} ${r} 0 0 1 ${right - r} ${bottom}H${left + r}A${r} ${r} 0 0 1 ${left + r} ${top}Z`;
  shapes.push({ kind: 'path', d: loop, alpha: 0.6, width: 3 });
  for (let x = left + r + 4; x < right - r - 2; x += 7) rect(x, bottom - 3.5, 1.6, 7, 0.32, 0.4);
  // The station's platform, and the siding off the bottom straight.
  rect(150, top - 12, 62, 5, 0.4, 1.5);
  shapes.push({ kind: 'path', d: `M${left + r + 30} ${bottom}Q${left + r + 46} ${bottom + 14} ${left + r + 70} ${bottom + 14}H${right - r - 10}`, alpha: 0.45, width: 2.4 });
  for (let i = 0; i < 4; i++) rect(176 + i * 15, bottom + 11, 12, 6, 0.55, 1.5);
  // A train on the top straight, its engine in front, and a short one on the right-hand bend.
  rect(168, top - 3.5, 15, 7, 1, 2);
  for (let i = 1; i <= 3; i++) rect(168 - i * 14, top - 3.5, 12, 7, 0.88, 1.5);
  const bend = (angle: number) => [right - r + Math.cos(angle) * r, top + r + Math.sin(angle) * r];
  for (const [i, a] of [[0, 0.15], [1, -0.32], [2, -0.79]] as const) {
    const [x, y] = bend(a);
    rect(x - 6, y - 3.5, 12, 7, i ? 0.85 : 1, 1.5, ((a + Math.PI / 2) * 180) / Math.PI);
  }
} else if (slug === 'pond') {
  // Clear water from above: a mossy boulder at the edge, rings spreading where something touched it, three koi, and
  // leaves floating on top.
  shapes.push({ kind: 'path', d: 'M40 70C44 52 70 46 88 54C104 61 106 80 96 88H44C38 82 38 76 40 70Z', alpha: 0.2, fill: true });
  shapes.push({ kind: 'path', d: 'M286 0C290 12 312 18 330 12C342 8 350 2 352 0Z', alpha: 0.16, fill: true });
  for (const r of [7, 14, 21]) shapes.push({ kind: 'circle', x: 132, y: 28, r, alpha: 0.42 - r * 0.012, width: 1.4 });
  for (const r of [6, 12]) shapes.push({ kind: 'circle', x: 244, y: 64, r, alpha: 0.35 - r * 0.01, width: 1.2 });
  // A koi: a body that narrows to its tail, with fins, drawn heading right, turned and placed.
  const koi = (x: number, y: number, turn: number, size: number, alpha: number) => {
    const s = (n: number) => round(n * size);
    const body = `M${s(14)} 0C${s(14)} ${s(-5)} ${s(4)} ${s(-6.5)} ${s(-4)} ${s(-5)}C${s(-10)} ${s(-3.5)} ${s(-14)} ${s(-1.5)} ${s(-17)} 0C${s(-14)} ${s(1.5)} ${s(-10)} ${s(3.5)} ${s(-4)} ${s(5)}C${s(4)} ${s(6.5)} ${s(14)} ${s(5)} ${s(14)} 0Z`;
    const tail = `M${s(-16)} 0L${s(-24)} ${s(-5)}Q${s(-21)} 0 ${s(-24)} ${s(5)}Z`;
    const fins = `M${s(4)} ${s(-5)}L${s(-1)} ${s(-10)}L${s(-3)} ${s(-5)}ZM${s(4)} ${s(5)}L${s(-1)} ${s(10)}L${s(-3)} ${s(5)}Z`;
    for (const d of [body, tail, fins]) shapes.push({ kind: 'path', d, alpha: d === body ? alpha : alpha * 0.75, fill: true, turn, at: [x, y] });
  };
  koi(196, 30, -14, 1, 0.95);
  koi(150, 62, 168, 0.85, 0.8);
  koi(262, 42, 205, 0.7, 0.65);
  // Floating leaves: a pointed oval and its stem.
  for (const [x, y, turn] of [[104, 20, 30], [226, 16, -40], [300, 66, 70]]) {
    shapes.push({ kind: 'path', d: 'M-6 0Q0 -5 7 0Q0 5 -6 0ZM-6 0L-9 1', alpha: 0.7, fill: true, turn, at: [x, y] });
  }
} else if (slug === 'fireflies') {
  // Mangroves across a river at night: their crowns full of fireflies, each light a broken streak in the water, and
  // a paper lantern hanging over the water from its bamboo pole.
  const line = 58;
  let seed = 7;
  const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const crowns: [number, number, number][] = [[96, 40, 34], [150, 52, 46], [210, 46, 40], [266, 50, 38]];
  for (const [cx, w, h] of crowns) {
    // A lumpy dome over a short trunk, drooping at its edges.
    const top = line - 6 - h;
    const d = `M${cx - w} ${line - 8}C${cx - w * 1.05} ${top + h * 0.5} ${cx - w * 0.6} ${top} ${cx - w * 0.15} ${top + 3}C${cx} ${top - 2} ${cx + w * 0.3} ${top + 1} ${cx + w * 0.5} ${top + h * 0.25}C${cx + w} ${top + h * 0.3} ${cx + w * 1.05} ${top + h * 0.7} ${cx + w} ${line - 8}C${cx + w * 0.5} ${line - 13} ${cx - w * 0.5} ${line - 13} ${cx - w} ${line - 8}Z`;
    shapes.push({ kind: 'path', d, alpha: 0.22, fill: true });
    rect(cx - 1.8, line - 12, 3.6, 12, 0.32, 1);
  }
  rect(0, line, W, 0.8, 0.3, 0);
  // The fireflies: many in the crowns, each mirrored in the water as a short dash.
  for (let i = 0; i < 64; i++) {
    const [cx, w, h] = crowns[i % crowns.length];
    const a = rand() * Math.PI;
    const r = Math.sqrt(rand());
    const x = cx + Math.cos(a) * w * 0.9 * r;
    const y = line - 10 - Math.sin(a) * h * 0.85 * r;
    const alpha = 0.55 + rand() * 0.45;
    shapes.push({ kind: 'circle', x: round(x), y: round(y), r: round(0.8 + rand() * 0.9), alpha });
    if (rand() < 0.7) rect(x - 0.7, line + 3 + (line - y) * 0.5, 1.4, 2 + rand() * 3, alpha * 0.55, 0.7);
  }
  // The lantern on its bamboo pole, and its glow in the water.
  shapes.push({ kind: 'path', d: `M199 ${line}Q197 22 184 22L181 25`, alpha: 0.55, width: 1.3 });
  shapes.push({ kind: 'path', d: 'M181 25V31', alpha: 0.7, width: 0.9 });
  rect(173.5, 32, 15, 13, 1, 6.5);
  rect(177.5, 30.4, 7, 2, 0.85, 0.6);
  rect(177.5, 44.6, 7, 2, 0.85, 0.6);
  rect(174.5, 64, 13, 11, 0.4, 6);
}
---
<span class="cover" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    {shapes.map((s) =>
      s.kind === 'rect' ? (
        <rect x={round(s.x)} y={round(s.y)} width={round(s.w)} height={round(s.h)} rx={s.rx} fill="currentColor" fill-opacity={round(s.alpha)} transform={s.turn ? `rotate(${round(s.turn)} ${round(s.x + s.w / 2)} ${round(s.y + s.h / 2)})` : undefined} />
      ) : s.kind === 'circle' ? (
        s.width ? <circle cx={s.x} cy={s.y} r={s.r} fill="none" stroke="currentColor" stroke-width={s.width} stroke-opacity={round(s.alpha)} />
        : <circle cx={s.x} cy={s.y} r={s.r} fill="currentColor" fill-opacity={round(s.alpha)} />
      ) : (
        <path d={s.d} fill={s.fill ? 'currentColor' : 'none'} fill-opacity={s.fill ? round(s.alpha) : undefined} stroke={s.fill ? undefined : 'currentColor'} stroke-width={s.width} stroke-opacity={s.fill ? undefined : round(s.alpha)} stroke-linecap="round" transform={s.at ? `translate(${s.at[0]} ${s.at[1]}) rotate(${s.turn ?? 0})` : undefined} />
      ))}
  </svg>
</span>

<style>
  /* White on the card's colours, as the effects' drawings are. */
  .cover { display: block; color: var(--on-colour); }
  svg { display: block; width: 100%; height: 100%; }
</style>
