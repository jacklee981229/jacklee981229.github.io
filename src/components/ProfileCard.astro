---
import ProfileLinks from './ProfileLinks.astro';
import { SITE } from '../site';
import { logoSvg } from '../lib/logo.js';

interface Props {
  posts: number;
  topics: number;
  tags: number;
}

const { posts, topics, tags } = Astro.props;
---
<div class="profile">
  <Fragment set:html={logoSvg('profile', 'width="56" height="56" aria-hidden="true"')} />
  <h2 class="name">{SITE.author}</h2>
  <p class="role">{SITE.role}</p>
  <p class="counts">
    <span><strong>{posts}</strong> posts</span>
    <span><strong>{topics}</strong> topics</span>
    <span><strong>{tags}</strong> tags</span>
  </p>
  <div class="contact"><ProfileLinks /></div>
</div>

<style>
  .profile { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--space-1) var(--space-4); }
  .name { margin: 0; font-size: var(--text-md); font-weight: 700; }
  /* Full width under the name: the job title is too long to sit beside the avatar. */
  .role { grid-column: 1 / -1; margin: var(--space-2) 0 0; color: var(--muted); font-size: var(--text-ui); }
  .counts { display: flex; flex-wrap: wrap; grid-column: 1 / -1; gap: var(--space-1) 1.25rem; margin: var(--space-3) 0 0; color: var(--muted); }
  strong { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums; }
  .contact { grid-column: 1 / -1; margin-top: var(--space-3); }
</style>
