---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import SearchDialog from '../components/SearchDialog.astro';
import avatar from '../assets/avatar.png';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  // The picture shown when the page is shared; the avatar when there is none.
  image?: ImageMetadata;
  article?: { published: Date; updated?: Date; tags: string[] };
}

const { title, description = `${SITE.tagline}. ${SITE.intro}`, image, article } = Astro.props;
// Same title format as the old site, so search results look the same.
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} - ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = await getImage({ src: image ?? avatar, width: image ? Math.min(image.width, 1200) : 500, format: image ? 'jpeg' : 'png' });
const shareImageUrl = new URL(shareImage.src, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title={SITE.title} href="/atom.xml" />
    <link rel="preload" href="/fonts/schibsted-grotesk-normal-400-900-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareImageUrl} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <!-- Keeps the site verified in Google Search Console (same token as the old site). -->
    <meta name="google-site-verification" content="jSWL6ULyDHu6BWdCYblWse_SuDVpLxTjWvooOx0Xgpw" />

    <script is:inline>
      // Apply the saved theme, or the system setting, before the page paints.
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <script is:inline>
      // The welcome screen (Welcome.astro) greets a visit that starts on the home page: once per tab, never when less motion is asked for.
      try {
        if (!sessionStorage.getItem('visited')) {
          sessionStorage.setItem('visited', '1');
          if (location.pathname === '/' && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('welcome');
        }
      } catch (e) {}
    </script>
    <script is:inline define:vars={{ liveHost: Astro.site?.hostname }}>
      // Visitor counts (busuanzi), only on the live site so local previews never add to them.
      if (location.hostname === liveHost) {
        var counter = document.createElement('script');
        counter.async = true;
        counter.src = 'https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js';
        document.head.appendChild(counter);
      }
    </script>
  </head>
  <body>
    <!-- First in the page, so a full-screen layer such as the welcome screen covers it from the first paint. -->
    <slot name="top" />
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <SearchDialog />
    <p class="visually-hidden" aria-live="polite" data-announcer></p>
  </body>
</html>
