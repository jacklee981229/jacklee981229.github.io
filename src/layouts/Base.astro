---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import SearchDialog from '../components/SearchDialog.astro';
import NightSky from '../components/NightSky.astro';
import Splash from '../components/Splash.astro';
import { shareLabel, sharePath } from '../lib/share.js';
import { LINKS, SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  // The picture shown when the page is shared. Without one, the page gets a picture made for it at the end of the
  // build (src/lib/share.js, share-image.js) from its title, description and section.
  image?: ImageMetadata;
  /** A post's topic, which names its section and colours its made share picture. */
  topic?: { id: string; name: string };
  article?: { published: Date; updated?: Date; tags: string[] };
  /** Keeps the page out of search engines and out of the sitemap (the build's sitemap check skips it). */
  noindex?: boolean;
}

const { title, description = `${SITE.tagline}. ${SITE.intro}`, image, topic, article, noindex } = Astro.props;
// Same title format as the old site, so search results look the same.
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} - ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImageUrl = new URL(image ? (await getImage({ src: image, width: Math.min(image.width, 1200), format: 'jpeg' })).src : sharePath(Astro.url.pathname), Astro.site);
// On the home page, the site's name and its author for search engines: Google takes the name it shows in its results
// from here, and the handle in the address is a name people search for too. Only the site's own facts go in, none
// with a "<", so the JSON can't end its script early.
const structured = Astro.url.pathname === '/' && {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${canonical.href}#website`, url: canonical.href, name: SITE.title, alternateName: canonical.hostname.split('.')[0], inLanguage: 'en', author: { '@id': `${canonical.href}#jack` } },
    { '@type': 'Person', '@id': `${canonical.href}#jack`, name: SITE.author, url: new URL('/about/', Astro.site).href, sameAs: LINKS.filter((link) => link.icon === 'linkedin' || link.icon === 'github').map((link) => link.href) },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Pages flow into each other in browsers that can (global.css styles it). The opt-in is here, first thing, not in
         the stylesheet: a page shown before its stylesheet is read would otherwise refuse the flow, and in tests most
         pages with pictures did. -->
    <style is:inline>@view-transition { navigation: auto; } @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }</style>
    <!-- And the page waits to show until its main part is read, so the top a card grows into is there to grow into:
         without this, pages with pictures showed before their top and only faded in. -->
    <link rel="expect" href="#main" blocking="render" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title={SITE.title} href="/atom.xml" />
    <link rel="preload" href="/fonts/schibsted-grotesk-normal-400-900-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareImageUrl} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    {!image && <meta name="share:label" content={shareLabel(Astro.url.pathname, topic?.name)} />}
    {!image && topic && <meta name="share:accent" content={topic.id} />}
    {structured && <script type="application/ld+json" set:html={JSON.stringify(structured)} />}
    <!-- Keeps the site verified in Google Search Console (same token as the old site). -->
    <meta name="google-site-verification" content="jSWL6ULyDHu6BWdCYblWse_SuDVpLxTjWvooOx0Xgpw" />

    <script is:inline>
      // Apply the saved theme, or the system setting, before the page paints; and the night sky over it, if it's on
      // (it keeps the dark theme, in colours of its own: NightSky.astro, src/lib/theme.ts).
      (function () {
        var t, sky;
        try { t = localStorage.getItem('theme'); sky = localStorage.getItem('sky'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        if (sky === 'night') {
          document.documentElement.dataset.sky = 'night';
          t = 'dark';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <script is:inline>
      // The welcome (Splash.astro) greets a visit that starts on the home page, once per tab.
      try {
        if (!sessionStorage.getItem('visited')) {
          sessionStorage.setItem('visited', '1');
          if (location.pathname === '/') document.documentElement.classList.add('welcome');
        }
      } catch (e) {}
    </script>
    <script is:inline define:vars={{ liveHost: Astro.site?.hostname, goatcounter: SITE.goatcounter }}>
      // The visitor counter, only on the live site so local previews never add to it.
      if (location.hostname === liveHost) {
        // GoatCounter (no cookies): its numbers feed Site info, each post's views and the Lab's Most Popular. One fixed version with its fingerprint, so
        // the browser refuses the script if the file ever differs from the one checked on 1 Oct 2026.
        var views = document.createElement('script');
        views.async = true;
        views.src = 'https://gc.zgo.at/count.v5.js';
        views.crossOrigin = 'anonymous';
        views.integrity = 'sha384-atnOLvQb9t+jTSipvd75X2yginT4PjVbqDdlJAmxMm+wYElFmeR6EmLP5bYeoRVQ';
        views.dataset.goatcounter = goatcounter + '/count';
        // Only once the page has loaded, so a slow counter never holds up the loading screen (Splash.astro).
        addEventListener('load', function () { document.head.appendChild(views); });
      }
    </script>
  </head>
  <body>
    <!-- First in the page, so the welcome or the loading screen covers it from the first paint. -->
    <Splash />
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <NightSky />
    <Footer />
    <BackToTop progress={Boolean(article)} />
    <SearchDialog />
    <p class="visually-hidden" aria-live="polite" data-announcer></p>
    <!-- Screen readers read this out for links to other sites, which open in a new tab (src/lib/links.js). -->
    <p id="new-tab" hidden>Opens in a new tab</p>
  </body>
</html>
