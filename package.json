    "astro": "7.4.11",
    "d3-geo": "3.1.2",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "marked": "18.2.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "onnxruntime-web": "1.31.1",
    "pdfjs-dist": "6.5.438",
    "satori": "0.63.2",
    "sharp": "0.35.5",
